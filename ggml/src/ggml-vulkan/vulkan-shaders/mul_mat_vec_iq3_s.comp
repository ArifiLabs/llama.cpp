#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

// Taken-from: LaurentZuijdwijk/llama.cpp 211abf6a9 "vulkan: handle larger batch sizes (>4)
// efficiently for IQ3_S mat-vec when NUM_COLS > 4. 5x perf at n=8" (ported by lane-166 as
// lane-166/matvec-vgpr-fix, gated to NUM_COLS > 4: 4.15x at n=5, 3.05x at n=8 on the 780M).
// arifi lane-209 adds NUM_COLS == 3 (the DFlash2 n-max 2 VERIFY width): the lane-204 census put the
// n=3 rows of this shader at 38-45 GB/s against 81 best on the same map (U-Q3KXL 45 ms, U-IQ4XS
// 22 ms per verify graph). With 8 invocations per superblock the [[unroll]]ed l=4 x NUM_COLS B slab
// is live per row; 16 invocations halve it. Measured on the 780M (test-backend-ops perf, 17408x5120,
// 3-round medians, lane-209 r4/TBO-17408.txt): n=3 963 -> 736 us (x1.31), n=5 x1.46, n=8 x4.64,
// n=1 / n=2 unchanged, but n=4 1174 -> 1427 us (x0.82) - so n=4 keeps the stock 8/4 shape and the
// gate is the union of zuijdwijk's (> 4) and the one width that measured a win below it.
// NO DIVISION BY A SPECIALIZATION CONSTANT AT GLOBAL SCOPE (lane-166: the AMD proprietary driver
// folds OpSpecConstantOp UDiv at pipeline creation and raised STATUS_INTEGER_DIVIDE_BY_ZERO).
// Selects give the same constants with no divide.
const bool ARIFI_TPB16 = (NUM_COLS == 3) || (NUM_COLS > 4);
const uint TPB         = ARIFI_TPB16 ? 16u : 8u;
const uint NL          = ARIFI_TPB16 ?  2u : 4u;   // == 32 / TPB
const uint TPB_OVER_8  = ARIFI_TPB16 ?  2u : 1u;   // == TPB / 8

// arifi lane-249 / R61 step 2: SIGN-APPLICATION HOIST (specialization constant 3).
// 0 = legacy, the shipped body VERBATIM: the sign select sits inside an fma argument and is
//     re-evaluated once per weight PER COLUMN, although `sign` and `grid*` are A-side only.
// 1 = v2: apply the sign to the eight grid values ONCE per (l, row), outside the NUM_COLS loop,
//     and leave the column body as eight unguarded fmas -- mul_mat_vec_iq4_xs.comp's shape.
// R61 step 0(b) measured the residual select at 88 marginal OpSelect and ~1303 marginal
// instructions per extra column against iq4_xs's 8 / 333 (r61-evidence/20-spirv-counts.txt).
//
// BIT-IDENTICAL BETWEEN ARMS BY CONSTRUCTION: both arms multiply the same b value by the same
// signed grid value and accumulate in the same order through the same fma chain. The negation is
// exact (IEEE sign-bit flip) and happens in float32 before the FLOAT_TYPE conversion in both arms,
// so no rounding difference can arise -- only WHEN the negation is evaluated moves.
// Default 0. GGML_ARIFI_IQ3_MMVQ=v2 selects arm 1; ONE binary serves both.
layout (constant_id = 3) const uint ARIFI_IQ3_SIGN_HOIST = 0;

// arifi lane-302 Route A: IQ3_S grid init (spec 4, GGML_ARIFI_IQ3S_INIT, idg pipeline only). 1 = batched: all of a
// thread's loads issue before any LDS store (the IQ2_S lever-4 shape; the strided loop serialized 8 x load -> wait ->
// store). Same table, every entry written once: byte-identical by construction. 2 = planted wrong arm (table rotated).
layout (constant_id = 4) const uint ARIFI_IQ3S_INIT = 0;

void arifi_init_iq3s_batched() {
    const uint t = gl_LocalInvocationIndex;
    const uint W = gl_WorkGroupSize.x;
    for (uint i0 = 0; i0 < 512; i0 += 8 * W) {
        uint v[8];
        [[unroll]] for (uint k = 0; k < 8; ++k) {
            v[k] = iq3s_grid_const[min(i0 + k * W + t, 511u)];
        }
        [[unroll]] for (uint k = 0; k < 8; ++k) {
            const uint idx = i0 + k * W + t;
            if (idx < 512) {
                iq3s_grid[ARIFI_IQ3S_INIT == 2 ? ((idx + 1u) & 511u) : idx] = v[k];
            }
        }
    }
    barrier();
}

// The eight signed grid values, as the legacy chain would have computed them element by element.
vec4 iq3s_sign_lo(const vec4 g, const uint sign) {
    return vec4((sign &  1) != 0 ? -g.x : g.x,
                (sign &  2) != 0 ? -g.y : g.y,
                (sign &  4) != 0 ? -g.z : g.z,
                (sign &  8) != 0 ? -g.w : g.w);
}
vec4 iq3s_sign_hi(const vec4 g, const uint sign) {
    return vec4((sign &  16) != 0 ? -g.x : g.x,
                (sign &  32) != 0 ? -g.y : g.y,
                (sign &  64) != 0 ? -g.z : g.z,
                (sign & 128) != 0 ? -g.w : g.w);
}
// The column body with the signs already applied: same operands, same fma nesting, same order.
FLOAT_TYPE iq3s_col_dot(const vec4 b0, const vec4 b4, const vec4 s0, const vec4 s1, const FLOAT_TYPE acc) {
    return fma(FLOAT_TYPE(b0.x), FLOAT_TYPE(s0.x),
           fma(FLOAT_TYPE(b0.y), FLOAT_TYPE(s0.y),
           fma(FLOAT_TYPE(b0.z), FLOAT_TYPE(s0.z),
           fma(FLOAT_TYPE(b0.w), FLOAT_TYPE(s0.w),
           fma(FLOAT_TYPE(b4.x), FLOAT_TYPE(s1.x),
           fma(FLOAT_TYPE(b4.y), FLOAT_TYPE(s1.y),
           fma(FLOAT_TYPE(b4.z), FLOAT_TYPE(s1.z),
           fma(FLOAT_TYPE(b4.w), FLOAT_TYPE(s1.w),
           acc))))))));
}

void calc_superblock(const uint a_offset, const uint b_offset, const uint itid, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint ib32 = itid / TPB_OVER_8;
    const uint l0   = (itid % TPB_OVER_8) * NL;
    const uint y_idx = i * QUANT_K + 32 * ib32;

    uint ibi = a_offset + first_row * num_blocks_per_row + i;
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const float d = float(data_a[ibi].d);
        const uint scale = (data_a[ibi].scales[ib32/2] >> (4 * (ib32 & 1))) & 0xF;
        const float dscale = d * (1 + 2 * scale);
        const uint qh = data_a[ibi].qh[ib32];
        if (ARIFI_TPB16) {
            // the split widths: zuijdwijk's two moves together (16 invocations, no sum[] array)
            [[unroll]] for (uint ll = 0; ll < NL; ++ll) {
                const uint l = l0 + ll;
                const u8vec2 qs = unpack8(uint32_t(data_a_packed16[ibi].qs[4 * ib32 + l])).xy; // vec4 used due to #12147
                const uint sign = data_a[ibi].signs[4 * ib32 + l];
                const vec4 grid0 = vec4(unpack8(iq3s_grid[qs.x | ((qh << (8 - 2*l)) & 0x100)]));
                const vec4 grid1 = vec4(unpack8(iq3s_grid[qs.y | ((qh << (7 - 2*l)) & 0x100)]));

                if (ARIFI_IQ3_SIGN_HOIST != 0) {
                    // v2: the sign is A-side only, so apply it once here and let the column body
                    // be eight unguarded fmas.
                    const vec4 s0 = iq3s_sign_lo(grid0, sign);
                    const vec4 s1 = iq3s_sign_hi(grid1, sign);

                    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                        const vec4 b0 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 0]);
                        const vec4 b4 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 1]);

                        temp[j][n] = fma(dscale, iq3s_col_dot(b0, b4, s0, s1, FLOAT_TYPE(0.0)), temp[j][n]);
                    }
                } else {
                // legacy: the shipped body, VERBATIM. Kept as text rather than routed through
                // iq3s_col_dot so the default arm's codegen is provably the pre-R61 one.
                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    const vec4 b0 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 0]);
                    const vec4 b4 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 1]);

                    const FLOAT_TYPE sum =
                          fma(FLOAT_TYPE(b0.x), FLOAT_TYPE((sign &   1) != 0 ? -grid0.x : grid0.x),
                          fma(FLOAT_TYPE(b0.y), FLOAT_TYPE((sign &   2) != 0 ? -grid0.y : grid0.y),
                          fma(FLOAT_TYPE(b0.z), FLOAT_TYPE((sign &   4) != 0 ? -grid0.z : grid0.z),
                          fma(FLOAT_TYPE(b0.w), FLOAT_TYPE((sign &   8) != 0 ? -grid0.w : grid0.w),
                          fma(FLOAT_TYPE(b4.x), FLOAT_TYPE((sign &  16) != 0 ? -grid1.x : grid1.x),
                          fma(FLOAT_TYPE(b4.y), FLOAT_TYPE((sign &  32) != 0 ? -grid1.y : grid1.y),
                          fma(FLOAT_TYPE(b4.z), FLOAT_TYPE((sign &  64) != 0 ? -grid1.z : grid1.z),
                          fma(FLOAT_TYPE(b4.w), FLOAT_TYPE((sign & 128) != 0 ? -grid1.w : grid1.w),
                          FLOAT_TYPE(0.0)))))))));

                    temp[j][n] = fma(dscale, sum, temp[j][n]);
                }
                }
            }
        } else {
            // the stock widths: the upstream body VERBATIM (sum[NUM_COLS] array, l = 0..3). The union-gate build
            // that applied the no-sum[] form here measured n=2 x0.907 / n=4 x0.925 vs stock on the 780M
            // (lane-209 r4b/TBO-17408.txt), so the stock widths keep the stock code, bit for bit.
            FLOAT_TYPE sum[NUM_COLS];
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                sum[j] = 0.0;
            }
            [[unroll]] for (uint l = 0; l < 4; ++l) {
                const u8vec2 qs = unpack8(uint32_t(data_a_packed16[ibi].qs[4 * ib32 + l])).xy; // vec4 used due to #12147
                const uint sign = data_a[ibi].signs[4 * ib32 + l];
                const vec4 grid0 = vec4(unpack8(iq3s_grid[qs.x | ((qh << (8 - 2*l)) & 0x100)]));
                const vec4 grid1 = vec4(unpack8(iq3s_grid[qs.y | ((qh << (7 - 2*l)) & 0x100)]));

                if (ARIFI_IQ3_SIGN_HOIST != 0) {
                    // v2, stock-width branch: same hoist, same sum[] accumulation order.
                    const vec4 s0 = iq3s_sign_lo(grid0, sign);
                    const vec4 s1 = iq3s_sign_hi(grid1, sign);

                    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                        const vec4 b0 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 0]);
                        const vec4 b4 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 1]);

                        sum[j] = iq3s_col_dot(b0, b4, s0, s1, sum[j]);
                    }
                } else {
                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    const vec4 b0 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 0]);
                    const vec4 b4 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 1]);

                    sum[j] =
                          fma(FLOAT_TYPE(b0.x), FLOAT_TYPE((sign &   1) != 0 ? -grid0.x : grid0.x),
                          fma(FLOAT_TYPE(b0.y), FLOAT_TYPE((sign &   2) != 0 ? -grid0.y : grid0.y),
                          fma(FLOAT_TYPE(b0.z), FLOAT_TYPE((sign &   4) != 0 ? -grid0.z : grid0.z),
                          fma(FLOAT_TYPE(b0.w), FLOAT_TYPE((sign &   8) != 0 ? -grid0.w : grid0.w),
                          fma(FLOAT_TYPE(b4.x), FLOAT_TYPE((sign &  16) != 0 ? -grid1.x : grid1.x),
                          fma(FLOAT_TYPE(b4.y), FLOAT_TYPE((sign &  32) != 0 ? -grid1.y : grid1.y),
                          fma(FLOAT_TYPE(b4.z), FLOAT_TYPE((sign &  64) != 0 ? -grid1.z : grid1.z),
                          fma(FLOAT_TYPE(b4.w), FLOAT_TYPE((sign & 128) != 0 ? -grid1.w : grid1.w),
                          sum[j]))))))));
                }
                }
            }
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                temp[j][n] = fma(dscale, sum[j], temp[j][n]);
            }
        }
        ibi += num_blocks_per_row;
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    // TPB invocations are used to process each block
    const uint blocks_per_wg = ARIFI_TPB16 ? (gl_WorkGroupSize.x >> 4) : (gl_WorkGroupSize.x >> 3);
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % TPB;
    const uint ix = tid / TPB;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_offset, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * WG_ROWBLOCK;

#ifdef MUL_MAT_ID_GATHER
    if (!gather_setup()) {
        return;
    }
#endif

    if (ARIFI_IQ3S_INIT != 0) {
        arifi_init_iq3s_batched();
    } else {
        init_iq_shmem(gl_WorkGroupSize);
    }

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
