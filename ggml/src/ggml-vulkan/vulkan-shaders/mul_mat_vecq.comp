#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

#define MMQ
#define NEEDS_IQ1S_GRID_GPU
#define KVALUES_IQ4NL_I8
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// arifi lane-262 / R75: IQ4_XS is not a DATA_A_QUANT_K type (types.glsl only sets that for the
// q*_K family) but has the same 256-weight superblock and the same 16-weights-per-thread slicing,
// so it takes the same K_PER_ITER. iqs then selects the low (0) or high (1) nibble half of the
// sub-block's 16 qs bytes -- see the IQ4_XS arm of mul_mat_vecq_funcs.glsl.
// arifi lane-296: ARIFI_IQ4XS_UPSTREAM compiles upstream b1ff4ca23's K_PER_ITER 32 IQ4_XS body instead.
#if defined(DATA_A_Q2_0) || defined(DATA_A_Q2_0_G128) || defined(DATA_A_QUANT_K) || (defined(DATA_A_IQ4_XS) && !defined(ARIFI_IQ4XS_UPSTREAM))
#define K_PER_ITER 16
#elif defined(DATA_A_QUANT_LEGACY) || defined(DATA_A_MXFP4) || defined(DATA_A_ROCMFP4_FAST)
#define K_PER_ITER 8
#elif defined(DATA_A_IQ1_S) || defined(DATA_A_IQ1_M) || defined(DATA_A_IQ4_XS)
#define K_PER_ITER 32
#elif defined(DATA_A_SX8)
// lane-230 / R46. S-X8 blocks are 32 weights, the same width as a Q8_1 activation
// block, so one thread owning 32 columns owns exactly one weight block: the header,
// the four range strategies and the two planes are each read once per block.
#define K_PER_ITER 32
#else
#error unimplemented
#endif

uint a_offset, b_offset, d_offset;

int32_t cache_b_qs[K_PER_ITER / 4];
vec2 cache_b_ds;

// arifi lane-235 / R48b: MMVQ A-side hoist. 0 = the inherited nest, which re-runs the whole
// weight decode inside the column loop; 1 = decode each row once per (row, k-slice) into
// registers, then loop the columns doing only the B load and the integer dot. Both arms call
// the same mmvq_load_a() / mmvq_dot_a() pair in the same order, so results are bit-identical.
// Default 0 on purpose: a create site that omits the constant keeps the inherited nest rather
// than silently opting in. The host (ggml-vulkan.cpp) supplies the value per pipeline.
layout (constant_id = 3) const uint ARIFI_MMVQ_A_HOIST = 0;
// arifi lane-271 / R85: Q4_K load/compute overlap arms at NUM_COLS >= 5 (host passes 0 elsewhere).
// 0 = the hoisted nest above; 1 = software pipelining (the NEXT k-slice's A and B are loaded
// before the current slice's dots); 3 = the columns split 4 + (NUM_COLS-4) into two scheduling
// regions over the same hoisted A. Every arm adds the same terms in the same order to each
// temp[j][n], so all three are bit-identical.
layout (constant_id = 4) const uint ARIFI_MMVQ_OVERLAP = 0;

#include "mul_mat_vecq_funcs.glsl"

// The B-side load, factored out verbatim so both nests call it at the identical point.
void cache_b_block(const uint j, const uint col, const uint b_qs_idx) {
        // Preload data_b block
        const uint b_block_idx = (j*p.batch_stride_b + col) / QUANT_K_Q8_1 + b_offset;
        const uint b_block_idx_outer = b_block_idx / 4;
        const uint b_block_idx_inner = b_block_idx % 4;
        cache_b_ds = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);

#if QUANT_R == 2
        // Assumes K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx + 4];
#else
#if K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 1];
#elif K_PER_ITER == 16
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 3];
#elif K_PER_ITER == 32
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 3];
        cache_b_qs[4] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 4];
        cache_b_qs[5] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 5];
        cache_b_qs[6] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 6];
        cache_b_qs[7] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 7];
#else
#error unimplemented
#endif
#endif
}

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
    // NUM_COLS == 1 has no redundancy to remove, so it folds to the inherited nest at
    // pipeline-compile time -- both of these are specialization constants.
    if (ARIFI_MMVQ_A_HOIST != 0 && NUM_COLS > 1) {
        // Static trip over NUM_ROWS with an `n < num_rows` guard, not a runtime trip over
        // num_rows: a_dec then has a compile-time extent and every index is constant after
        // unrolling, which is what lets the array live in registers instead of scratch.
        mmvq_a_t a_dec[NUM_ROWS];

        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
            ibi += p.ncols;

            if (n < num_rows) {
                a_dec[n] = mmvq_load_a(a_block_idx, b_qs_idx);
            }
        }

#if defined(DATA_A_Q4_K)
        if (ARIFI_MMVQ_OVERLAP == 3 && NUM_COLS > 4) {
            [[unroll]] for (uint j = 0; j < 4; ++j) {
                cache_b_block(j, col, b_qs_idx);
                [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                    if (n < num_rows) {
                        temp[j][n] += mmvq_dot_a(a_dec[n]);
                    }
                }
            }
            // A push-constant branch the compiler cannot fold: a basic-block edge, so the tail
            // columns' B loads cannot be scheduled into the 4-column region. p.ncols > 0 whenever
            // iter() runs, so the branch is always taken.
            if (p.ncols != 0u) {
                [[unroll]] for (uint j = 4; j < NUM_COLS; ++j) {
                    cache_b_block(j, col, b_qs_idx);
                    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                        if (n < num_rows) {
                            temp[j][n] += mmvq_dot_a(a_dec[n]);
                        }
                    }
                }
            }
            return;
        }
#endif
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            cache_b_block(j, col, b_qs_idx);

            [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                if (n < num_rows) {
                    temp[j][n] += mmvq_dot_a(a_dec[n]);
                }
            }
        }
    } else {
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            cache_b_block(j, col, b_qs_idx);

            uint ibi = first_row*p.ncols;
            [[unroll]] for (uint n = 0; n < num_rows; ++n) {
                const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
                ibi += p.ncols;

                temp[j][n] += mmvq_dot_product(a_block_idx, b_qs_idx);
            }
        }
    }
}

#if defined(DATA_A_Q4_K)
// R85 arm 1: one k-slice's operands, held in registers across the previous slice's dots.
struct pf_slice_t {
    mmvq_a_t a[NUM_ROWS];
    int32_t  bq[NUM_COLS][K_PER_ITER / 4];
    vec2     bd[NUM_COLS];
};

void pf_load(out pf_slice_t s, const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
    uint ibi = first_row*p.ncols;
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
        ibi += p.ncols;
        if (n < num_rows) {
            s.a[n] = mmvq_load_a(a_block_idx, b_qs_idx);
        }
    }
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        cache_b_block(j, col, b_qs_idx);
        [[unroll]] for (uint q = 0; q < K_PER_ITER / 4; ++q) {
            s.bq[j][q] = cache_b_qs[q];
        }
        s.bd[j] = cache_b_ds;
    }
}

// Compute slice `cur` while the next slice's loads are in flight. On the last slice the "next"
// load re-reads the current column (always in bounds) instead of branching, so the loads stay
// in one scheduling region.
void pf_iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], inout pf_slice_t cur, const uint first_row, const uint num_rows,
             const uint col, const uint b_qs_idx, const bool has_next, const uint col_stride) {
    pf_slice_t nxt;
    pf_load(nxt, first_row, num_rows, has_next ? col + col_stride : col, b_qs_idx);
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint q = 0; q < K_PER_ITER / 4; ++q) {
            cache_b_qs[q] = cur.bq[j][q];
        }
        cache_b_ds = cur.bd[j];
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            if (n < num_rows) {
                temp[j][n] += mmvq_dot_a(cur.a[n]);
            }
        }
    }
    // Element-wise: glslang refuses `=` on structs holding spec-constant-sized arrays.
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        cur.a[n] = nxt.a[n];
    }
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint q = 0; q < K_PER_ITER / 4; ++q) {
            cur.bq[j][q] = nxt.bq[j][q];
        }
        cur.bd[j] = nxt.bd[j];
    }
}
#endif

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    get_offsets(a_offset, b_offset, d_offset);
    a_offset *= QUANT_K / QUANT_K_Q8_1;
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    const uint b_qs_idx = tid % (32 / K_PER_ITER);
    uint col = tid * K_PER_ITER;

#if defined(DATA_A_Q4_K)
    if (ARIFI_MMVQ_OVERLAP == 1 && ARIFI_MMVQ_A_HOIST != 0 && NUM_COLS > 1) {
        // Same 4 / 2 / 1 unroll as the shipped loop below; only the load placement moves.
        pf_slice_t cur;
        if (num_iters > 0) {
            pf_load(cur, first_row, num_rows, col, b_qs_idx);
        }
        while (num_iters >= 4) {
            [[unroll]] for (uint k = 0; k < 4; ++k) {
                pf_iter(temp, cur, first_row, num_rows, col, b_qs_idx, k < 3 || num_iters > 4, col_stride);
                col += col_stride;
            }
            num_iters -= 4;
        }
        if (num_iters >= 2) {
            pf_iter(temp, cur, first_row, num_rows, col, b_qs_idx, true, col_stride);
            col += col_stride;
            pf_iter(temp, cur, first_row, num_rows, col, b_qs_idx, num_iters > 2, col_stride);
            col += col_stride;
            num_iters -= 2;
        }
        if (num_iters > 0) {
            pf_iter(temp, cur, first_row, num_rows, col, b_qs_idx, false, col_stride);
        }
        reduce_result(temp, d_offset, first_row, num_rows, tid);
        return;
    }
#endif

    while (num_iters >= 4) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            iter(temp, first_row, num_rows, col, b_qs_idx);
            col += col_stride;
        }

        num_iters -= 4;
    }

    if (num_iters >= 2) {
        // Manually partially unroll the loop
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        num_iters -= 2;
    }

    if (num_iters > 0) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
