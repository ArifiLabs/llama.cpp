#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

// arifi lane-249 / R61 step 2: SIGN-APPLICATION HOIST (specialization constant 3).
// 0 = legacy, the shipped body VERBATIM: the sign select sits inside an fma argument and is
//     re-evaluated once per weight PER COLUMN, although `sign`, `sign7` and `grid*` are A-side only.
// 1 = v2: apply the sign to the eight grid values ONCE per (l, row), outside the NUM_COLS loop.
// R61 step 0(b) measured the residual select at 88 marginal OpSelect and ~1226 marginal
// instructions per extra column against iq4_xs's 8 / 333 (r61-evidence/20-spirv-counts.txt).
//
// BIT-IDENTICAL BETWEEN ARMS BY CONSTRUCTION: same products, same fma nesting, same accumulation
// order; the negation is an exact IEEE sign-bit flip applied in float32 before the FLOAT_TYPE
// conversion in both arms. Only WHEN it is evaluated moves.
// Default 0. GGML_ARIFI_IQ3_MMVQ=v2 selects arm 1; ONE binary serves both.
layout (constant_id = 3) const uint ARIFI_IQ3_SIGN_HOIST = 0;

vec4 iq3xxs_sign_lo(const vec4 g, const uint sign) {
    return vec4((sign &  1) != 0 ? -g.x : g.x,
                (sign &  2) != 0 ? -g.y : g.y,
                (sign &  4) != 0 ? -g.z : g.z,
                (sign &  8) != 0 ? -g.w : g.w);
}
// NOTE the last element: upstream uses the PARITY bit (sign7 = bitCount(sign)), not (sign & 128) --
// `sign` is a 7-bit field and the eighth sign is its parity. Reproduced exactly.
vec4 iq3xxs_sign_hi(const vec4 g, const uint sign, const uint sign7) {
    return vec4((sign  & 16) != 0 ? -g.x : g.x,
                (sign  & 32) != 0 ? -g.y : g.y,
                (sign  & 64) != 0 ? -g.z : g.z,
                (sign7 &  1) != 0 ? -g.w : g.w);
}
FLOAT_TYPE iq3xxs_col_dot(const vec4 b0, const vec4 b4, const vec4 s0, const vec4 s1) {
    return fma(FLOAT_TYPE(b0.x), FLOAT_TYPE(s0.x),
           fma(FLOAT_TYPE(b0.y), FLOAT_TYPE(s0.y),
           fma(FLOAT_TYPE(b0.z), FLOAT_TYPE(s0.z),
           fma(FLOAT_TYPE(b0.w), FLOAT_TYPE(s0.w),
           fma(FLOAT_TYPE(b4.x), FLOAT_TYPE(s1.x),
           fma(FLOAT_TYPE(b4.y), FLOAT_TYPE(s1.y),
           fma(FLOAT_TYPE(b4.z), FLOAT_TYPE(s1.z),
           fma(FLOAT_TYPE(b4.w), FLOAT_TYPE(s1.w),
           FLOAT_TYPE(0.0)))))))));
}

void calc_superblock(const uint a_offset, const uint b_offset, const uint itid, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y_idx = i * QUANT_K + 16 * itid;
    const uint ib32 = itid / 2; // 0..7

    uint ibi = a_offset + first_row * num_blocks_per_row + i;
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const float d = float(data_a[ibi].d);
        const uint signscale = pack32(u16vec2(
            data_a_packed16[ibi].qs[QUANT_K / 8 + 2 * ib32],
            data_a_packed16[ibi].qs[QUANT_K / 8 + 2 * ib32 + 1]));
        const float db = d * 0.5 * (0.5 + (signscale >> 28));
        [[unroll]] for (uint l = 0; l < 2; ++l) {
            const uint qs0 = data_a[ibi].qs[8 * ib32 + 4 * (itid & 1) + 2 * l];
            const uint qs1 = data_a[ibi].qs[8 * ib32 + 4 * (itid & 1) + 2 * l + 1];
            const uint sign = bitfieldExtract(signscale, 7 * int(2 * (itid & 1) + l), 7);
            const uint sign7 = bitCount(sign);
            const vec4 grid0 = vec4(unpack8(iq3xxs_grid[qs0]));
            const vec4 grid1 = vec4(unpack8(iq3xxs_grid[qs1]));

            if (ARIFI_IQ3_SIGN_HOIST != 0) {
                // v2: the sign is A-side only, so apply it once here and let the column body be
                // eight unguarded fmas -- mul_mat_vec_iq4_xs.comp's shape.
                const vec4 s0 = iq3xxs_sign_lo(grid0, sign);
                const vec4 s1 = iq3xxs_sign_hi(grid1, sign, sign7);

                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    const vec4 b0 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 0]);
                    const vec4 b4 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 1]);

                    temp[j][n] = fma(db, iq3xxs_col_dot(b0, b4, s0, s1), temp[j][n]);
                }
            } else {
            // legacy: the shipped body, VERBATIM. Kept as text rather than routed through
            // iq3xxs_col_dot so the default arm's codegen is provably the pre-R61 one.
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const vec4 b0 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 0]);
                const vec4 b4 = vec4(data_b_v4[(B_COL(j) + b_offset + y_idx) / 4 + 2*l + 1]);

                FLOAT_TYPE sum =
                      fma(FLOAT_TYPE(b0.x), FLOAT_TYPE((sign &   1) != 0 ? -grid0.x : grid0.x),
                      fma(FLOAT_TYPE(b0.y), FLOAT_TYPE((sign &   2) != 0 ? -grid0.y : grid0.y),
                      fma(FLOAT_TYPE(b0.z), FLOAT_TYPE((sign &   4) != 0 ? -grid0.z : grid0.z),
                      fma(FLOAT_TYPE(b0.w), FLOAT_TYPE((sign &   8) != 0 ? -grid0.w : grid0.w),
                      fma(FLOAT_TYPE(b4.x), FLOAT_TYPE((sign &  16) != 0 ? -grid1.x : grid1.x),
                      fma(FLOAT_TYPE(b4.y), FLOAT_TYPE((sign &  32) != 0 ? -grid1.y : grid1.y),
                      fma(FLOAT_TYPE(b4.z), FLOAT_TYPE((sign &  64) != 0 ? -grid1.z : grid1.z),
                      fma(FLOAT_TYPE(b4.w), FLOAT_TYPE((sign7 &  1) != 0 ? -grid1.w : grid1.w),
                      FLOAT_TYPE(0.0)))))))));
                temp[j][n] = fma(db, sum, temp[j][n]);
            }
            }
        }
        ibi += num_blocks_per_row;
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    // 16 threads are used to process each block
    const uint blocks_per_wg = gl_WorkGroupSize.x/16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 16;  // 0...15
    const uint ix = tid / 16;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_offset, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

#ifdef MUL_MAT_ID_GATHER
    if (!gather_setup()) {
        return;
    }
#endif

    init_iq_shmem(gl_WorkGroupSize);

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
