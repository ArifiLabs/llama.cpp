#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require

#ifdef USE_SUBGROUPS
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require

#define INVOCATION_ID gl_SubgroupInvocationID.x
#else
#define INVOCATION_ID gl_LocalInvocationID.x
#endif

layout (push_constant) uniform parameter
{
    uint ne;
    uint num_blocks;
} p;

#include "types.glsl"

layout(constant_id = 0) const uint GROUP_SIZE = 32;
// arifi lane-296 night R2: 1 = round against the stored f16 scale (scale-consistent), clamp to +-127.
layout(constant_id = 1) const uint SCALE_F16 = 0;
// arifi lane-296 R3: 1 = write the second int8 digit (residual of the first pass), for two-pass int8 matmuls.
layout(constant_id = 2) const uint RESIDUAL = 0;
// arifi lane-296 R4: residual prescale 2^RES_SHIFT (keeps the second digit's f16 scale out of the subnormal range).
layout(constant_id = 3) const uint RES_SHIFT = 0;
// lane sx8-int8 attempt E: 1 = one scale per 16-value half block, ds = (d0, d1). Only the S-X8 H16 cm1 kernel reads it
// (it sums the int8 activations exactly, so the block sum ds.y is not needed). Not combined with RESIDUAL.
layout(constant_id = 4) const uint HALF = 0;
// lane sx8-int8 attempt D: with RESIDUAL, write the second digit only for blocks with amax > GATE * mean|x| (an outlier
// block); every other block gets q2 = 0, d2 = 0, so the SX8_SKIP matmul can skip it. 0 = off (every block).
layout(constant_id = 5) const uint GATE = 0;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {vec4 data_a[];};
#ifndef QBLOCK_X4
layout (binding = 1) writeonly buffer D {block_q8_1_packed32 data_b[];};
#else
layout (binding = 1) writeonly buffer D {block_q8_1_x4 data_b[];};
#endif

#ifndef USE_SUBGROUPS
shared float shmem[GROUP_SIZE];
#endif

void quantize(const uint wgid) {
    const uint tid = INVOCATION_ID;

    // Each thread handles a vec4, so 8 threads handle a block
    const uint blocks_per_group = GROUP_SIZE / 8;

    const uint block_in_wg = tid / 8;

    const uint ib = wgid * blocks_per_group + block_in_wg;
    const uint iqs = tid % 8;

#ifdef QBLOCK_X4
    const uint ibx4_outer = ib / 4;
    const uint ibx4_inner = ib % 4;

    const uint required_x4_blocks = (p.ne + 127) / 128;
    if (ibx4_outer >= required_x4_blocks) {
        return;
    }
#endif

    const uint a_idx = ib * 8 + iqs;

    vec4 vals = a_idx < p.ne / 4 ? data_a[a_idx] : vec4(0.0f);
    const vec4 abs_vals = abs(vals);

    // Find absolute max for each block
    const float thread_max = max(max(abs_vals.x, abs_vals.y), max(abs_vals.z, abs_vals.w));
#ifndef USE_SUBGROUPS
    shmem[tid] = thread_max;
    barrier();
    [[unroll]] for (uint s = HALF != 0 ? 2 : 4; s > 0; s >>= 1) {
        if ((HALF != 0 ? (iqs & 3) : iqs) < s) {
            shmem[tid] = max(shmem[tid], shmem[tid + s]);
        }
        barrier();
    }

    const float amax0 = shmem[block_in_wg * 8];
    const float amax1 = shmem[block_in_wg * 8 + 4];
    const float amax = HALF != 0 ? ((iqs & 4) != 0 ? amax1 : amax0) : amax0;
#else
    float amax;
    float amax0 = 0.0;
    float amax1 = 0.0;
    if (HALF != 0) {
        const vec2 hm = subgroupClusteredMax(vec2(iqs < 4 ? thread_max : 0.0, iqs < 4 ? 0.0 : thread_max), 8);
        amax0 = hm.x;
        amax1 = hm.y;
        amax = iqs < 4 ? amax0 : amax1;
    } else {
        amax = subgroupClusteredMax(thread_max, 8);
    }
#endif

    // lane-296c: f16 rounding via the same conversion as the ds store below; packHalf2x16 rounds toward zero on
    // RDNA3 (AMD proprietary driver), the f16vec2 store rounds to nearest, so mixing the two leaves a 2^-11 mismatch.
    float d = SCALE_F16 != 0 ? float(f16vec2(vec2(amax / 127.0, 0.0)).x) : amax / 127.0;
    const vec2 dh = vec2(amax0, amax1) / 127.0;
    float d_inv = d != 0.0 ? 1.0 / d : 0.0;
    vec4 q = round(vals * d_inv);
    if (SCALE_F16 != 0) {
        q = clamp(q, vec4(-127.0), vec4(127.0));
    }
    if (RESIDUAL != 0) {
        bool keep = true;
        if (GATE != 0) {
            const float thread_asum = abs_vals.x + abs_vals.y + abs_vals.z + abs_vals.w;
#ifndef USE_SUBGROUPS
            barrier();
            shmem[tid] = thread_asum;
            barrier();
            [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
                if (iqs < s) {
                    shmem[tid] += shmem[tid + s];
                }
                barrier();
            }
            const float asum = shmem[block_in_wg * 8];
#else
            const float asum = subgroupClusteredAdd(thread_asum, 8);
#endif
            // amax > GATE * (asum / 32)
            keep = amax * 32.0 > float(GATE) * asum;
        }
        // second int8 digit: requantize x - q1 * f16(d1), q1 recomputed exactly as the first pass stored it
        vals -= q * float(f16vec2(vec2(d, 0.0)).x);
        if (!keep) {
            vals = vec4(0.0);
        }
        vals = ldexp(vals, ivec4(int(RES_SHIFT)));
        const vec4 abs_r = abs(vals);
        const float thread_rmax = max(max(abs_r.x, abs_r.y), max(abs_r.z, abs_r.w));
#ifndef USE_SUBGROUPS
        barrier();
        shmem[tid] = thread_rmax;
        barrier();
        [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
            if (iqs < s) {
                shmem[tid] = max(shmem[tid], shmem[tid + s]);
            }
            barrier();
        }
        const float rmax = shmem[block_in_wg * 8];
#else
        const float rmax = subgroupClusteredMax(thread_rmax, 8);
#endif
        d = rmax / 127.0;
        d_inv = d != 0.0 ? 1.0 / d : 0.0;
        q = round(vals * d_inv);
    }
    vals = q;

#ifndef QBLOCK_X4
    data_b[ib].qs[iqs] = pack32(i8vec4(round(vals)));
#else
    data_b[ibx4_outer].qs[ibx4_inner * 8 + iqs] = pack32(i8vec4(round(vals)));
#endif

#ifndef USE_SUBGROUPS
    barrier();
#endif

    // Calculate the sum for each block
    const float thread_sum = vals.x + vals.y + vals.z + vals.w;
#ifndef USE_SUBGROUPS
    shmem[tid] = thread_sum;
    barrier();
    [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
        if (iqs < s) {
            shmem[tid] += shmem[tid + s];
        }
        barrier();
    }
#else
    const float sum = subgroupClusteredAdd(thread_sum, 8);
#endif
    if (iqs == 0) {
#ifndef USE_SUBGROUPS
        const float sum = shmem[tid];
#endif

        const vec2 ds_out = HALF != 0 ? dh : vec2(d, sum * d);
#ifndef QBLOCK_X4
        data_b[ib].ds = f16vec2(ds_out);
#else
        data_b[ibx4_outer].ds[ibx4_inner] = f16vec2(ds_out);
#endif
    }
}

void main() {
    uint wgid = gl_WorkGroupID.x;
    while (wgid < p.num_blocks) {
        quantize(wgid);
        wgid += gl_NumWorkGroups.x;
    }
}
