#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// ArifiLabs lane-209 R7 - DIRECT SCALES.
//
// This is the only q*_k mat-vec shader that stages its scales through LDS: upstream loads all 16
// int8 scales of the superblock into a double-buffered shared tile and pays a barrier() per ROW,
// INSIDE the row loop (q4_k / q5_k unpack their scales in registers, no shared memory, no
// barrier). The barrier is a workgroup-wide ordering point in the middle of that loop, so row
// n+1's global loads cannot be issued underneath row n's math and the shader runs latency-bound
// rather than bandwidth-bound.
//
// The exchange moves NO data between threads: every thread only ever consumed
// scales[s_offset + {0,2,4,6}] of its OWN block (the group of 16 threads all work on block i, and
// each writes scales[itid] before reading four fixed indices back). Reading those four bytes
// straight out of the block yields the identical values in the identical fma order, so the result
// is bit-identical - the block's scale array is 16 bytes, so all four reads are the same cache
// line the LDS staging was fetching anyway.
//
// Gated by specialization constant 3 so ONE binary serves both arms:
//   1 (default) = direct register reads       0 = upstream LDS + barrier path, byte for byte.
// The host reads GGML_VK_Q6K_DIRECT_SCALES=0 to build the pipelines with 0.
layout (constant_id = 3) const uint ARIFI_Q6K_DIRECT_SCALES = 1;

// ArifiLabs lane-236 R48c - ACTIVATION HOIST + (-32) FOLD.
//
// Two per-byte costs this shader pays and its q4_k / q5_k siblings do not:
//
//   1. The four data_b vec4 loads of a superblock sit inside the `for n < num_rows` row loop,
//      so they are issued num_rows times for bytes that do not depend on the row at all.
//      (rm_kq = 2 on this box, so exactly twice as often as needed.)
//   2. q6_K weights are biased: every weight needs a `- 32`. That is 16 v_sub_f32 per thread
//      per superblock PER ROW. q4_k / q5_k are unsigned and pay none of it.
//
// Arm 1 fixes both with one restructure, because the fix for (2) needs what the fix for (1)
// produces: sum_l b[l]*(u[l] - 32) == sum_l b[l]*u[l] - 32 * sum_l b[l], and sum_l b[l] is
// activation-only, so it is computed once per superblock alongside the hoisted loads and reused
// across every row. 16 subtractions per row become one fma per sub-block per column.
//
// This is NOT bit-identical to arm 0: the -32 moves from inside the fma chain to a single fma
// after it, which reorders float sums. It is applied identically in BOTH ARIFI_Q6K_DIRECT_SCALES
// arms, so the direct-scales win's gate - that its two arms are bit-identical TO EACH OTHER -
// is untouched. FLOAT_TYPE is `float` for every mat-vec pipeline (vulkan-shaders-gen.cpp:846
// base_dict), never float16_t, so the cancellation in `rawsum - 32*xsum` happens in fp32.
//
// The fold carries its own n-GATE at NUM_COLS <= 3 (see the count at the gate itself): it
// removes 16 subtractions per row but adds 4 fma per row PER COLUMN, so it inverts at width 5+.
// The hoist has no such crossover and applies at every width in arm 1.
//
// Gated by specialization constant 4 so ONE binary serves both arms:
//   1 (default) = hoist + (n<=3) fold   0 = shipped order, byte for byte.
// The host reads GGML_ARIFI_Q6K_XFOLD=0 to build the pipelines with 0. Separate constant from
// DIRECT_SCALES on purpose: this one changes live register state (NUM_COLS x 4 vec4 held across
// the row loop), which is the shape that spilled in lane-230 - see mul_mat_vec_sx8.comp:60-71,
// where whole-block ownership lost -45% at n=5 and -77% at n=8. A kernel written without a
// compiler must keep a one-binary way to back that out.
layout (constant_id = 4) const uint ARIFI_Q6K_XFOLD = 1;

shared FLOAT_TYPE sccache[2][BLOCK_SIZE/16][16];

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
uint csel = 0;

void calc_superblock(const uint a_offset, const uint b_offset, const uint itid, const uint ix, const uint ql_offset, const uint qh_offset, const uint s_offset, const uint y_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows, const bool all_threads) {
    if (ARIFI_Q6K_DIRECT_SCALES != 0 && i >= num_blocks_per_row) {
        // no cross-thread exchange to join, so a thread with no block simply has no work
        return;
    }

    const uint y_idx = i * QUANT_K + y_offset;

    // Hoisted activation tile + its per-sub-block sum. Row-independent, so loaded once per
    // superblock and reused across all num_rows rows. When ARIFI_Q6K_XFOLD == 0 the whole block
    // is folded away by the specialization pass and these are dead.
    //
    // The `i < num_blocks_per_row` guard matters only in the ARIFI_Q6K_DIRECT_SCALES == 0 arm:
    // there a thread with no block still enters calc_superblock (it has to reach the barrier) and
    // y_idx would index past data_b. In the DIRECT_SCALES != 0 arm the early return above already
    // makes the guard true. No barrier is inside it, so it is safe to be non-uniform.
    vec4 bc0[NUM_COLS], bc32[NUM_COLS], bc64[NUM_COLS], bc96[NUM_COLS];
    FLOAT_TYPE xs0[NUM_COLS], xs32[NUM_COLS], xs64[NUM_COLS], xs96[NUM_COLS];
    if (ARIFI_Q6K_XFOLD != 0 && i < num_blocks_per_row) {
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            bc0[j]  = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4     ]);
            bc32[j] = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 +  8]);
            bc64[j] = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 16]);
            bc96[j] = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 24]);

            // n-GATE on the FOLD only (the hoist above is unconditional within arm 1).
            //
            // Counted per thread per superblock per row: dropping the `- 32` removes 16 v_sub;
            // paying the offset once per sub-block costs 4 fma PER COLUMN. Net = NUM_COLS*4 - 16,
            // so the fold is a win at NUM_COLS <= 3, exactly break-even at 4, and a LOSS at 5..8.
            // Gated at <= 3 for the same reason and in the same shape as the S-X8 n-GATE
            // (mul_mat_vec_sx8.comp:72). NUM_COLS is specialization constant 2, fixed per pipeline
            // at creation, so only one side is ever register-allocated.
            //
            // Stated summation order: (x + y) + (z + w). Pairwise, so the order is pinned by the
            // parentheses rather than left to the compiler (dot() would not pin it).
            if (NUM_COLS <= 3) {
                xs0[j]  = (FLOAT_TYPE(bc0[j].x)  + FLOAT_TYPE(bc0[j].y))  + (FLOAT_TYPE(bc0[j].z)  + FLOAT_TYPE(bc0[j].w));
                xs32[j] = (FLOAT_TYPE(bc32[j].x) + FLOAT_TYPE(bc32[j].y)) + (FLOAT_TYPE(bc32[j].z) + FLOAT_TYPE(bc32[j].w));
                xs64[j] = (FLOAT_TYPE(bc64[j].x) + FLOAT_TYPE(bc64[j].y)) + (FLOAT_TYPE(bc64[j].z) + FLOAT_TYPE(bc64[j].w));
                xs96[j] = (FLOAT_TYPE(bc96[j].x) + FLOAT_TYPE(bc96[j].y)) + (FLOAT_TYPE(bc96[j].z) + FLOAT_TYPE(bc96[j].w));
            }
        }
    }

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint ib0 = a_offset + (first_row+n)*num_blocks_per_row;

        if (ARIFI_Q6K_DIRECT_SCALES == 0) {
            csel ^= 1;

            if (!all_threads) { // when we don't have enough blocks to use all threads
                if (i < num_blocks_per_row)
                    sccache[csel][ix][itid] = FLOAT_TYPE(data_a[ib0 + i].scales[itid]);
                barrier();

                if (i >= num_blocks_per_row)
                    continue;
            }
        }

        const uint32_t ql0_u32 =  uint32_t(data_a_packed16[ib0 + i].ql[ql_offset / 2]) | (uint32_t(data_a_packed16[ib0 + i].ql[ql_offset / 2 + 1]) << 16);
        const uint32_t ql32_u32 = uint32_t(data_a_packed16[ib0 + i].ql[ql_offset / 2 + 16]) | (uint32_t(data_a_packed16[ib0 + i].ql[ql_offset / 2 + 17]) << 16);

        const uint32_t ql0_u32_lo4 = ql0_u32 & 0x0F0F0F0F;
        const uint32_t ql0_u32_hi4 = (ql0_u32 >> 4) & 0x0F0F0F0F;
        const uint32_t ql32_u32_lo4 = ql32_u32 & 0x0F0F0F0F;
        const uint32_t ql32_u32_hi4 = (ql32_u32 >> 4) & 0x0F0F0F0F;

        const uint32_t qh_u32 = uint32_t(data_a_packed16[ib0 + i].qh[qh_offset / 2]) | (uint32_t(data_a_packed16[ib0 + i].qh[qh_offset / 2 + 1]) << 16);
        const uint32_t qh0_u32 = (qh_u32 & 0x03030303) << 4;
        const uint32_t qh2_u32 = (qh_u32 & 0x0C0C0C0C) << 2;
        const uint32_t qh4_u32 = (qh_u32 & 0x30303030);
        const uint32_t qh6_u32 = (qh_u32 & 0xC0C0C0C0) >> 2;

        const uint32_t q0_u32 = ql0_u32_lo4  | qh0_u32;
        const uint32_t q1_u32 = ql32_u32_lo4 | qh2_u32;
        const uint32_t q2_u32 = ql0_u32_hi4  | qh4_u32;
        const uint32_t q3_u32 = ql32_u32_hi4 | qh6_u32;

        // Arm 1 keeps the raw 0..63 codes; the -32 is applied once per sub-block per column below.
        const vec4 u0 = vec4(unpack8(q0_u32));
        const vec4 u1 = vec4(unpack8(q1_u32));
        const vec4 u2 = vec4(unpack8(q2_u32));
        const vec4 u3 = vec4(unpack8(q3_u32));

        const vec4 q0 = (ARIFI_Q6K_XFOLD != 0 && NUM_COLS <= 3) ? u0 : (u0 - 32);
        const vec4 q1 = (ARIFI_Q6K_XFOLD != 0 && NUM_COLS <= 3) ? u1 : (u1 - 32);
        const vec4 q2 = (ARIFI_Q6K_XFOLD != 0 && NUM_COLS <= 3) ? u2 : (u2 - 32);
        const vec4 q3 = (ARIFI_Q6K_XFOLD != 0 && NUM_COLS <= 3) ? u3 : (u3 - 32);

        FLOAT_TYPE sc0, sc2, sc4, sc6;
        if (ARIFI_Q6K_DIRECT_SCALES == 0) {
            if (all_threads) {
                sccache[csel][ix][itid] = FLOAT_TYPE(data_a[ib0 + i].scales[itid]);
                barrier();
            }
            // hoisted out of the j loop below; nothing writes sccache in between, so the values
            // and the fma order are unchanged from upstream reading them inside the loop.
            sc0 = sccache[csel][ix][s_offset    ];
            sc2 = sccache[csel][ix][s_offset + 2];
            sc4 = sccache[csel][ix][s_offset + 4];
            sc6 = sccache[csel][ix][s_offset + 6];
        } else {
            sc0 = FLOAT_TYPE(data_a[ib0 + i].scales[s_offset    ]);
            sc2 = FLOAT_TYPE(data_a[ib0 + i].scales[s_offset + 2]);
            sc4 = FLOAT_TYPE(data_a[ib0 + i].scales[s_offset + 4]);
            sc6 = FLOAT_TYPE(data_a[ib0 + i].scales[s_offset + 6]);
        }

        const FLOAT_TYPE d = FLOAT_TYPE(data_a[ib0 + i].d);

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            vec4 by0, by32, by64, by96;
            if (ARIFI_Q6K_XFOLD != 0) {
                by0 = bc0[j]; by32 = bc32[j]; by64 = bc64[j]; by96 = bc96[j];
            } else {
                by0  = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4     ]);
                by32 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 +  8]);
                by64 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 16]);
                by96 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 24]);
            }

            FLOAT_TYPE sum[4] = {0, 0, 0, 0};
            [[unroll]] for (uint l = 0; l < 4; ++l) {
                sum[0] = fma(FLOAT_TYPE(by0[l]), q0[l], sum[0]);
                sum[1] = fma(FLOAT_TYPE(by32[l]), q1[l], sum[1]);
                sum[2] = fma(FLOAT_TYPE(by64[l]), q2[l], sum[2]);
                sum[3] = fma(FLOAT_TYPE(by96[l]), q3[l], sum[3]);
            }
            if (ARIFI_Q6K_XFOLD != 0 && NUM_COLS <= 3) {
                sum[0] = fma(FLOAT_TYPE(-32.0), xs0[j],  sum[0]);
                sum[1] = fma(FLOAT_TYPE(-32.0), xs32[j], sum[1]);
                sum[2] = fma(FLOAT_TYPE(-32.0), xs64[j], sum[2]);
                sum[3] = fma(FLOAT_TYPE(-32.0), xs96[j], sum[3]);
            }
            temp[j][n] = fma(fma(sum[0], sc0, fma(sum[1], sc2, fma(sum[2], sc4, sum[3] * sc6))), d, temp[j][n]);
        }
    }
}

void compute_outputs(const uint first_row, const uint num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    // 16 threads are used to process each block
    const uint it_size = gl_WorkGroupSize.x/16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid%16;  // 0...15
    const uint ix = tid/16;

    const uint v_im = itid/8;                               // 0 or 1. 0 computes 0..., 1 computes 128...
    const uint v_in = itid - 8*v_im;                        // 0...7

    const uint l0 = 4 * v_in;                               // 0, 4, 8, ..., 28
    const uint is = v_in / 4;

    const uint ql_offset = 64*v_im + l0;
    const uint qh_offset = 32*v_im + l0;
    const uint s_offset  =  8*v_im + is;
    const uint y_offset = 128*v_im + l0;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    const uint nbr_par_th = num_blocks_per_row%it_size;
    const uint nbr_all_th = num_blocks_per_row - nbr_par_th;
    uint i0 = 0;
    [[unroll]] for (; i0 < nbr_all_th; i0 += it_size)
        calc_superblock(a_offset, b_offset, itid, ix, ql_offset, qh_offset, s_offset, y_offset, i0 + ix, num_blocks_per_row, first_row, num_rows, true);
    calc_superblock(a_offset, b_offset, itid, ix, ql_offset, qh_offset, s_offset, y_offset, i0 + ix, num_blocks_per_row, first_row, num_rows, false);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
