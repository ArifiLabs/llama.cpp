#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#if defined(MUL_MAT_ID_GATHER) && defined(USE_SUBGROUP_ADD_NO_SHMEM) && !defined(DATA_A_F32) && !defined(DATA_A_F16) && !defined(DATA_A_BF16)
#extension GL_KHR_shader_subgroup_shuffle : require
#define ARIFI_GATHER_TAIL 1
#endif

#include "mul_mat_vec_base.glsl"
#include "dequant_funcs.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if !defined(DATA_A_F32) && !defined(DATA_A_F16) && !defined(DATA_A_BF16)
#define K_PER_ITER 8
#else
#define K_PER_ITER 4
#endif

#ifdef ARIFI_GATHER_TAIL
// arifi lane-302 Route A: K-tail redistribution (IQ4_NL down, K = 640 on a 64-lane subgroup: the last K iteration
// ran 16 of 64 lanes). Lane h computes owner (h % tl)'s tail chunk of row (h / tl) with the same statements as
// iter(), then the owner pulls it by subgroupShuffle and applies the same `*= dm.x; temp +=` in the same order.
// Per-lane partials and the subgroupAdd tree are unchanged, so each row is byte-identical to the old path.
layout (constant_id = 3) const uint GATHER_TAIL = 0;
#endif


#if defined(DATA_A_IQ4_NL) && defined(MUL_MAT_ID_GATHER)
// arifi lane-302 Route A: IQ4_NL gather body (spec 4, GGML_ARIFI_IQ4NL_BODY). 1 = byte-pair LUT: one LDS read per
// qs byte gives both nibble values in dequantize4's component order, same floats, so byte-identical by construction.
// 3 = planted wrong arm (pair swapped inside the table; op gate must go RED).
#define ARIFI_IQ4NL_BODY_ON 1
layout (constant_id = 4) const uint ARIFI_IQ4NL_BODY = 0;
shared vec2 arifi_kv2[256];

void arifi_init_kv2() {
    for (uint i = gl_LocalInvocationIndex; i < 256; i += gl_WorkGroupSize.x) {
        const uint lo = ARIFI_IQ4NL_BODY == 3 ? (i >> 4) : (i & 0xFu);
        const uint hi = ARIFI_IQ4NL_BODY == 3 ? (i & 0xFu) : (i >> 4);
        arifi_kv2[i] = vec2(kvalues_iq4nl[lo], kvalues_iq4nl[hi]);
    }
    barrier();
}

vec4 arifi_deq4(uint ib, uint iqs, uint a_offset) {
    if (ARIFI_IQ4NL_BODY == 1 || ARIFI_IQ4NL_BODY == 3) {
        const uint vui = uint(data_a_packed16[a_offset + ib].qs[iqs/2]);
        return vec4(arifi_kv2[vui & 0xFFu], arifi_kv2[vui >> 8]);
    }
    return dequantize4(ib, iqs, a_offset);
}
#else
#define arifi_deq4 dequantize4
#endif

uint a_offset, b_offset, d_offset, y_offset;

vec4 load_b(const uint j, const uint iybs, const uint iqs, const bool lastiter, out bool OOB_y, out bool OOB_z, out bool OOB_w) {
    // Check if the latter elements are OOB, and don't fetch B or accumulate it.
    OOB_y = lastiter && (iybs + iqs + y_offset >= p.ncols);
    OOB_z = lastiter && (iybs + iqs + y_offset*2 >= p.ncols);
    OOB_w = lastiter && (iybs + iqs + y_offset*3 >= p.ncols);

    if (!OOB_w) {
        return vec4(FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs + y_offset]),
                 FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs + y_offset*2]),
                 FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs + y_offset*3]));
    } else if (!OOB_z) {
        return vec4(FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs + y_offset]),
                 FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs + y_offset*2]),
                 0);
    } else if (!OOB_y) {
        return vec4(FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs + y_offset]),
                 0, 0);
    } else {
        return vec4(FLOAT_TYPE(data_b[B_COL(j) + b_offset + iybs + iqs]),
                 0, 0, 0);
    }
}

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i, bool lastiter)
{
#if K_PER_ITER == 8
    // arifi lane-204: dequantize each A block ONCE per row and reuse it across the NUM_COLS
    // columns. The stock loop nested j (column) outside n (row) with dequantize4() inside, so at
    // NUM_COLS=3 every weight block was decoded three times (rocmfp4_fast 17408x5120 on the 780M:
    // 612 us at n=1 -> 1017 us at n=3, 77 -> 47 GB/s). B is the activation (L2-resident); A is the
    // DRAM stream. Arithmetic per (j, n) is unchanged, so results are bit-identical.
    const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
    const uint iqs = (col%QUANT_K)/QUANT_R; // quant index
    const uint iybs = col - col%QUANT_K; // y block start index

    vec4 bv0[NUM_COLS];
    vec4 bv1[NUM_COLS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
#if QUANT_R == 2
        // Note that we end up fetching bogus elements here, but its fine as they'll be
        // within an accessible block.
        const vec4 bv02 = vec4(data_b_v4[(B_COL(j) + b_offset + iybs + iqs) / 4]);
        const vec4 bv13 = vec4(data_b_v4[(B_COL(j) + b_offset + iybs + iqs + y_offset) / 4]);
        bv0[j] = vec4(bv02.x, bv13.x, bv02.y, bv13.y);
        bv1[j] = vec4(bv02.z, bv13.z, bv02.w, bv13.w);
#else
        bv0[j] = vec4(data_b_v4[(B_COL(j) + b_offset + iybs + iqs) / 4]);
        bv1[j] = vec4(data_b_v4[(B_COL(j) + b_offset + iybs + iqs) / 4 + 1]);
#endif
    }

    uint ibi = first_row*p.ncols;
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint ib = (ibi + col)/QUANT_K; // block index
        ibi += p.ncols;

        vec4 v = arifi_deq4(ib, iqs, a_offset);
        vec4 v2 = arifi_deq4(ib, iqs+(4/QUANT_R), a_offset);

        const vec2 dm = get_dm(ib, a_offset);
        if (dm.y != 0) { // quant has min component
            v = v * dm.x + dm.y;
            v2 = v2 * dm.x + dm.y;
        }

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            // matrix multiplication
            FLOAT_TYPE rowtmp = dot(bv0[j], v);
            rowtmp += dot(bv1[j], v2);

            if (dm.y == 0)
                rowtmp *= dm.x;

            temp[j][n] += rowtmp;
        }
    }
#else
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
        const uint iqs = (col%QUANT_K)/QUANT_R; // quant index
        const uint iybs = col - col%QUANT_K; // y block start index

        bool OOB_y;
        bool OOB_z;
        bool OOB_w;

        const vec4 b = load_b(j, iybs, iqs, lastiter, OOB_y, OOB_z, OOB_w);
        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = (ibi + col)/QUANT_K; // block index
            ibi += p.ncols;

            if (!OOB_w) {
                const vec4 v = dequantize4(ib, iqs, a_offset);
                temp[j][n] += dot(v, b);
            } else if (!OOB_z) {
                const vec2 v0 = dequantize(ib, iqs, a_offset);
                const FLOAT_TYPE v1 = dequantize1(ib + 2/QUANT_R, iqs, a_offset);
                const vec3 v = vec3(v0.x, v0.y, v1);
                const vec3 b0 = vec3(b.x, b.y, b.z);
                temp[j][n] += dot(v, b0);
            } else if (!OOB_y) {
                const vec2 v0 = dequantize(ib, iqs, a_offset);
                const vec2 b0 = vec2(b.x, b.y);
                temp[j][n] += dot(v0, b0);
            } else {
                const FLOAT_TYPE v = dequantize1(ib, iqs, a_offset);
                temp[j][n] = fma(v, b.x, temp[j][n]);
            }
        }
    }
#endif
}

#ifdef ARIFI_GATHER_TAIL
void tail_iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i, const uint tl)
{
    // helper side: lane tid computes the tail chunk of owner ht for row hn (statements copied from iter())
    const uint hn = tid / tl;
    const uint ht = tid - hn * tl;
    FLOAT_TYPE pre[NUM_COLS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        pre[j] = FLOAT_TYPE(0);
    }
    if (hn < num_rows) {
        const uint col = i*BLOCK_SIZE + K_PER_ITER*ht;
        const uint iqs = (col%QUANT_K)/QUANT_R;
        const uint iybs = col - col%QUANT_K;
        const uint ib = ((first_row + hn)*p.ncols + col)/QUANT_K;

        vec4 v = arifi_deq4(ib, iqs, a_offset);
        vec4 v2 = arifi_deq4(ib, iqs+(4/QUANT_R), a_offset);

        const vec2 dm = get_dm(ib, a_offset);
        if (dm.y != 0) {
            v = v * dm.x + dm.y;
            v2 = v2 * dm.x + dm.y;
        }

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
#if QUANT_R == 2
            const vec4 bv02 = vec4(data_b_v4[(B_COL(j) + b_offset + iybs + iqs) / 4]);
            const vec4 bv13 = vec4(data_b_v4[(B_COL(j) + b_offset + iybs + iqs + y_offset) / 4]);
            const vec4 bv0 = vec4(bv02.x, bv13.x, bv02.y, bv13.y);
            const vec4 bv1 = vec4(bv02.z, bv13.z, bv02.w, bv13.w);
#else
            const vec4 bv0 = vec4(data_b_v4[(B_COL(j) + b_offset + iybs + iqs) / 4]);
            const vec4 bv1 = vec4(data_b_v4[(B_COL(j) + b_offset + iybs + iqs) / 4 + 1]);
#endif
            FLOAT_TYPE rowtmp = dot(bv0, v);
            rowtmp += dot(bv1, v2);
            pre[j] = rowtmp;
        }
    }

    // owner side: lanes < tl own a tail chunk; every lane joins the shuffle (uniform control flow)
    const bool owner = tid < tl;
    const uint col = i*BLOCK_SIZE + K_PER_ITER*(owner ? tid : 0);
    uint ibi = first_row*p.ncols;
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint ib = (ibi + col)/QUANT_K;
        ibi += p.ncols;
        const vec2 dm = get_dm(ib, a_offset);
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            // GATHER_TAIL == 2 is the planted wrong arm (pulls the neighbour lane's chunk; op gate must go RED)
            FLOAT_TYPE rowtmp = subgroupShuffle(pre[j], n*tl + (owner ? tid : 0) + (GATHER_TAIL == 2 ? 1 : 0));
            if (owner) {
                if (dm.y == 0)
                    rowtmp *= dm.x;

                temp[j][n] += rowtmp;
            }
        }
    }
}
#endif

#if defined(DATA_A_F32) || defined(DATA_A_F16) || defined(DATA_A_BF16)
void iter_aligned_nonquant(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i)
{
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
        const uint iqs = 0; // quant index
        const uint iybs = col; // y block start index

        const vec4 b = data_b_v4[(B_COL(j) + b_offset + iybs + iqs) / 4];

        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = (ibi + col)/QUANT_K; // block index
            ibi += p.ncols;

            const vec4 v = dequantize4_2aligned(ib, iqs, a_offset);

            // matrix multiplication
            temp[j][n] += dot(v, b);
        }
    }
}
#endif

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    get_offsets(a_offset, b_offset, d_offset);
    const bool is_aligned_nonquant =
        p.batch_stride_b % 4 == 0 && p.ncols % 4 == 0 &&
        a_offset % 4 == 0 && b_offset % 4 == 0 &&
        BLOCK_SIZE % 4 == 0 && K_PER_ITER == 4;

    y_offset = QUANT_R == 1 ? 1 : QUANT_K/2;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    uint num_iters = p.ncols / (K_PER_ITER * BLOCK_SIZE);
#ifdef ARIFI_GATHER_TAIL
    const uint tail_lanes = (p.ncols - num_iters * K_PER_ITER * BLOCK_SIZE) / K_PER_ITER;
    const bool use_tail = GATHER_TAIL != 0 && tail_lanes != 0 && (p.ncols % K_PER_ITER) == 0 &&
                          tail_lanes * num_rows <= BLOCK_SIZE && gl_SubgroupSize == BLOCK_SIZE;
    if (!use_tail)
#endif
    if (num_iters * K_PER_ITER * BLOCK_SIZE + K_PER_ITER*tid < p.ncols) {
        num_iters++;
    }
    int unroll_count = 4;
    uint unrolled_iters = num_iters & ~(unroll_count - 1);

    uint i = 0;

#if K_PER_ITER == 4
    // If the K dimension is odd, we need lastiter==true on the last iteration
    // so OOB is computed correctly. Skip some unrolling to make that happen.
    if ((p.ncols & 3) != 0 &&
        unrolled_iters == num_iters &&
        unrolled_iters > 0) {
        unrolled_iters -= unroll_count;
    }
    if (is_aligned_nonquant) {
        while (i < unrolled_iters) {
            // Manually partially unroll the loop
            [[unroll]] for (uint k = 0; k < unroll_count; ++k) {
                iter_aligned_nonquant(temp, first_row, num_rows, tid, i*K_PER_ITER);
                i++;
            }
        }
    } else {
#endif
    while (i < unrolled_iters) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < unroll_count; ++k) {
            iter(temp, first_row, num_rows, tid, i*K_PER_ITER, false);
            i++;
        }
    }
#if K_PER_ITER == 4
    }
#endif

    unroll_count = 2;
    unrolled_iters = num_iters & ~(unroll_count - 1);

#if K_PER_ITER == 4
    if ((p.ncols & 3) != 0 &&
        unrolled_iters == num_iters &&
        unrolled_iters > 0) {
        unrolled_iters -= unroll_count;
    }

    if (is_aligned_nonquant) {
        while (i < unrolled_iters && is_aligned_nonquant) {
            // Manually partially unroll the loop
            [[unroll]] for (uint k = 0; k < unroll_count; ++k) {
                iter_aligned_nonquant(temp, first_row, num_rows, tid, i*K_PER_ITER);
                i++;
            }
        }
    } else {
#endif
    while (i < unrolled_iters) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < unroll_count; ++k) {
            iter(temp, first_row, num_rows, tid, i*K_PER_ITER, false);
            i++;
        }
    }
#if K_PER_ITER == 4
    }
#endif

#if K_PER_ITER == 4
    if (is_aligned_nonquant) {
        while (i < num_iters) {
            iter_aligned_nonquant(temp, first_row, num_rows, tid, i*K_PER_ITER);
            i++;
        }
    } else {
#endif
    while (i < num_iters) {
        iter(temp, first_row, num_rows, tid, i*K_PER_ITER, true);
        i++;
    }
#if K_PER_ITER == 4
    }
#endif

#ifdef ARIFI_GATHER_TAIL
    if (use_tail) {
        tail_iter(temp, first_row, num_rows, tid, num_iters*K_PER_ITER, tail_lanes);
    }
#endif

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * WG_ROWBLOCK;

#ifdef MUL_MAT_ID_GATHER
    if (!gather_setup()) {
        return;
    }
#endif

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif
#ifdef ARIFI_IQ4NL_BODY_ON
    if (ARIFI_IQ4NL_BODY == 1 || ARIFI_IQ4NL_BODY == 3) {
        arifi_init_kv2();
    }
#endif

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, min(NUM_ROWS, p.stride_d - first_row));
    }
}
