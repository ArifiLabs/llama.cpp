#version 450

#ifndef ESCHA_COOPMAT
#define ESCHA_COOPMAT 0
#endif

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#if ESCHA_COOPMAT
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#endif

// ArifiLabs Escha-W2 fused linear mat-vec (lane-164).
//
//   y = D(rout*s_out) * H128( decode(codes)^T * H128(D(rin*s_in) * x) ) + bias
//
// One workgroup = one 128-channel output block (8 adjacent 16x16 code tiles per
// in-block) for a BLOCK of ESCHA_COLS activation columns. Thread j owns output
// channel ob*128+j. The activation blocks are staged + Hadamard-transformed in
// shared memory (portable barriers version; the lane-163 subgroup butterfly is an
// upgrade path).
//
// ESCHA_COLS (lane-164 part 2): decoding a weight tile does not depend on the
// activation column, but the original kernel gave each workgroup exactly one column
// and so re-decoded the ENTIRE weight matrix once per column - prefill paid the whole
// decode ncols times. Staging C columns lets one decode serve C accumulators, so the
// decode cost falls ~C-fold; only the far cheaper staging, Hadamard and LDS reads
// scale with C. Shared memory is C*512 bytes and the butterfly is fused across the C
// columns, so the barrier count does not depend on C. ESCHA_COLS=1 reproduces the
// original kernel exactly and is kept as the A/B arm.
//
// Decode math is the recovered cbA generator (Terra-64, trial-evidence/escha-decoder):
// deterministic-by-spec here — integer ops, unpackHalf2x16 (exact), one f32 add
// (correctly rounded per Vulkan), and a SOFTWARE f32->f16 RTE round, so no
// dependence on driver f16 float-controls (Terra-66: glslc does not emit them).
// Compile with ESCHA_K = 2 or 3.

// SEAT-40 OCCUPANCY LEVER: how many 128-channel output blocks one workgroup serves.
//
// At ESCHA_BLOCKS=1 a workgroup is 128 threads, which on a warp-64 device is TWO waves - too few
// to hide the memory latency of the code fetch behind the generator's ALU work. ESCHA_BLOCKS=2
// makes it 256 threads (four waves) covering two adjacent output blocks that share the same
// activation column, so the extra parallelism costs no extra staging traffic.
//
// Each half keeps its OWN copy of the staged activations. That duplicates the Hadamard butterfly,
// which is deliberate: the butterfly is roughly 7 operations per thread per input block against
// ~768 for the tile loop, under 1% of the work, and a shared copy would need either non-uniform
// barriers (undefined) or two threads writing the same slot (a race, even with equal values).
#ifndef ESCHA_BLOCKS
#define ESCHA_BLOCKS 1
#endif
#define NB (ESCHA_BLOCKS)

layout(local_size_x = 128 * ESCHA_BLOCKS, local_size_y = 1, local_size_z = 1) in;

#ifndef ESCHA_COLS
#define ESCHA_COLS 1
#endif
#define NC (ESCHA_COLS)

layout (push_constant) uniform parameter {
    uint n_in;
    uint n_out;
    uint ncols;
    uint Tout;       // n_out/16
    uint col_offset; // first activation column of this dispatch (host chunks Y — F-124)
} p;

layout (binding = 0) readonly  buffer A { uint  data_a[]; };  // packed codes, u32 view
layout (binding = 1) readonly  buffer B { float data_b[]; };  // x [n_in, ncols]
layout (binding = 2) readonly  buffer C { float data_c[]; };  // aux: rin | rout | bias
layout (binding = 3) writeonly buffer D { float data_d[]; };  // y [n_out, ncols]

// SEAT-40 LEVER 4: the generator as a table instead of arithmetic.
//
// escha_F is a pure function of a 16-bit codeword, so all 65,536 of its values fit in a table of
// 128 KiB (two f16 results per uint). The estate CLOSED this option by reasoning - "a 128 KB random
// lookup per weight on a bandwidth-shared APU loses to ~7 ALU ops" - and never ran it. That is an
// unverified refusal, and the arithmetic behind it has changed twice since: the generator is now
// about six operations, and this device carries 2 MiB of L2, so the whole table can sit resident.
//
// The access is not really random either: consecutive codewords come from one 32-bit word shifted
// by two bits at a time, so neighbouring lookups land in nearby table entries.
//
// MEASURED AND REFUTED, 2026-08-21. The table is 4.9x SLOWER than the arithmetic:
//     arithmetic generator   pp512 16.78   tg32 3.92
//     65,536-entry table     pp512 16.62   tg32 0.80
// Same binary, arms alternated, idle rig, Balanced. The estate had closed this option by reasoning
// and the reasoning was right - it is now closed by a number instead. Prefill is untouched because
// the multi-column path amortises the lookup across columns; decode, one lookup per weight, is
// where it dies. Correctness was proven first: test-backend-ops -o ESCHA_MM, 20 cases, 0 FAIL on
// BOTH arms, so this is a speed verdict on a correct implementation.
//
// Values are computed host-side with the SAME arithmetic, so the table is exact by construction,
// not approximately equal. ESCHA_LUT=0 restores the arithmetic generator.
#ifndef ESCHA_LUT
#define ESCHA_LUT 0
#endif
// Declared ONLY in the table arm. It was briefly declared in both so one pipeline layout could
// serve either, and the assumption that "an unused binding costs nothing" was wrong on this
// driver: binding a fifth buffer on every dispatch cost 4.8x on the single-column decode path
// (3.91 -> 0.81 t/s, same box, same session, verified against a saved binary). The arithmetic arm
// must not pay for a table it never reads.
#if ESCHA_LUT
layout (binding = 4) readonly buffer L { uint data_l[]; };   // 32768 uints = 65536 f16 values
#endif

#ifndef ESCHA_F16_STAGE
#define ESCHA_F16_STAGE 0
#endif

#if ESCHA_F16_STAGE
shared float16_t sh[NB][NC][128];
#define ESCHA_SH_STORE(v) float16_t(v)
#define ESCHA_SH_LOAD(v)  float(v)
#else
shared float sh[NB][NC][128];
#define ESCHA_SH_STORE(v) (v)
#define ESCHA_SH_LOAD(v)  (v)
#endif

// The cooperative-matrix arm is deliberately C=16 only: the KHR shape selected
// by the host is 16x16x16, so a smaller ladder rung would merely burn inactive
// matrix lanes.  Per workgroup this is 8 KiB sh + 4 KiB weights + 512 B inputs
// + 8 KiB result = 20,992 B, safely below the 32 KiB reported by the 780M.
#if ESCHA_COOPMAT
shared float16_t cm_weight[128 * 16]; // [output lane][16 input lanes], row-major
shared float16_t cm_input [16 * 16];  // [input lane][activation column], row-major
shared float     cm_output[128 * 16]; // [activation column][output lane], column-major
#endif

const float INV_SQRT128 = 0.08838834764831845;

#if ESCHA_K == 2
#define TILE_U32S 16u
#else
#define TILE_U32S 24u
#endif

// software round-to-nearest-even f32 -> f16 bit pattern (denormal-correct)
uint f32_to_f16_rte(float f) {
    const uint x    = floatBitsToUint(f);
    const uint sign = (x >> 16) & 0x8000u;
    const int  e    = int((x >> 23) & 0xFFu) - 127 + 15;
    uint m = x & 0x7FFFFFu;
    if (e >= 31) {
        return sign | 0x7C00u;
    }
    if (e <= 0) {
        if (e < -10) {
            return sign;
        }
        m |= 0x800000u;
        const uint shift = uint(14 - e);
        const uint r = (m + (1u << (shift - 1u)) - 1u + ((m >> shift) & 1u)) >> shift;
        return sign | r;
    }
    uint r = m + 0xFFFu + ((m >> 13) & 1u);
    uint ee = uint(e);
    if ((r & 0x800000u) != 0u) {
        r = 0u;
        ee += 1u;
        if (ee >= 31u) {
            return sign | 0x7C00u;
        }
    }
    return sign | (ee << 10) | (r >> 13);
}

// the recovered cbA scalar generator F(x) on a 16-bit window
//
// PERF (HQ seat-38, 2026-08-21): this runs ONCE PER WEIGHT PER TOKEN and it dominated the kernel.
// The software f32_to_f16_rte above is ~15 instructions with three branches; the rest of the
// generator is five. A hardware f32->f16 convert replaces those ~15 with one.
//
// WHICH hardware convert matters, and this was MEASURED, not reasoned:
//   * packHalf2x16 is WRONG here. Its rounding is implementation-defined and AMD lowers it to
//     V_CVT_PKRTZ_F16_F32 -- round-toward-zero BY NAME. The exhaustive sweep caught it failing
//     134,230 of 524,288 codewords (25.6%), every single one rounding DOWN by one ulp.
//   * float16_t(s) is CORRECT. It lowers to V_CVT_F16_F32, which honours the hardware round mode
//     (RTE default), and is bit-exact on all 524,288 words against the July rung-1 golden.
// Both facts are receipts, not inference:
//   research/local-inference/lane-evidence/2026-08-20-lane-164-escha-native/rte-sweep/
//
// The software routine stays because Terra-66 measured that glslc does not emit float-control
// execution modes, so the rounding mode is a DEVICE FACT. ESCHA_HW_RTE=0 restores it. Do not flip
// the default on taste, and do not "simplify" the cast below back to packHalf2x16: re-run the
// sweep on any device or driver change, because that is the only thing keeping this honest.
#ifndef ESCHA_HW_RTE
#define ESCHA_HW_RTE 1
#endif

// SEAT-40 LEVER: stay in f16 for the whole generator.
//
// The profile says ESCHA_MM is 86.95% of decode GPU time (13,200 calls, 642 us each), so the
// generator is still the whole cost after the RTE fix -- the bottleneck did not move.
//
// unpackHalf2x16 widens both halves to f32 (two V_CVT_F32_F16), adds in f32, then narrows back
// (one V_CVT_F16_F32) and widens again for the FMA. unpackFloat2x16 reinterprets the same bits as
// float16_t with no convert at all, so the add happens in f16 and only ONE widening survives.
// Three instructions of roughly eight, on the single hottest line in the model.
//
// It is bit-identical, not approximately so: an f16 add is the exact sum rounded once to f16, and
// the sum of two f16 values is always exact in f32, so both spellings round the same real number
// the same way. PROVEN, not argued -- the exhaustive 65,536-codeword sweep carries a fourth column
// comparing this against the shipped path: "CANDIDATE EXACT: F16ADD matches the SHIPPED F16CAST
// path on all 524288 words, bit for bit" (rte-sweep/RTE-SWEEP-RESULT.txt).
//
// The device reports denorm-preserve TRUE for f16, which is the one behaviour that could have
// separated the two paths. On a device that flushes f16 denormals this must be re-swept before it
// is trusted; ESCHA_F16_GEN=0 restores the f32 path.
#ifndef ESCHA_F16_GEN
#define ESCHA_F16_GEN 1
#endif

// SEAT-40 LEVER 3: get the generator's multiply off the quarter-rate path.
//
// Instruction COUNT was the wrong thing to minimise. On RDNA, V_MUL_LO_U32 is a quarter-rate
// instruction - roughly four normal ALU slots - while V_MUL_U32_U24 is full rate. The generator's
// `xw * 0xCBAC1FED` is a full 32-bit multiply, so by cost it can be a larger share of the
// generator than every other step put together, and the earlier levers were all shaving the cheap
// part.
//
// xw is a 16-bit window. Split the constant into two halves and the same low 32 bits fall out of
// two multiplies whose operands are both under 2^24, which is the form the full-rate instruction
// accepts:
//     xw*M = xw*(M & 0xFFFF) + (xw*(M >> 16) << 16)   (mod 2^32)
// Proven exhaustively over all 65,536 windows before it was written here: zero mismatches.
//
// Whether the driver actually selects the 24-bit form is its choice, not ours - GLSL has no way to
// demand it. Hence a switch and a measurement.
#ifndef ESCHA_MUL24
#define ESCHA_MUL24 0
#endif

uint escha_mix(uint xw) {
#if ESCHA_MUL24
    const uint lo = xw * 0x1FEDu;                  // operands < 2^24: full-rate form available
    const uint hi = xw * 0xCBACu;
    return lo + (hi << 16);                        // low 32 bits of xw * 0xCBAC1FED
#else
    return xw * 0xCBAC1FEDu;                       // one quarter-rate V_MUL_LO_U32
#endif
}

float escha_F(uint xw) {
#if ESCHA_LUT
    const uint packed = data_l[xw >> 1u];
    return float(unpackFloat2x16(packed)[xw & 1u]);
#else
    const uint q = 0x3B603B60u ^ (escha_mix(xw) & 0x8FFF8FFFu);
#if ESCHA_F16_GEN
    const f16vec2 hh = unpackFloat2x16(q);         // pure bit reinterpret, no convert
    return float(hh.x + hh.y);                     // one f16 add, one widen
#else
    const vec2 h = unpackHalf2x16(q);
    const float s = h.x + h.y;                     // exact operands; correctly-rounded f32 add
#if ESCHA_HW_RTE
    return float(float16_t(s));                    // one hardware V_CVT_F16_F32, RTE-proven
#else
    return unpackHalf2x16(f32_to_f16_rte(s)).x;    // value of the f16-rounded sum
#endif
#endif
#endif
}

// SEAT-40 LEVER 2: decode TWO codewords per packed f16 add.
//
// After the f16-native generator the per-weight cost is roughly imul, and, xor, one f16 add and
// one widen. The add is the only step that can serve two weights at once: RDNA has v_pk_add_f16,
// which adds two f16 lanes in one instruction. Feeding it needs the two sums arranged VERTICALLY
// (x-components against y-components) rather than horizontally within one pair, which is what the
// swizzle below builds.
//
// This changes no arithmetic - each sum is still the same f16 add of the same two f16 operands -
// so the F16ADD sweep column covers this path's values too. Whether the compiler actually emits
// the packed form is a device/driver fact, which is why this is a switch with a measurement rather
// than an assumption.
//
// REFUTED ON THIS DEVICE, OFF BY DEFAULT. Two rounds, arms alternated, one thermal session:
//     base (scalar f16 generator)  pp512 16.47 / 16.13   tg32 3.91 / 3.87
//     packed pair                  pp512 16.09 / 16.24   tg32 3.82 / 3.72
// Slightly WORSE, about 3% of decode. The swizzle that arranges the operands vertically costs at
// least as much as the add it saves, and the two extra window shifts have to be live at once,
// which raises register pressure on a kernel that already holds an accumulator per column.
// Correctness was proven first and separately: test-backend-ops -o ESCHA_MM, 12 OK / 0 FAIL.
// Kept behind the switch because a driver that fuses the swizzle would flip the result.
#ifndef ESCHA_F16_PAIR
#define ESCHA_F16_PAIR 0
#endif

vec2 escha_F2(uint x0, uint x1) {
    const uint q0 = 0x3B603B60u ^ (escha_mix(x0) & 0x8FFF8FFFu);
    const uint q1 = 0x3B603B60u ^ (escha_mix(x1) & 0x8FFF8FFFu);
    const f16vec2 h0 = unpackFloat2x16(q0);
    const f16vec2 h1 = unpackFloat2x16(q1);
    const f16vec2 s  = f16vec2(h0.x, h1.x) + f16vec2(h0.y, h1.y);   // one v_pk_add_f16
    return vec2(s);
}

// 64-bit funnel shift via two u32s; no shaderInt64
uint shr64_32(uint lo, uint hi, uint s) {
    if (s == 0u)  return lo;
    if (s < 32u)  return (lo >> s) | (hi << (32u - s));
    if (s == 32u) return hi;
    return hi >> (s - 32u);
}

// One butterfly over all NC staged columns.
//
// PERF (HQ seat-38, 2026-08-21): the all-shared version below cost 2 barriers per step x 7 steps
// = 14 barriers per 128-input block. At n_in=17408 that is 136 blocks x 14 = ~1900 workgroup
// barriers per column block, and a barrier stalls all 128 threads on the slowest one.
//
// A butterfly partner at distance `step` lives in the SAME subgroup whenever step < subgroup size,
// so those steps need no shared memory and no barrier at all: each thread reads its own slot,
// shuffles the partner's value across the subgroup, and writes only its own slot back. Only the
// steps that cross a subgroup boundary still go through shared memory. On this device (warp 64,
// measured by lane-165) that is 6 of 7 steps shuffled and one crossing step, so 14 barriers
// become 3. At subgroup 32 it is 5 shuffled and two crossing, so 5.
//
// The mapping tid = subgroupId*gl_SubgroupSize + gl_SubgroupInvocationID is what makes
// subgroupShuffleXor(a, step) the partner at tid^step. That is a DEVICE FACT for a 1-D 128-thread
// workgroup, not a spec guarantee -- the same assumption lane-163/165 shipped and validated here.
// ESCHA_SG_HADAMARD=0 restores the all-shared butterfly if a device ever disagrees.
//
// DEFAULT IS 0 BECAUSE MEASUREMENT SAYS SO (seat-38, 2026-08-21). The barrier-count reasoning was
// sound and the lever still does what it claims -- it just does not buy anything here, because the
// kernel is ALU-bound on the per-weight generator, not barrier-bound. llama-bench b=ub=p=512 on
// the 27B Escha model, one lever at a time:
//     neither lever   pp512  6.66   tg32 1.55
//     SG only         pp512  6.48   tg32 1.52   <- slightly WORSE than doing nothing
//     RTE only        pp512 15.03   tg32 3.21   <- the entire win
//     both            pp512 14.58   tg32 3.22   <- SG costs ~3% of prefill on top of RTE
// Receipts: research/local-inference/lane-evidence/2026-08-20-lane-164-escha-native/
//   BENCH-escha-b512-{SG-only,RTE-only,BOTH-levers}.txt
// The code stays behind the switch: on a device where the generator is cheaper, or at subgroup 32
// with a different barrier ratio, this may well win. Re-measure before flipping it back on.
#ifndef ESCHA_SG_HADAMARD
#define ESCHA_SG_HADAMARD 0
#endif

void hadamard128(uint hb, uint tid) {
#if ESCHA_F16_STAGE
    // Keep the butterfly in f32 registers. The shared f16 array is only the
    // cross-subgroup exchange and tile-loop representation.
    float a[NC];
    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
        a[cj] = float(sh[hb][cj][tid]);
    }

    [[unroll]] for (uint step = 1u; step < 128u; step <<= 1u) {
        if (step < gl_SubgroupSize) {
            [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
                const float o = subgroupShuffleXor(a[cj], step);
                a[cj] = ((tid & step) == 0u) ? (a[cj] + o) : (o - a[cj]);
            }
        } else {
            [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
                sh[hb][cj][tid] = float16_t(a[cj]);
            }
            barrier();
            [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
                const float o = float(sh[hb][cj][tid ^ step]);
                a[cj] = ((tid & step) == 0u) ? (a[cj] + o) : (o - a[cj]);
            }
            barrier();
        }
    }

    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
        sh[hb][cj][tid] = float16_t(a[cj]);
    }
    barrier();
#else
    [[unroll]] for (uint step = 1u; step < 128u; step <<= 1u) {
#if ESCHA_SG_HADAMARD
        if (step < gl_SubgroupSize) {          // uniform branch: partner is in my subgroup
            [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
                const float a = sh[hb][cj][tid];
                const float o = subgroupShuffleXor(a, step);
                sh[hb][cj][tid] = ((tid & step) == 0u) ? (a + o) : (o - a);
            }
            continue;                          // no barrier: each thread touched only its own slot
        }
        barrier();                             // publish the shuffle phase before a crossing step
#endif
        float a[NC], o[NC];
        [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
            a[cj] = sh[hb][cj][tid];
            o[cj] = sh[hb][cj][tid ^ step];
        }
        barrier();
        [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
            sh[hb][cj][tid] = ((tid & step) == 0u) ? (a[cj] + o[cj]) : (o[cj] - a[cj]);
        }
        barrier();
    }
#if ESCHA_SG_HADAMARD
    barrier();                                 // the tile loop reads every lane's slot
#endif
#endif
}

#if ESCHA_COOPMAT
// Matrix-core multi-column path.  Each subgroup owns gl_SubgroupSize/16 of the
// eight 16-output tiles.  The pipeline forces either a 32- or 64-lane subgroup,
// so the four-element accumulator array covers both supported layouts.
//
// `sums` is f32 even though the operands are f16.  The host only selects this
// shader after confirming the device's 16x16x16 f16xf16->f32 KHR property.
void main() {
    const uint tid  = gl_LocalInvocationID.x;
    const uint ob   = gl_WorkGroupID.x;
    const uint col0 = p.col_offset + gl_WorkGroupID.y * 16u;

    const uint tiles_per_subgroup = gl_SubgroupSize / 16u;
    const uint subgroup_tile_base = gl_SubgroupID * tiles_per_subgroup;

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> mat_a;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mat_b;
    coopmat<float,     gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> sums[4];
    [[unroll]] for (uint ct = 0u; ct < 4u; ++ct) {
        sums[ct] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    }

    const uint n_ib = p.n_in / 128u;
    for (uint ib = 0u; ib < n_ib; ++ib) {
        const uint  gi  = ib * 128u + tid;
        const float rin = data_c[gi];
        [[unroll]] for (uint cj = 0u; cj < 16u; ++cj) {
            const uint cc = min(col0 + cj, p.ncols - 1u);
            sh[0][cj][tid] = ESCHA_SH_STORE(data_b[cc * p.n_in + gi] * rin);
        }
        barrier();
        hadamard128(0u, tid);

        // One 16-wide K slab at a time.  Every thread decodes the 16 weights for
        // its output lane once, then all 16 columns consume that shared f16 slab.
        for (uint t = 0u; t < 8u; ++t) {
            const uint ot   = ob * 8u + (tid >> 4u);
            const uint tcol = tid & 15u;
            const uint colbase = tcol & 7u;
            const uint lhi     = ((colbase >> 1u) << 3u) | ((colbase & 1u) << 2u);
            const uint c0      = (tcol >= 8u) ? 0u : 4u;
            const uint it      = ib * 8u + t;
            const uint base    = (it * p.Tout + ot) * TILE_U32S;

            [[unroll]] for (uint b = 0u; b < 4u; ++b) {
                const uint lane = lhi + b;
#if ESCHA_K == 2
                const uint pw   = (lane >> 1u) & 15u;
                const uint qw   = (pw + 15u) & 15u;
                const uint word = shr64_32(data_a[base + pw], data_a[base + qw], ((lane & 1u) == 0u) ? 16u : 0u);
                [[unroll]] for (uint k = 0u; k < 4u; ++k) {
                    const uint c   = c0 + k;
                    const uint row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
                    cm_weight[tid * 16u + row] = float16_t(escha_F((word >> (2u*c)) & 0xFFFFu));
                }
#else
                const uint tt   = 24u * lane;
                const uint aa   = tt + 755u;
                const uint bb   = tt + 791u;
                const uint sh0  = ((bb & 2016u) - tt) - 760u;
                const uint hw   = (lane == 0u) ? 23u : ((aa >> 5u) - 24u);
                const uint lw   = (((bb >> 3u) & 252u) - 96u) >> 2u;
                const uint zlo  = data_a[base + lw];
                const uint zhi  = data_a[base + hw];
                const uint pp   = shr64_32(zlo, zhi, sh0);
                const uint rr   = shr64_32(zlo, zhi, sh0 + 12u);
                [[unroll]] for (uint k = 0u; k < 4u; ++k) {
                    const uint c   = c0 + k;
                    const uint row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
                    const uint win = (c < 4u) ? (pp >> (3u*c)) : (rr >> (3u*(c - 4u)));
                    cm_weight[tid * 16u + row] = float16_t(escha_F(win & 0xFFFFu));
                }
#endif
            }

            // Pack the f32 Hadamard output to the f16 operand required by KHR
            // coopmat.  Ragged C=16 blocks duplicate their last valid column,
            // exactly like the scalar ladder, and the final store remains guarded.
            [[unroll]] for (uint i = tid; i < 256u; i += 128u) {
                const uint row = i >> 4u;
                const uint cj  = i & 15u;
                cm_input[i] = float16_t(ESCHA_SH_LOAD(sh[0][cj][t * 16u + row]));
            }
            barrier();

            [[unroll]] for (uint ct = 0u; ct < 4u; ++ct) {
                if (ct < tiles_per_subgroup) {
                    coopMatLoad(mat_a, cm_weight, (subgroup_tile_base + ct) * 16u * 16u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                    coopMatLoad(mat_b, cm_input, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                    sums[ct] = coopMatMulAdd(mat_a, mat_b, sums[ct]);
                }
            }
            barrier(); // both subgroups finished reading the staged K slab
        }
    }

    [[unroll]] for (uint ct = 0u; ct < 4u; ++ct) {
        if (ct < tiles_per_subgroup) {
            coopMatStore(sums[ct], cm_output, (subgroup_tile_base + ct) * 16u, 128u, gl_CooperativeMatrixLayoutColumnMajor);
        }
    }
    barrier();

    [[unroll]] for (uint cj = 0u; cj < 16u; ++cj) {
        sh[0][cj][tid] = ESCHA_SH_STORE(cm_output[cj * 128u + tid]);
    }
    barrier();
    hadamard128(0u, tid);

    const uint  oc   = ob * 128u + tid;
    const float rout = data_c[p.n_in + oc];
    const float bias = data_c[p.n_in + p.n_out + oc];
    [[unroll]] for (uint cj = 0u; cj < 16u; ++cj) {
        const uint cc = col0 + cj;
        if (cc < p.ncols) {
            data_d[cc * p.n_out + oc] = ESCHA_SH_LOAD(sh[0][cj][tid]) * (INV_SQRT128 * INV_SQRT128) * rout + bias;
        }
    }
}
#else
void main() {
    const uint hb   = gl_LocalInvocationID.x >> 7u;          // which output block within the group
    const uint tid  = gl_LocalInvocationID.x & 127u;         // thread within that block
    const uint ob   = gl_WorkGroupID.x * NB + hb;            // output 128-block
    const uint col0 = p.col_offset + gl_WorkGroupID.y * NC; // first column of this block
    const uint ot   = ob * 8u + (tid >> 4u); // this thread's out tile
    const uint tcol = tid & 15u;             // column within the tile

    // lanes serving this tile column (Terra-64 scatter, inverted for a fixed col)
    const uint colbase = tcol & 7u;
    const uint lhi     = ((colbase >> 1u) << 3u) | ((colbase & 1u) << 2u);
    // col >= 8 was produced by components c in 0..3; col < 8 by c in 4..7
    const uint c0      = (tcol >= 8u) ? 0u : 4u;

    float acc[NC];
    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
        acc[cj] = 0.0;
    }

    const uint n_ib = p.n_in / 128u;
    for (uint ib = 0u; ib < n_ib; ++ib) {
        const uint  gi  = ib * 128u + tid;
        const float rin = data_c[gi];
        [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
            // clamp the tail: those lanes recompute a duplicate column that is never stored
            const uint cc = min(col0 + cj, p.ncols - 1u);
            sh[hb][cj][tid] = ESCHA_SH_STORE(data_b[cc * p.n_in + gi] * rin);
        }
        barrier();
        hadamard128(hb, tid);
        // fold the input-side 1/sqrt(128): sh is read-only below, scale at use

        for (uint t = 0u; t < 8u; ++t) {
            const uint it   = ib * 8u + t;
            const uint base = (it * p.Tout + ot) * TILE_U32S;

            [[unroll]] for (uint b = 0u; b < 4u; ++b) {
                const uint lane = lhi + b;
#if ESCHA_K == 2
                // lane windows a 32-bit suffix of a 64-bit pair, not one u16
                const uint pw   = (lane >> 1u) & 15u;
                const uint qw   = (pw + 15u) & 15u;
                const uint word = shr64_32(data_a[base + pw], data_a[base + qw], ((lane & 1u) == 0u) ? 16u : 0u);
#if ESCHA_F16_PAIR
                [[unroll]] for (uint kp = 0u; kp < 2u; ++kp) {
                    const uint ca  = c0 + 2u*kp;
                    const uint cb  = ca + 1u;
                    const uint rowa = 2u*b + (1u - (ca & 1u)) + 8u*(1u - ((ca >> 1u) & 1u));
                    const uint rowb = 2u*b + (1u - (cb & 1u)) + 8u*(1u - ((cb >> 1u) & 1u));
                    const vec2 ww  = escha_F2((word >> (2u*ca)) & 0xFFFFu,
                                              (word >> (2u*cb)) & 0xFFFFu);
                    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
                        acc[cj] += ESCHA_SH_LOAD(sh[hb][cj][t*16u + rowa]) * ww.x
                                 + ESCHA_SH_LOAD(sh[hb][cj][t*16u + rowb]) * ww.y;
                    }
                }
#else
                [[unroll]] for (uint k = 0u; k < 4u; ++k) {
                    const uint c   = c0 + k;
                    const uint  row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
                    const float w   = escha_F((word >> (2u*c)) & 0xFFFFu); // decoded ONCE for all NC columns
                    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
                        acc[cj] += ESCHA_SH_LOAD(sh[hb][cj][t*16u + row]) * w;
                    }
                }
#endif
#else
                // K=3 crossed 96-byte bitstream (PTX lines 2282-2312)
                const uint tt   = 24u * lane;
                const uint aa   = tt + 755u;
                const uint bb   = tt + 791u;
                const uint sh0  = ((bb & 2016u) - tt) - 760u;
                const uint hw   = (lane == 0u) ? 23u : ((aa >> 5u) - 24u);
                const uint lw   = (((bb >> 3u) & 252u) - 96u) >> 2u;
                const uint zlo  = data_a[base + lw];
                const uint zhi  = data_a[base + hw];
                const uint pp   = shr64_32(zlo, zhi, sh0);
                const uint rr   = shr64_32(zlo, zhi, sh0 + 12u);
                [[unroll]] for (uint k = 0u; k < 4u; ++k) {
                    const uint c   = c0 + k;
                    const uint row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
                    const uint  win = (c < 4u) ? (pp >> (3u*c)) : (rr >> (3u*(c - 4u)));
                    const float w   = escha_F(win & 0xFFFFu);              // decoded ONCE for all NC columns
                    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
                        acc[cj] += ESCHA_SH_LOAD(sh[hb][cj][t*16u + row]) * w;
                    }
                }
#endif
            }
        }
        barrier(); // all reads of sh done before the next block overwrites it
    }

    // output-side transform + scales + bias; both 1/sqrt(128) factors fold here
    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
        sh[hb][cj][tid] = ESCHA_SH_STORE(acc[cj]);
    }
    barrier();
    hadamard128(hb, tid);
    const uint  oc   = ob * 128u + tid;
    const float rout = data_c[p.n_in + oc];
    const float bias = data_c[p.n_in + p.n_out + oc];
    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
        const uint cc = col0 + cj;
        if (cc < p.ncols) {   // tail guard: never store outside the real column range
            data_d[cc * p.n_out + oc] = ESCHA_SH_LOAD(sh[hb][cj][tid]) * (INV_SQRT128 * INV_SQRT128) * rout + bias;
        }
    }
}
#endif // ESCHA_COOPMAT
