#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// S-X8 v4.3 (MarlaLabs, type-id 57) mat-vec -- the decode path, and the reason
// this lane exists: WI-1692 landed a CPU-only decoder, which is worthless on a
// box whose only compute device is the 780M.
//
// S-X8 is far simpler than the TQ family this file's shape is borrowed from.
// There is no rotation, so no butterfly, no shared memory and no barrier: the
// stored block already holds the weights, and decode is 32 independent
// per-weight expressions.
//
// lane-230 / R46: at NUM_COLS <= 3 one thread now owns one 32-weight BLOCK, not
// one weight POSITION; at NUM_COLS >= 4 the per-position kernel below is kept,
// because the block kernel's live state grows with the batch and spills there.
// See the n-GATE comment in compute_outputs() for the measured crossover.
// The old mapping gave each of 32 threads its own weight and made
// every one of them re-read the block header and re-evaluate sx8_range(), so a
// single block cost 96 header reads, 64 plane bytes and 32 range evaluations
// for 32 weights. Owning the whole block costs 3 header reads, 24 plane bytes
// and 4 range evaluations -- the same weight bytes, a fraction of the
// instructions. Threads stride whole blocks by BLOCK_SIZE, so any workgroup
// size is correct and a wave64 device stays fully occupied.
//
// A 16-bit view of qh/ql was evaluated and REJECTED: qh starts at byte 5 of the
// 30-byte block (2 + 2 + 1 header), an ODD offset, so a uint16 array over it
// cannot align to the 4-element groups the packing is built from. Byte reads
// move the same cache lines anyway; only the instruction count mattered here.
//
// reduce_result() sums across the whole workgroup, so partials from different
// blocks land in the same accumulator -- which is exactly what a dot product
// over the row wants.
//
// Decode reference: dequantize_row_sx8() in ggml/src/ggml-quants.c. The scalars
// live in sx8_range() (types.glsl) so this shader and dequant_sx8.comp cannot
// drift apart from each other; both still mirror the C by hand, which is the
// F-110 hazard the lane PREREG's planted-RED recipe checks. sx8_levels4() lives
// beside it for the same reason.

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            temp[j][n] = FLOAT_TYPE(0);
        }
    }

    const uint num_blocks_per_row = p.ncols / 32u;

    // n-GATE. NUM_COLS is specialization constant 2, fixed per pipeline at
    // creation (ggml-vulkan.cpp ~5665/5704 pass i+1), so this branch is folded
    // away by the driver's specialization pass and only ONE path is ever
    // register-allocated. Measured on the 27B shapes, 3 paired rounds: whole-block
    // decode wins at n=1..3 on every shape (FFN gate/up +13.0 / +8.0 / +5.7%,
    // FFN down +7.1 / +3.8 / +1.8%, embd/output +35 / +46 / +41%). At n=4 it is
    // already MIXED and loses on three of four shapes (legacy -6.6%, FFN down
    // -5.6%, FFN gate/up +2.2%, embd/output +19%), and at n>=5 the two kernels
    // are within +/-3%. The live weight state per block scales with NUM_COLS and
    // starts spilling, which is why the win decays with the batch. The gate is
    // therefore set at n <= 3 -- the range where the block kernel wins on EVERY
    // shape -- and n >= 4 keeps the per-position kernel.
    if (NUM_COLS <= 3) {
        for (uint blk = tid; blk < num_blocks_per_row; blk += BLOCK_SIZE) {
            // Block header, read ONCE per row for the whole block.
            float dlo[NUM_ROWS];
            float dhi[NUM_ROWS];
            uint  cfg[NUM_ROWS];
            [[unroll]] for (uint n = 0; n < num_rows; ++n) {
                const uint ib = a_offset + (first_row + n) * num_blocks_per_row + blk;
                dlo[n] = float(data_a[ib].dmin);
                dhi[n] = float(data_a[ib].dmax);
                cfg[n] = uint(data_a[ib].config);
            }

            const uint b_base = b_offset + blk * 32u;

            // One sub-block of 8 weights at a time: one range strategy, one pair
            // of 4-element groups.
            //
            // Only ONE activation per column is ever live. Caching eight per
            // column was measured and REVERTED: at NUM_COLS 8 that array is 64
            // floats on top of the accumulators, and the spill cost -45% at n=5
            // rising to -77% at n=8 while n=1..3 still gained. The weight decode
            // is what this change is for; the activations must stay as cheap as
            // they were.
            [[unroll]] for (uint sb = 0; sb < 4u; ++sb) {
                float rlo[NUM_ROWS];
                float step[NUM_ROWS];
                [[unroll]] for (uint n = 0; n < num_rows; ++n) {
                    sx8_range(dlo[n], dhi[n], (cfg[n] >> (sb * 2u)) & 3u, rlo[n], step[n]);
                }

                [[unroll]] for (uint g = 0; g < 2u; ++g) {
                    uint levels[NUM_ROWS];
                    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
                        const uint ib = a_offset + (first_row + n) * num_blocks_per_row + blk;
                        const uint qh_pair = uint(data_a[ib].qh[sb * 4u + g * 2u])
                                           | (uint(data_a[ib].qh[sb * 4u + g * 2u + 1u]) << 8u);
                        levels[n] = sx8_levels4(qh_pair, uint(data_a[ib].ql[sb * 2u + g]));
                    }

                    [[unroll]] for (uint e = 0; e < 4u; ++e) {
                        float bv[NUM_COLS];
                        [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
                            bv[c] = float(data_b[c * p.batch_stride_b + b_base + sb * 8u + g * 4u + e]);
                        }

                        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
                            const float w = rlo[n] + step[n] * float((levels[n] >> (e * 8u)) & 0xFFu);
                            [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
                                temp[c][n] += FLOAT_TYPE(w * bv[c]);
                            }
                        }
                    }
                }
            }
        }
    } else {
        // Per-position decode (the pre-R46 kernel), kept verbatim for n >= 4.
        // One thread owns one weight POSITION and re-reads the block header, so
        // the instruction count per block is high -- but the live state per
        // thread does not grow with NUM_COLS, which is what matters once the
        // batch is wide.
        //
        // Constant for this thread: which sub-block of 8 it sits in, and where
        // its 4 high bits and 2 low bits live. The low bits are stored
        // BIG-endian within their byte -- (3 - (j & 3)) -- which is the one
        // packing detail worth re-reading against the C before trusting a
        // number out of this kernel.
        const uint elem     = tid & 31u;          // weight position inside a block
        const uint blk_base = tid >> 5u;          // which block this thread starts on
        const uint blk_step = BLOCK_SIZE >> 5u;   // blocks covered per iteration

        const uint sb       = elem >> 3u;
        const uint qh_byte  = elem >> 1u;
        const uint qh_shift = (elem & 1u) * 4u;
        const uint ql_byte  = elem >> 2u;
        const uint ql_shift = (3u - (elem & 3u)) * 2u;

        for (uint blk = blk_base; blk < num_blocks_per_row; blk += blk_step) {
            // Activation for this thread's weight position, one per column.
            float bv[NUM_COLS];
            [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
                bv[c] = float(data_b[c * p.batch_stride_b + b_offset + blk * 32u + elem]);
            }

            [[unroll]] for (uint n = 0; n < num_rows; ++n) {
                const uint ib = a_offset + (first_row + n) * num_blocks_per_row + blk;

                float rlo, step;
                sx8_range(float(data_a[ib].dmin), float(data_a[ib].dmax),
                          (uint(data_a[ib].config) >> (sb * 2u)) & 3u, rlo, step);

                const uint hi = (uint(data_a[ib].qh[qh_byte]) >> qh_shift) & 0xFu;
                const uint lo = (uint(data_a[ib].ql[ql_byte]) >> ql_shift) & 0x3u;
                const float w = rlo + step * float((hi << 2u) | lo);

                [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
                    temp[c][n] += FLOAT_TYPE(w * bv[c]);
                }
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
