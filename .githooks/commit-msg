#!/bin/sh
# Reject a commit whose provenance trailers are present but not machine-readable.
#
# git ends a trailer block at the first line that is not trailer-shaped, so an unindented
# continuation line invalidates EVERY trailer in the block while still reading correctly to a
# human. That failure is silent, which is the whole reason this hook exists.
#
# Enable with:  git config core.hooksPath .githooks
# Rationale and examples: CONTRIBUTING/COMMIT-TRAILERS.md

msg_file="$1"

# Merge, fixup, squash and revert messages are generated; leave them alone.
head -n1 "$msg_file" | grep -qE '^(Merge|fixup!|squash!|Revert)' && exit 0

has_token=0
for key in Taken-from Origin Measured-effect; do
    if grep -qE "^[[:space:]]*${key}:" "$msg_file"; then
        has_token=1
    fi
done

# Nothing claimed - nothing to verify. provenance --strict is what enforces presence.
[ "$has_token" -eq 0 ] && exit 0

parsed=$(git interpret-trailers --parse <"$msg_file" 2>/dev/null)

missing=""
for key in Taken-from Origin Measured-effect; do
    if grep -qE "^[[:space:]]*${key}:" "$msg_file"; then
        printf '%s\n' "$parsed" | grep -qE "^${key}:" || missing="$missing $key"
    fi
done

if [ -n "$missing" ]; then
    cat >&2 <<EOF

commit-msg: provenance trailer(s) present but NOT machine-readable:$missing

git ends the trailer block at the first line that is not trailer-shaped. A continuation
line starting in column 0 invalidates every trailer in the block, including the ones
above it - the message still reads fine, which is why this is easy to miss.

  WRONG                                RIGHT
  Measured-effect: 12.5 tok/s on the   Measured-effect: 12.5 tok/s on the
  reference machine, 3 rolls.            reference machine, 3 rolls.

Indent continuation lines by at least one space, and keep the trailer block as the LAST
paragraph of the message. Details: CONTRIBUTING/COMMIT-TRAILERS.md

EOF
    exit 1
fi

exit 0
