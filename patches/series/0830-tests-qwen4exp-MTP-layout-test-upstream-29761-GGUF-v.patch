From 251a7e02fd0e8d1df794ac6d52ebc684b20c4b33 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Fri, 9 Oct 2026 16:17:56 -0400
Subject: [PATCH] tests: qwen4exp MTP layout test - upstream #29761 GGUF vs our
 sidecar of the same weights

gen-qwen4exp-mtp-layout.py turns a random qwen4exp trunk (test-llama-archs -a qwen4exp -o <dir>) into four files
with one MTP block at blk.2: our sidecar (output_hc_* = the block's own mixer M), a control sidecar carrying the
trunk mixer T, an upstream full file (trunk + output_hc_* = T + blk.2.nextn.hc_head_* = M + the block's QSA
indexer tensors), and an upstream MTP-only file (no trunk, no output_hc_*, no PLE keys, as upstream's converter
writes it). test-qwen4exp-mtp-layout runs one MTP pass (4 tokens + fixed random h) on each through the public API
(ctx_type MTP, batch with token and embd) and requires the upstream files to give the sidecar's ids, max|d| < 1e-4.
The control must differ (max|d| >= 1e-3), so a graph that takes the trunk mixer fails the test.
Expected on 7156c61607: both upstream files fail to load (unknown blk.2.nextn.hc_head_* and indexer tensors).

Test for the dual-layout loader row (HQ84 2026-10-07 19:5x, QUESTIONS Q12).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Origin: upstream-x1 (P26 test, source a92c9d4d37; joined to the v0132 re-pick by HQ86 2026-10-09 12:32)
Measured-effect: UNMEASURED (test-only; asserts upstream #29761 MTP files give the sidecar ids, max|d| < 1e-4, and the trunk-mixer control fails)
---
 tests/CMakeLists.txt               |   1 +
 tests/gen-qwen4exp-mtp-layout.py   |  86 +++++++++++++++++
 tests/test-qwen4exp-mtp-layout.cpp | 149 +++++++++++++++++++++++++++++
 3 files changed, 236 insertions(+)
 create mode 100644 tests/gen-qwen4exp-mtp-layout.py
 create mode 100644 tests/test-qwen4exp-mtp-layout.cpp

diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 2e8b42e62b..ffd2186cb4 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -200,6 +200,7 @@ if (NOT WIN32 OR NOT BUILD_SHARED_LIBS)
 
     llama_build(test-llama-archs.cpp)
     llama_build(test-spec-accept-eog.cpp) # needs a model: test-llama-archs -a "^llama$" -o <dir>
+    llama_build(test-qwen4exp-mtp-layout.cpp) # needs files: gen-qwen4exp-mtp-layout.py <qwen4exp-moe.gguf> <dir>
 
     # Ternary repack kernels. No model can reach the _generic variants (the dispatch gates Q2_0 and
     # Q2_0_G128 on AVX512-VNNI only), so they are called directly here.
diff --git a/tests/gen-qwen4exp-mtp-layout.py b/tests/gen-qwen4exp-mtp-layout.py
new file mode 100644
index 0000000000..d1e9746d3a
--- /dev/null
+++ b/tests/gen-qwen4exp-mtp-layout.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+# Writes the qwen4exp MTP layout files that test-qwen4exp-mtp-layout compares, from a random trunk written by
+# `test-llama-archs -a qwen4exp -o <dir>` (qwen4exp-moe.gguf, 2 layers, layer 1 = attention).
+#   ours-sidecar.gguf   : our sidecar - no trunk, MTP block at blk.2, output_hc_* = the MTP block's own mixer M
+#   ours-wrongmix.gguf  : the same sidecar with output_hc_* = the trunk mixer T (control: logits must differ)
+#   up-full.gguf        : upstream #29761 layout - trunk + output_hc_* = T + MTP block + blk.2.nextn.hc_head_* = M
+#                         + the block's QSA indexer tensors (our dense MTP drops them)
+#   up-mtponly.gguf     : upstream mtp_only layout - no trunk, no output_hc_*, no PLE keys/table, nextn.hc_head_* = M
+# usage: gen-qwen4exp-mtp-layout.py <qwen4exp-moe.gguf> <out dir>
+import os
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "gguf-py"))
+from gguf import GGUFReader, GGUFWriter, GGUFValueType  # noqa: E402
+
+src, out = sys.argv[1], sys.argv[2]
+r = GGUFReader(src)
+A = "qwen4exp"
+n_layer = int(r.fields[f"{A}.block_count"].contents())
+mtp = n_layer  # MTP block index
+rng = np.random.default_rng(29761)
+
+
+def rand(ne):  # ggml ne order -> numpy (reversed) shape
+    return (rng.standard_normal(tuple(reversed(ne))) * 0.1).astype(np.float32)
+
+
+tensors = {t.name: np.array(t.data) for t in r.tensors}
+shape = {t.name: [int(x) for x in t.shape] for t in r.tensors}
+
+n_embd = shape["token_embd.weight"][0]
+hc_dim = shape["output_hc_down.weight"][0]
+T = {k: tensors[f"output_hc_{k}.weight"] for k in ("norm", "down", "up")}
+M = {k: rand(shape[f"output_hc_{k}.weight"]) for k in ("norm", "down", "up")}
+
+# the MTP block (ours): layer 1's attention block shape, fresh weights, plus the nextn inputs
+block = {}
+for name, ne in shape.items():
+    if name.startswith(f"blk.{n_layer - 1}.") and ".indexer." not in name:
+        block[f"blk.{mtp}." + name.split(".", 2)[2]] = rand(ne)
+block[f"blk.{mtp}.nextn.eh_proj.weight"] = rand([2 * n_embd, n_embd])
+block[f"blk.{mtp}.nextn.enorm.weight"] = rand([n_embd])
+block[f"blk.{mtp}.nextn.hnorm.weight"] = rand([hc_dim])  # upstream's converter writes it flat too
+indexer = {f"blk.{mtp}." + n.split(".", 2)[2]: rand(ne) for n, ne in shape.items()
+           if n.startswith(f"blk.{n_layer - 1}.indexer.")}
+
+
+def write(path, tens, drop_ple=False):
+    w = GGUFWriter(path, A)
+    for k, f in r.fields.items():
+        if k.startswith("GGUF.") or k == "general.architecture":
+            continue
+        if drop_ple and k.startswith(f"{A}.ple.") or (drop_ple and k == f"{A}.embedding_length_per_layer_input"):
+            continue
+        vt = f.types[0]
+        val = f.contents()
+        if vt == GGUFValueType.ARRAY and len(f.types) < 2:
+            continue  # empty array: gguf-py refuses to write one, and absent reads as empty
+        sub = f.types[1] if vt == GGUFValueType.ARRAY else None
+        if k == f"{A}.block_count":
+            val = n_layer + 1
+        elif k == f"{A}.nextn_predict_layers":
+            val = 1
+        elif vt == GGUFValueType.ARRAY and k.startswith(f"{A}.") and len(val) == n_layer:
+            val = list(val) + [0 if k.endswith("recurrent_layers") else val[-1]]  # MTP block = attention
+        w.add_key_value(k, val, vt, sub_type=sub)
+    for n, a in tens.items():
+        w.add_tensor(n, a)
+    w.write_header_to_file()
+    w.write_kv_data_to_file()
+    w.write_tensors_to_file()
+    w.close()
+    print("wrote", path, len(tens), "tensors")
+
+
+head = {"token_embd.weight": tensors["token_embd.weight"], "output.weight": tensors["output.weight"]}
+ple = {"per_layer_token_embd.weight": tensors["per_layer_token_embd.weight"]}
+mix = lambda m: {f"output_hc_{k}.weight": m[k] for k in m}  # noqa: E731
+nextn_mix = {f"blk.{mtp}.nextn.hc_head_{k}.weight": M[k] for k in M}
+
+write(os.path.join(out, "ours-sidecar.gguf"), {**head, **ple, **mix(M), **block})
+write(os.path.join(out, "ours-wrongmix.gguf"), {**head, **ple, **mix(T), **block})
+write(os.path.join(out, "up-full.gguf"), {**tensors, **block, **nextn_mix, **indexer})
+write(os.path.join(out, "up-mtponly.gguf"), {**head, **block, **nextn_mix, **indexer}, drop_ple=True)
diff --git a/tests/test-qwen4exp-mtp-layout.cpp b/tests/test-qwen4exp-mtp-layout.cpp
new file mode 100644
index 0000000000..a138948a52
--- /dev/null
+++ b/tests/test-qwen4exp-mtp-layout.cpp
@@ -0,0 +1,149 @@
+// qwen4exp MTP: an upstream-layout GGUF (#29761: blk.N.nextn.hc_head_* mixer, QSA indexer tensors in the MTP block,
+// optional MTP-only file without the trunk mixer or PLE) must draft the same ids as our sidecar of the same weights.
+// Files: tests/gen-qwen4exp-mtp-layout.py <qwen4exp-moe.gguf from test-llama-archs -o> <dir>.
+// ours-wrongmix (sidecar carrying the TRUNK mixer) is the control: its logits must differ, or the test cannot see
+// a graph that picks the wrong mixer.
+// usage: test-qwen4exp-mtp-layout <dir> [n_gpu_layers]
+
+#include "llama.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static const int N_TOK = 4;
+
+// one MTP pass over N_TOK (token, h) pairs; empty on load/decode failure
+static std::vector<float> run(const std::string & path, int ngl, int & n_vocab) {
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = ngl;
+    mparams.load_mtp     = true;
+    llama_model * model = llama_model_load_from_file(path.c_str(), mparams);
+    if (!model) {
+        fprintf(stderr, "  load FAILED: %s\n", path.c_str());
+        return {};
+    }
+    n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    const int n_h = llama_model_n_embd_out(model);
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx    = 64;
+    cparams.n_batch  = 64;
+    cparams.n_ubatch = 64;
+    cparams.ctx_type = LLAMA_CONTEXT_TYPE_MTP;
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (!ctx) {
+        fprintf(stderr, "  context FAILED: %s\n", path.c_str());
+        llama_model_free(model);
+        return {};
+    }
+
+    llama_batch batch = llama_batch_init(N_TOK, n_h, 1);
+    batch.token = (llama_token *) malloc(sizeof(llama_token) * N_TOK); // MTP reads token AND h (speculative.cpp)
+    std::mt19937 rng(29761);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    for (int i = 0; i < N_TOK; ++i) {
+        batch.token[i]     = 1 + 3 * i;
+        batch.pos[i]       = i;
+        batch.n_seq_id[i]  = 1;
+        batch.seq_id[i][0] = 0;
+        batch.logits[i]    = 1;
+        for (int j = 0; j < n_h; ++j) {
+            batch.embd[(size_t) i * n_h + j] = nd(rng);
+        }
+    }
+    batch.n_tokens = N_TOK;
+
+    std::vector<float> out;
+    if (llama_decode(ctx, batch) == 0) {
+        for (int i = 0; i < N_TOK; ++i) {
+            const float * l = llama_get_logits_ith(ctx, i);
+            out.insert(out.end(), l, l + n_vocab);
+        }
+    } else {
+        fprintf(stderr, "  decode FAILED: %s\n", path.c_str());
+    }
+
+    llama_batch_free(batch); // frees token too
+    llama_free(ctx);
+    llama_model_free(model);
+    return out;
+}
+
+static std::vector<int> argmax_rows(const std::vector<float> & l, int n_vocab) {
+    std::vector<int> ids;
+    for (int i = 0; i < N_TOK; ++i) {
+        int best = 0;
+        for (int t = 1; t < n_vocab; ++t) {
+            if (l[(size_t) i * n_vocab + t] > l[(size_t) i * n_vocab + best]) {
+                best = t;
+            }
+        }
+        ids.push_back(best);
+    }
+    return ids;
+}
+
+static float max_abs_diff(const std::vector<float> & a, const std::vector<float> & b) {
+    float d = 0.0f;
+    for (size_t i = 0; i < a.size(); ++i) {
+        d = std::fmax(d, std::fabs(a[i] - b[i]));
+    }
+    return d;
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 2) {
+        fprintf(stderr, "usage: %s <dir with gen-qwen4exp-mtp-layout.py output> [n_gpu_layers]\n", argv[0]);
+        return 2;
+    }
+    const std::string dir = argv[1];
+    const int ngl = argc > 2 ? atoi(argv[2]) : 0;
+
+    llama_backend_init();
+
+    int nv_ref = 0;
+    const std::vector<float> ref = run(dir + "/ours-sidecar.gguf", ngl, nv_ref);
+    if (ref.empty()) {
+        fprintf(stderr, "FAIL: reference sidecar did not run (test setup)\n");
+        return 1;
+    }
+    const std::vector<int> ids_ref = argmax_rows(ref, nv_ref);
+
+    int n_fail = 0;
+
+    int nv = 0;
+    const std::vector<float> wrong = run(dir + "/ours-wrongmix.gguf", ngl, nv);
+    const float d_wrong = wrong.size() == ref.size() ? max_abs_diff(ref, wrong) : -1.0f;
+    if (d_wrong < 1e-3f) {
+        fprintf(stderr, "FAIL: control ours-wrongmix max|d|=%g - the mixer does not reach the logits (test setup)\n", d_wrong);
+        n_fail++;
+    } else {
+        fprintf(stderr, "OK control ours-wrongmix differs, max|d|=%g\n", d_wrong);
+    }
+
+    for (const char * f : { "up-full.gguf", "up-mtponly.gguf" }) {
+        const std::vector<float> got = run(dir + "/" + f, ngl, nv);
+        if (got.size() != ref.size()) {
+            fprintf(stderr, "FAIL: %s did not load or decode\n", f);
+            n_fail++;
+            continue;
+        }
+        const std::vector<int> ids = argmax_rows(got, nv);
+        const float d = max_abs_diff(ref, got);
+        const bool same = ids == ids_ref;
+        fprintf(stderr, "%s: %s ids [%d %d %d %d] vs sidecar [%d %d %d %d], max|d|=%g\n", same && d < 1e-4f ? "OK" : "FAIL", f,
+                ids[0], ids[1], ids[2], ids[3], ids_ref[0], ids_ref[1], ids_ref[2], ids_ref[3], d);
+        if (!same || d >= 1e-4f) {
+            n_fail++;
+        }
+    }
+
+    llama_backend_free();
+    fprintf(stderr, "%s\n", n_fail ? "RESULT FAIL" : "RESULT PASS");
+    return n_fail ? 1 : 0;
+}
