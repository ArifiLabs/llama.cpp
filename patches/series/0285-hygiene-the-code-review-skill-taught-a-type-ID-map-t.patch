From 2d2ce6316ca8ed2ab68860a7697863af6515ebc9 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 17 Aug 2026 02:11:59 -0400
Subject: [PATCH] hygiene: the code-review skill taught a type-ID map the
 arbitration deleted, and the UI was fetched from a moving tag

skills/code-review/SKILL.md:148 still taught TURBO2_0=43 / TURBO3_0=44 / TURBO4_0=47 and
'new fork types go after 47' - the exact collision docs/TYPE-ID-ALLOCATION.md removed. It was
also wrong about the doctrine, not only the integers: it called the turbo KV types 'baked into
GGUF files' when neither fork's gguf-py can emit them. The rewrite splits serialized-weight
from runtime-only, names the contract doc as the authority, and enumerates no id at 48+ so a
new allocation cannot re-stale it.

The 08-16 build asked HF for tag b10763, got an HTTP error, and fell back to the moving tag
'latest' - two clean rebuilds embed two different UIs. dist.tar.gz (3,080,618 B, sha256
9510a125..d57d) is now vendored and checksum-gated in tools/ui/CMakeLists.txt, extracted into
the priority-1 path so the download is never reached. Proof: 'UI: using pre-built assets from
.../tools/ui/dist' with zero 'UI: downloading from' lines.
---
 skills/code-review/SKILL.md |   6 +++++-
 tools/ui/CMakeLists.txt     |  25 +++++++++++++++++++++++++
 tools/ui/dist.tar.gz        | Bin 0 -> 3080618 bytes
 tools/ui/dist.tar.gz.sha256 |   1 +
 4 files changed, 31 insertions(+), 1 deletion(-)
 create mode 100644 tools/ui/dist.tar.gz
 create mode 100644 tools/ui/dist.tar.gz.sha256

diff --git a/skills/code-review/SKILL.md b/skills/code-review/SKILL.md
index 5860bdbd1..b646b2e11 100644
--- a/skills/code-review/SKILL.md
+++ b/skills/code-review/SKILL.md
@@ -145,7 +145,11 @@ Enforce the `AGENTS.md` / `CONTRIBUTING.md` coding and naming guidelines on ever
 
 Run this in addition to the General checklist whenever the diff touches turbo code, and instead of the upstream-facing gates where they conflict. The AGENTS.md "Known pitfalls" list is the regression checklist - each entry there cost a real bug; verify the diff doesn't disturb those invariants.
 
-- **Type/enum stability:** `GGML_TYPE_TURBO2_0=43, TURBO3_0=44, TQ3_1S=45, TQ4_1S=46, TURBO4_0=47` and `GGML_OP_TURBO_WHT` are baked into GGUF files and cross-backend dispatch - never renumber, reorder, or repurpose. New fork types go after 47.
+- **Type/enum stability:** `docs/TYPE-ID-ALLOCATION.md` is the authority for every `ggml_type` id this fork defines - read it before quoting or allocating a number. Two classes, two different rules:
+  - *Serialized weight types* land in GGUF files, so their ids belong to the format's originator and are adopted verbatim: `GGML_TYPE_Q2_0_G128=43` (ours), `TQ3_1S=45` and `TQ4_1S=46` (TurboQuant), ROCmFPX 100-104 and 107. Never renumber, reorder or repurpose one - files on disk carry the number.
+  - *Runtime-only types* (KV-cache codecs, repack/scratch layouts) are never written to a GGUF and live in the ArifiLabs block **200-255**: `GGML_TYPE_TURBO2_0=200, TURBO3_0=201, TURBO4_0=202`. They are still persisted to session-state files, but the read path is fail-closed on both the type id and the row size (`src/llama-kv-cache.cpp:2354-2372`), so a renumber is refused rather than silently misread.
+  - `GGML_TYPE_COUNT` is **256**, the block-R ceiling. A diff that quotes an id absent from the allocation table, or adds an id without editing that table in the same commit, is a blocking finding.
+  - `GGML_OP_TURBO_WHT` is baked into cross-backend dispatch - never renumber, reorder or repurpose it.
 - **Codec fidelity:** `ggml/src/ggml-turbo-quant.c` must stay byte-identical to fork tip conventions; any change needs `test-turbo-quant` passing (turbo3 MSE=0/Cosine=1.0, turbo4 Cosine=0.9956) plus `test-quantize-fns` (TQ3_1S/TQ4_1S cases).
 - **Backend coverage matrix:** a change to turbo KV or TQ weight behavior must keep every backend in sync - CPU, CUDA/HIP, Metal, Vulkan, SYCL. The classic rebase regressions, in order: Metal `[[host_name]]` kernel instantiations dropped (NULL-pipeline deref), Vulkan SET_ROWS pipeline registration missing TURBO types or the `require_full_subgroups=true, subgroup_size=32` flags (abort), CUDA TQ exclusion from the mmvq path dropped (abort with `GGML_TQ_NATIVE=1`).
 - **CUDA TQ kernels:** no `__byte_perm` in centroid LUTs (`mmvq-tq.cu`) - plain shifts only; the permute chain silently produces garbage on some toolchains. MoE TQ `MUL_MAT_ID` must keep disabling CUDA graphs (stream sync requirement).
diff --git a/tools/ui/CMakeLists.txt b/tools/ui/CMakeLists.txt
index 208b46a5c..99122e0dc 100644
--- a/tools/ui/CMakeLists.txt
+++ b/tools/ui/CMakeLists.txt
@@ -33,6 +33,31 @@ if(NOT "${HF_UI_VERSION}" STREQUAL "" AND NOT HF_UI_VERSION MATCHES "^[A-Za-z0-9
     message(FATAL_ERROR "UI: invalid HF_UI_VERSION='${HF_UI_VERSION}' - must match ^[A-Za-z0-9._-]+$")
 endif()
 
+# fork: vendored UI archive. A clean rebuild must be repeatable and offline - the HF
+# fetch falls back to the moving tag "latest" whenever the build-number tag 404s, which
+# makes the embedded UI a different artifact on every rebuild. scripts/ui-assets.cmake
+# takes pre-built assets in tools/ui/dist as priority 1, ahead of npm and of any
+# download, so extracting the pinned archive here leaves the network path unreachable.
+set(LLAMA_UI_VENDORED_ARCHIVE "${CMAKE_CURRENT_SOURCE_DIR}/dist.tar.gz")
+if(EXISTS "${LLAMA_UI_VENDORED_ARCHIVE}" AND NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/dist/index.html")
+    if(NOT EXISTS "${LLAMA_UI_VENDORED_ARCHIVE}.sha256")
+        message(FATAL_ERROR "UI: ${LLAMA_UI_VENDORED_ARCHIVE} has no .sha256 - an unpinned vendored archive is not a pin")
+    endif()
+    file(READ "${LLAMA_UI_VENDORED_ARCHIVE}.sha256" _ui_expected)
+    string(REGEX MATCH "^[0-9a-fA-F]+" _ui_expected "${_ui_expected}")
+    string(TOLOWER "${_ui_expected}" _ui_expected)
+    file(SHA256 "${LLAMA_UI_VENDORED_ARCHIVE}" _ui_actual)
+    if(NOT "${_ui_actual}" STREQUAL "${_ui_expected}")
+        message(FATAL_ERROR "UI: vendored dist.tar.gz checksum mismatch - expected ${_ui_expected}, got ${_ui_actual}")
+    endif()
+    file(REMOVE_RECURSE "${CMAKE_CURRENT_SOURCE_DIR}/dist")
+    file(ARCHIVE_EXTRACT INPUT "${LLAMA_UI_VENDORED_ARCHIVE}" DESTINATION "${CMAKE_CURRENT_SOURCE_DIR}/dist")
+    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/dist/index.html")
+        message(FATAL_ERROR "UI: vendored dist.tar.gz extracted without index.html")
+    endif()
+    message(STATUS "UI: extracted vendored dist.tar.gz (sha256 ${_ui_actual})")
+endif()
+
 set(UI_CPP "${CMAKE_CURRENT_BINARY_DIR}/ui.cpp")
 set(UI_H   "${CMAKE_CURRENT_BINARY_DIR}/ui.h")
 
