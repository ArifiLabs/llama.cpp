From a84fc2d49554e545c7e3a272ec1048ae4fb5cc42 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Wed, 7 Oct 2026 13:33:34 -0400
Subject: [PATCH] tests: matmul -> wide soft_max -> matmul on the same input
 (prealloc_y reuse, RED before #29591)

Upstream #29591 describes this case in its PR text but the squash merge dropped the
test. Written from the PR description: the second weight is a cpy of the soft_max
output, so the second matmul cannot be scheduled before the soft_max that overwrites
the converted-input cache. q4_0/q8_0 weights, n 1 (mat-vec) and 32 (matrix).

Taken-from: ggml-org/llama.cpp@806eee9841 (#29591, test from PR text, not merged upstream)
Origin: upstream-x1 lane PORT-SPEC P2
Measured-effect: UNMEASURED (test only; RED/GREEN in MERGE-READY.md row P2)
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/test-backend-ops.cpp | 43 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 350987d899..b22405812f 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -6792,6 +6792,44 @@ struct test_soft_max : public test_case {
     }
 };
 
+// matmul, then a wide soft_max (ncols > 16384) that writes its partials into the matmul input cache,
+// then a second matmul on the same input whose weight depends on the soft_max (upstream #29591)
+struct test_mul_mat_prealloc_reuse : public test_case {
+    const ggml_type type_a;
+    const int64_t m, n, k;
+
+    std::string vars() override {
+        return VARS_TO_STR4(type_a, m, n, k);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "MUL_MAT_PREALLOC_REUSE";
+    }
+
+    test_mul_mat_prealloc_reuse(ggml_type type_a = GGML_TYPE_Q4_0, int64_t m = 64, int64_t n = 32, int64_t k = 256)
+        : type_a(type_a), m(m), n(n), k(k) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a1 = ggml_new_tensor_2d(ctx, type_a, k, m);
+        ggml_tensor * b  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_tensor * x  = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 20000);
+        ggml_tensor * a2 = ggml_new_tensor_2d(ctx, type_a, k, m);
+        ggml_set_name(a1, "a1");
+        ggml_set_name(b, "b");
+        ggml_set_name(x, "x");
+
+        ggml_tensor * y1 = ggml_mul_mat(ctx, a1, b);
+        ggml_tensor * s  = ggml_scale(ctx, ggml_soft_max(ctx, x), 20000.0f);
+        ggml_tensor * w2 = ggml_cpy(ctx, ggml_reshape_2d(ctx, ggml_view_1d(ctx, s, k*m, 0), k, m), a2);
+        ggml_tensor * y2 = ggml_mul_mat(ctx, w2, b);
+
+        ggml_tensor * out = ggml_add(ctx, y1, y2);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
+
 // GGML_OP_SOFT_MAX_BACK
 struct test_soft_max_back : public test_case {
     const ggml_type type;
@@ -12052,6 +12090,11 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_soft_max(GGML_TYPE_F32, {16, 2, 32, 1}, true,  false, GGML_TYPE_F16, {1, 1}, 0.1f, 0.0f));
     test_cases.emplace_back(new test_soft_max(GGML_TYPE_F32, {16, 2, 32, 1}, false, true,  GGML_TYPE_F32, {1, 1}, 0.1f, 0.0f));
     test_cases.emplace_back(new test_soft_max(GGML_TYPE_F32, {32, 2, 32, 1}, true,  true,  GGML_TYPE_F32, {1, 1}, 0.1f, 0.0f));
+    for (ggml_type t : {GGML_TYPE_Q4_0, GGML_TYPE_Q8_0}) {
+        for (int64_t n : {1, 32}) {
+            test_cases.emplace_back(new test_mul_mat_prealloc_reuse(t, 64, n, 256));
+        }
+    }
     test_cases.emplace_back(new test_soft_max(GGML_TYPE_F32, {32, 2, 32, 1}, true,  false, GGML_TYPE_F16, {1, 1}, 0.1f, 0.0f));
     test_cases.emplace_back(new test_soft_max(GGML_TYPE_F32, {32, 2, 32, 1}, true,  true,  GGML_TYPE_F32, {1, 1}, 0.1f, 8.0f));
     test_cases.emplace_back(new test_soft_max(GGML_TYPE_F32, {32, 2, 32, 1}, true,  true,  GGML_TYPE_F16, {1, 1}, 0.1f, 8.0f));
