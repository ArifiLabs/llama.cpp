+    r"^(unknown([ ._-]?operator)?|operator|someone|somebody|anonymous|nobody|none|n/?a|tbd|you|"
+    r"your[ ._-]?(name|address)|changeme|[^@]*@example\.(com|org|net|invalid))$", re.IGNORECASE)
