+def _commit_sha(repo: str, ref: str) -> str:
+    """The exact commit `ref` names right now, or "" if it names no commit."""
+    rc, out, _ = git(repo, "rev-parse", "--verify", "--quiet", "%s^{commit}" % ref, check=False)
+    return out.strip() if rc == 0 else ""
+
