+    for key in ("user.email", "user.name"):
+        rc, out, _ = git(repo, "config", "--get", key, check=False)
+        candidates.append(out.strip() if rc == 0 else "")
+    try:
+        candidates.append((getpass.getuser() or "").strip())
+    except Exception:
+        candidates.append("")
