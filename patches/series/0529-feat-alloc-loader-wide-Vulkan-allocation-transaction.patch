+    loader_plan_ptr plan(ggml_backend_alloc_plan_init());
+    GGML_ASSERT(plan);
+    GGML_ASSERT(ggml_backend_alloc_plan_add(plan.get(), ctx_a.get(), &a.buffer_type));
+    GGML_ASSERT(ggml_backend_alloc_plan_add(plan.get(), ctx_b.get(), &b.buffer_type));
