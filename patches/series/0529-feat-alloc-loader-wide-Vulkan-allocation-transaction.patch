index a7926a21a..a0c4c3db3 100644
--- a/ggml/include/ggml-alloc.h
+++ b/ggml/include/ggml-alloc.h
@@ -81,6 +81,53 @@ GGML_API size_t                       ggml_backend_alloc_ctx_tensors_from_buft_s
