@@ -20,6 +20,29 @@ FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
 // Default 0. GGML_ARIFI_IQ3_MMVQ=v2 selects arm 1; ONE binary serves both.
 layout (constant_id = 3) const uint ARIFI_IQ3_SIGN_HOIST = 0;
 
+// arifi lane-302 Route A: IQ3_XXS grid init (spec 4, GGML_ARIFI_IQ3XXS_INIT, idg pipeline only), the IQ3_S lever-6 shape:
+// 1 = all of a thread's loads issue before any LDS store, every entry written once (byte-identical by construction);
+// 2 = planted wrong arm (table rotated by one).
+layout (constant_id = 4) const uint ARIFI_IQ3XXS_INIT = 0;
+
+void arifi_init_iq3xxs_batched() {
+    const uint t = gl_LocalInvocationIndex;
+    const uint W = gl_WorkGroupSize.x;
+    for (uint i0 = 0; i0 < 256; i0 += 4 * W) {
+        uint v[4];
+        [[unroll]] for (uint k = 0; k < 4; ++k) {
+            v[k] = iq3xxs_grid_const[min(i0 + k * W + t, 255u)];
+        }
+        [[unroll]] for (uint k = 0; k < 4; ++k) {
+            const uint idx = i0 + k * W + t;
+            if (idx < 256) {
+                iq3xxs_grid[ARIFI_IQ3XXS_INIT == 2 ? ((idx + 1u) & 255u) : idx] = v[k];
+            }
+        }
+    }
+    barrier();
+}
+
 vec4 iq3xxs_sign_lo(const vec4 g, const uint sign) {
     return vec4((sign &  1) != 0 ? -g.x : g.x,
                 (sign &  2) != 0 ? -g.y : g.y,
@@ -135,7 +158,11 @@ void main() {
     }
 #endif
 
-    init_iq_shmem(gl_WorkGroupSize);
+    if (ARIFI_IQ3XXS_INIT != 0) {
+        arifi_init_iq3xxs_batched();
+    } else {
+        init_iq_shmem(gl_WorkGroupSize);
+    }
 
     // do NUM_ROWS at a time, unless there aren't enough remaining rows
     if (first_row + NUM_ROWS <= p.stride_d) {
