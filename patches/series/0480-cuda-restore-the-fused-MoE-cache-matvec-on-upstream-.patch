From 9dcd2e8a7ae0651f9f77733774bff55c92c29d8e Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Sun, 6 Sep 2026 04:21:12 -0400
Subject: [PATCH] cuda: restore the fused MoE-cache matvec on upstream's fusion
 kernel (WI-1699)

ggml_cuda_moe_cache_mmv_fused was declared in mmvq.cuh and called from
moe-cache.cu:2545, and had no definition on this branch since the b10819 base
move (R13 collision #5). CUDA did not link. This is the union R15B handed to
R17 as row 1 and R17 declined blind; it is written here with both mechanisms
intact and the difference between them stated in the kernel:

  - upstream (6a1a922d2): mul_mat_vec_q_moe takes a
    ggml_cuda_mm_fusion_args_device; the gate matrix shares the up matrix's
    expert index, bias/scale/glu_op/glu_limit ride in the struct. Untouched.
  - ArifiLabs (95c1b6e69): the expert cache holds up and gate in two
    independently evicted pools, so the gate row is addressed by its OWN slot
    id list, and the cache applies four independent clamp bounds (up_min/max,
    gate_min/max) before the GLU.

The union adds gate_ids_ptr (nullptr = upstream's shared index) and a
has_clamp template arm to the same kernel. gate_kbx_offset falls back to
kbx_offset when gate_ids is null, so every upstream launch computes exactly
what it did. The fused entry point builds a fusion struct with gate = the
gate pool and glu_op = SWIGLU - the old kernel's result *= silu(gate) - and
selects the clamp instantiation when any bound is finite, which is the old
fused_t's infinity test. Type list is the old one (no NVFP4 on the fused
path, as before).

NOT VERIFIED here: this estate has no CUDA toolchain. Union-by-mechanism-read;
compile verification is PENDING the first run of the cuda-ubuntu job, which
now links test-backend-ops statically so an undefined backend symbol fails
the job instead of hiding in a shared object.

Origin: ArifiLabs 95c1b6e69 (pre-b10819 fork) unioned onto upstream llama.cpp b10819 (6a1a922d2) mul_mat_vec_q_moe
WI: WI-1699
Lane: lane-210
---
 ggml/src/ggml-cuda/mmvq.cu | 158 +++++++++++++++++++++++++++++++++----
 1 file changed, 141 insertions(+), 17 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index a57a1e424..49e450b14 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -4,6 +4,7 @@
 #include "vecdotq.cuh"
 
 #include <cstdint>
+#include <limits>
 #include <type_traits>
 
 typedef float (*vec_dot_q_cuda_t)(const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs);
@@ -870,19 +871,27 @@ static __global__ void mul_mat_vec_q(
 // Grid: (ceil(nrows_x / c_rows_per_block), nchannels_dst)
 // Block: (warp_size, ncols_dst) - each warp handles one token independently.
 // No shared memory reduction needed since each warp works alone.
-template <ggml_type type, int c_rows_per_block, bool has_fusion = false>
+// ArifiLabs union (WI-1699): upstream's fusion struct carries the gate matrix with the SAME expert
+// index as the up matrix. The MoE expert cache stores up and gate in two independently evicted
+// pools, so the gate row for a hit is addressed by its own id list (gate_ids_ptr, nullptr = upstream
+// behaviour: gate channel == up channel). has_clamp adds the cache's four independent activation
+// bounds before the GLU; upstream's glu_limit path (SWIGLU_CLAMP) is untouched and still reachable.
+template <ggml_type type, int c_rows_per_block, bool has_fusion = false, bool has_clamp = false>
 __launch_bounds__(get_mmvq_mmid_max_batch_for_device<type>()*ggml_cuda_get_physical_warp_size(), 1)
 static __global__ void mul_mat_vec_q_moe(
-        const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr, const int32_t * act_ids_ptr, const ggml_cuda_mm_fusion_args_device fusion,
+        const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr, const int32_t * act_ids_ptr,
+        const int32_t * gate_ids_ptr, const ggml_cuda_mm_fusion_args_device fusion,
         float * dst_ptr,
         const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t nrows_x,
         const uint32_t stride_row_x, const uint32_t stride_col_y, const uint32_t stride_col_dst,
         const uint32_t stride_channel_x, const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
-        const uint32_t ncols_dst, const uint32_t ids_stride) {
+        const uint32_t ncols_dst, const uint32_t ids_stride,
+        const float up_min, const float up_max, const float gate_min, const float gate_max) {
     const void    * GGML_CUDA_RESTRICT vx  = vx_ptr;
     const void    * GGML_CUDA_RESTRICT vy  = vy_ptr;
     const int32_t * GGML_CUDA_RESTRICT ids = ids_ptr;
     const int32_t * GGML_CUDA_RESTRICT act_ids = act_ids_ptr;
+    const int32_t * GGML_CUDA_RESTRICT gate_ids = gate_ids_ptr;
     float         * GGML_CUDA_RESTRICT dst = dst_ptr;
 
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
@@ -934,6 +943,9 @@ static __global__ void mul_mat_vec_q_moe(
 
     const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y*stride_channel_y + token_idx*stride_col_y;
     const int kbx_offset  = channel_x*stride_channel_x + row0*stride_row_x;
+    // gate row: the cache's own gate slot when gate_ids is set, else upstream's shared expert index
+    const uint32_t channel_gate = gate_ids ? gate_ids[channel_dst + token_idx * ids_stride] : channel_x;
+    const int gate_kbx_offset = channel_gate*stride_channel_x + row0*stride_row_x;
 
     // partial sum for each thread
     float tmp[c_rows_per_block] = {0.0f};
@@ -949,7 +961,7 @@ static __global__ void mul_mat_vec_q_moe(
                 tmp[i] += vec_dot_q_cuda(vx, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
                 if constexpr (has_fusion) {
                     if (use_gate) {
-                        tmp_gate[i] += vec_dot_q_cuda(vgate, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+                        tmp_gate[i] += vec_dot_q_cuda(vgate, &y[kby], gate_kbx_offset + i*stride_row_x + kbx, kqs);
                     }
                 }
             }
@@ -993,6 +1005,11 @@ static __global__ void mul_mat_vec_q_moe(
                 if (gate_bias) {
                     gate_value += gate_bias[bias_idx];
                 }
+                if constexpr (has_clamp) {
+                    // MoE cache's four independent bounds (up and gate clamped separately, before the GLU)
+                    result     = fmaxf(fminf(result,     up_max),   up_min);
+                    gate_value = fmaxf(fminf(gate_value, gate_max), gate_min);
+                }
                 switch (active_glu) {
                     case GGML_GLU_OP_SWIGLU:
                         result *= ggml_cuda_op_silu_single(gate_value);
@@ -1020,6 +1037,9 @@ static __global__ void mul_mat_vec_q_moe(
     } else if constexpr (type != GGML_TYPE_NVFP4) {
         GGML_UNUSED_VARS(x_scale, gate_scale);
     }
+    if constexpr (!has_clamp) {
+        GGML_UNUSED_VARS(up_min, up_max, gate_min, gate_max);
+    }
 }
 
 template<ggml_type type>
@@ -1066,14 +1086,24 @@ static void mul_mat_vec_q_switch_fusion(
         sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride);
 }
 
+// ArifiLabs: the four clamp bounds are "inactive" when all are infinite (the MoE cache's no-clamp
+// encoding); only then is the clamp-free kernel instantiated for a fused launch.
+static bool ggml_cuda_moe_clamp_active(float up_min, float up_max, float gate_min, float gate_max) {
+    const float inf = std::numeric_limits<float>::infinity();
+    return !(up_min == -inf && up_max == inf && gate_min == -inf && gate_max == inf);
+}
+
 template <ggml_type type>
 static void mul_mat_vec_q_moe_launch(
-        const void * vx, const void * vy, const int32_t * ids, const int32_t * act_ids, const ggml_cuda_mm_fusion_args_device fusion, float * dst,
+        const void * vx, const void * vy, const int32_t * ids, const int32_t * act_ids, const int32_t * gate_ids,
+        const ggml_cuda_mm_fusion_args_device fusion, float * dst,
         const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t nrows_x,
         const uint32_t stride_row_x, const uint32_t stride_col_y, const uint32_t stride_col_dst,
         const uint32_t stride_channel_x, const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
         const uint32_t ncols_dst, const uint32_t ids_stride,
-        const int warp_size, const int nchannels_dst, cudaStream_t stream) {
+        const int warp_size, const int nchannels_dst,
+        const float up_min, const float up_max, const float gate_min, const float gate_max,
+        cudaStream_t stream) {
 
     constexpr int rows_per_block = 2; // 2 gives best perf based on tuning
     const int64_t nblocks_rows = (nrows_x + rows_per_block - 1) / rows_per_block;
@@ -1084,18 +1114,24 @@ static void mul_mat_vec_q_moe_launch(
     const bool has_fusion = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr ||
                             fusion.x_scale != nullptr || fusion.gate_scale != nullptr;
 
-    if (has_fusion) {
-        ggml_cuda_kernel_launch(mul_mat_vec_q_moe<type, rows_per_block, true>, launch_params,
-            vx, vy, ids, act_ids, fusion, dst, ncols_x, nchannels_y, nrows_x,
+    if (has_fusion && ggml_cuda_moe_clamp_active(up_min, up_max, gate_min, gate_max)) {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_moe<type, rows_per_block, true, true>, launch_params,
+            vx, vy, ids, act_ids, gate_ids, fusion, dst, ncols_x, nchannels_y, nrows_x,
+            stride_row_x, stride_col_y, stride_col_dst,
+            stride_channel_x, stride_channel_y, stride_channel_dst,
+            ncols_dst, ids_stride, up_min, up_max, gate_min, gate_max);
+    } else if (has_fusion) {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_moe<type, rows_per_block, true, false>, launch_params,
+            vx, vy, ids, act_ids, gate_ids, fusion, dst, ncols_x, nchannels_y, nrows_x,
             stride_row_x, stride_col_y, stride_col_dst,
             stride_channel_x, stride_channel_y, stride_channel_dst,
-            ncols_dst, ids_stride);
+            ncols_dst, ids_stride, up_min, up_max, gate_min, gate_max);
     } else {
-        ggml_cuda_kernel_launch(mul_mat_vec_q_moe<type, rows_per_block, false>, launch_params,
-            vx, vy, ids, act_ids, fusion, dst, ncols_x, nchannels_y, nrows_x,
+        ggml_cuda_kernel_launch(mul_mat_vec_q_moe<type, rows_per_block, false, false>, launch_params,
+            vx, vy, ids, act_ids, gate_ids, fusion, dst, ncols_x, nchannels_y, nrows_x,
             stride_row_x, stride_col_y, stride_col_dst,
             stride_channel_x, stride_channel_y, stride_channel_dst,
-            ncols_dst, ids_stride);
+            ncols_dst, ids_stride, up_min, up_max, gate_min, gate_max);
     }
 }
 
@@ -1199,11 +1235,13 @@ static void mul_mat_vec_q_switch_ncols_dst(
 
     if (has_ids && ncols_dst > 1) {
         // Multi-token MUL_MAT_ID path - dedicated MoE kernel
+        const float inf = std::numeric_limits<float>::infinity();
         mul_mat_vec_q_moe_launch<type>(
-            vx, vy, ids, nullptr, fusion, dst, ncols_x, nchannels_y_fd, nrows_x,
+            vx, vy, ids, nullptr, nullptr, fusion, dst, ncols_x, nchannels_y_fd, nrows_x,
             stride_row_x, stride_col_y, stride_col_dst,
             stride_channel_x, stride_channel_y, stride_channel_dst,
-            ncols_dst, ids_stride, warp_size, nchannels_dst, stream);
+            ncols_dst, ids_stride, warp_size, nchannels_dst,
+            -inf, inf, -inf, inf, stream);
         return;
     }
 
@@ -1659,11 +1697,14 @@ static void ggml_cuda_moe_cache_mmv_t(
 
     const int device = ggml_cuda_get_device();
     const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const float inf = std::numeric_limits<float>::infinity();
+    ggml_cuda_mm_fusion_args_device fusion_local{};
     mul_mat_vec_q_moe_launch<type>(
-        pool, act_q8, ids_dev, act_ids_dev, dst_dev, n_in,
+        pool, act_q8, ids_dev, act_ids_dev, nullptr, fusion_local, dst_dev, n_in,
         init_fastdiv_values(act_rows), n_out,
         s01, s12, n_out, s02, s11, n_out,
-        1, n_hits, warp_size, n_hits, stream);
+        1, n_hits, warp_size, n_hits,
+        -inf, inf, -inf, inf, stream);
 
     GGML_UNUSED(n_slots);
 }
@@ -1728,3 +1769,86 @@ void ggml_cuda_moe_cache_mmv(
     }
 #undef MOE_CACHE_MMV_CASE
 }
+
+// ArifiLabs (WI-1699): up * SiLU(gate) for rows whose two independently cached experts are resident.
+// Restored from the pre-b10819 fork (95c1b6e69) on top of upstream's ggml_cuda_mm_fusion_args_device
+// kernel: the gate pool rides in fusion.gate, the gate's OWN slot ids in gate_ids, and the cache's
+// four clamp bounds select the has_clamp instantiation. glu_op is SWIGLU, exactly as the old kernel
+// computed (result *= silu(gate)); upstream's glu_limit is left at 0 and never consulted on this path.
+template <ggml_type type>
+static void ggml_cuda_moe_cache_mmv_fused_t(
+        const void * up_pool, const void * gate_pool, const char * act_q8,
+        const int32_t * up_ids_dev, const int32_t * gate_ids_dev,
+        const int32_t * act_ids_dev, float * dst_dev,
+        int64_t n_in, int64_t n_out, int64_t slot_stride_bytes,
+        int64_t n_hits, int64_t act_rows, float up_min, float up_max,
+        float gate_min, float gate_max, cudaStream_t stream) {
+    const int64_t ts0 = ggml_type_size(type);
+    const int64_t ne10_padded = GGML_PAD(n_in, MATRIX_ROW_PADDING);
+    const int64_t s01 = ggml_row_size(type, n_in) / ts0;
+    const int64_t s02 = slot_stride_bytes / ts0;
+    const int64_t s11 = ne10_padded / QK8_1;
+    const int64_t s12 = act_rows * s11;
+
+    const int device = ggml_cuda_get_device();
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+
+    ggml_cuda_mm_fusion_args_device fusion{};
+    fusion.gate   = gate_pool;
+    fusion.glu_op = GGML_GLU_OP_SWIGLU;
+
+    mul_mat_vec_q_moe_launch<type>(
+        up_pool, act_q8, up_ids_dev, act_ids_dev, gate_ids_dev, fusion, dst_dev, n_in,
+        init_fastdiv_values(act_rows), n_out,
+        s01, s12, n_out, s02, s11, n_out,
+        1, n_hits, warp_size, n_hits,
+        up_min, up_max, gate_min, gate_max, stream);
+}
+
+void ggml_cuda_moe_cache_mmv_fused(
+        const void * up_pool, const void * gate_pool, ggml_type type0,
+        const char * act_q8, const int32_t * up_ids_dev,
+        const int32_t * gate_ids_dev, const int32_t * act_ids_dev,
+        float * dst_dev, int64_t n_in, int64_t n_out,
+        int64_t slot_stride_bytes, int64_t n_hits, int64_t act_rows,
+        float up_min, float up_max, float gate_min, float gate_max,
+        cudaStream_t stream) {
+    const int64_t ts0 = ggml_type_size(type0);
+    GGML_ASSERT(slot_stride_bytes % ts0 == 0);
+
+#define MOE_CACHE_MMV_FUSED_CASE(type_name) \
+        case type_name: \
+            ggml_cuda_moe_cache_mmv_fused_t<type_name>( \
+                up_pool, gate_pool, act_q8, up_ids_dev, gate_ids_dev, \
+                act_ids_dev, dst_dev, n_in, n_out, slot_stride_bytes, \
+                n_hits, act_rows, up_min, up_max, gate_min, gate_max, \
+                stream); \
+            break
+    switch (type0) {
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q1_0);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q2_0);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q4_0);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q4_1);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q5_0);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q5_1);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q8_0);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_MXFP4);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q2_K);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q3_K);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q4_K);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q5_K);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_Q6_K);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ2_XXS);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ2_XS);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ2_S);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ3_XXS);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ3_S);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ1_S);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ1_M);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ4_NL);
+        MOE_CACHE_MMV_FUSED_CASE(GGML_TYPE_IQ4_XS);
+        default:
+            GGML_ABORT("unsupported fused MoE cache type");
+    }
+#undef MOE_CACHE_MMV_FUSED_CASE
+}
