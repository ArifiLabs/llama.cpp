From 30347e2b6e309f22d3bbe0c30e23137ffa2b866a Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 5 Oct 2026 00:35:02 -0400
Subject: [PATCH] lane-298: unbuffered read_raw_unsafe throws on an unaligned
 cursor/len/ptr instead of returning floor-sector bytes

Selfcheck tools/dio_real.cpp now asserts the throw; GREEN on both IQ3_S shards + MTP sidecar.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit b5aac8a935ebd2aed4956aa2660b9a6788ea21a5)

Origin: ArifiLabs (native) - fork-authored (lane-298); no upstream origin exists.
Measured-effect: UNMEASURED on its own - supporting commit; see release ledger Table 1 W6, the number sits on that win's main commit
---
 src/llama-mmap.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/llama-mmap.cpp b/src/llama-mmap.cpp
index 0fbb2e9029..75063a7683 100644
--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -238,6 +238,9 @@ struct llama_file::impl {
     // plain ReadFile loop; on an unbuffered handle the caller guarantees the alignment rule.
     // allow_eof_pad: an unbuffered read of the last partial sector legitimately comes back short at EOF
     void read_raw_unsafe(void * ptr, size_t len, bool allow_eof_pad = false) {
+        if (has_direct_io() && ((dio_pos | len | (uintptr_t) ptr) & (alignment - 1))) {
+            throw std::runtime_error(format("unaligned unbuffered read: pos %zu len %zu align %zu", dio_pos, len, alignment));
+        }
         size_t bytes_read = 0;
         while (bytes_read < len) {
             size_t chunk_size = std::min<size_t>(len - bytes_read, 64*1024*1024);
