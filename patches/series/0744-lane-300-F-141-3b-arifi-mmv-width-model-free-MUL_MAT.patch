+
 add_executable(arifi-det-probe det-probe.cpp)
 target_link_libraries(arifi-det-probe PRIVATE llama-common llama ggml ${CMAKE_THREAD_LIBS_INIT})
 target_compile_features(arifi-det-probe PRIVATE cxx_std_17)
diff --git a/tools/arifi-op-probe/mmv-width.cpp b/tools/arifi-op-probe/mmv-width.cpp
new file mode 100644
index 0000000000..c6ebbfaf05
--- /dev/null
+++ b/tools/arifi-op-probe/mmv-width.cpp
@@ -0,0 +1,95 @@
+// lane-300 GOAL 3b op-level: does a MUL_MAT output column depend on how many columns share the dispatch?
+// For each (type, m, k): A = seeded random weights quantized to `type`, B = [k, n] f32 whose column 0 is the same
+// vector at every n. Column 0 of the n-column result is byte-compared with the n=1 result (n=1 included = repeat check).
+// env: MMVW_TYPES=q4_K,q6_K,...  MMVW_SHAPES=6144x2560,... (m x k)  MMVW_N=1,2,3,4,8  MMVW_SCALE=1 (B magnitude)
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <sstream>
+#include <string>
+#include <vector>
+
+static ggml_backend_t g_be;
+
+static std::vector<std::string> split(const char * s, const char * dflt) {
+    std::vector<std::string> r;
+    std::stringstream ss(s && *s ? s : dflt);
+    std::string x;
+    while (std::getline(ss, x, ',')) if (!x.empty()) r.push_back(x);
+    return r;
+}
+
+static std::vector<float> run(ggml_type t, int64_t m, int64_t k, int64_t n, const std::vector<uint8_t> & aq, const std::vector<float> & b) {
+    ggml_init_params ip = { 8 * ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * a = ggml_new_tensor_2d(ctx, t, k, m);
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+    ggml_tensor * y = ggml_mul_mat(ctx, a, x);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, y);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, g_be);
+    ggml_backend_tensor_set(a, aq.data(), 0, ggml_nbytes(a));
+    ggml_backend_tensor_set(x, b.data(), 0, (size_t) (k * n) * sizeof(float));
+    ggml_backend_graph_compute(g_be, gf);
+    std::vector<float> out((size_t) (m * n));
+    ggml_backend_tensor_get(y, out.data(), 0, out.size() * sizeof(float));
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    return out;
+}
+
+int main() {
+    ggml_backend_load_all();
+    g_be = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_GPU, nullptr);
+    if (!g_be) g_be = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_IGPU, nullptr);  // UMA iGPU reports IGPU
+    if (!g_be) { fprintf(stderr, "no GPU backend\n"); return 1; }
+    printf("{\"backend\":\"%s\"}\n", ggml_backend_name(g_be));
+    const float scale = getenv("MMVW_SCALE") ? (float) atof(getenv("MMVW_SCALE")) : 1.0f;
+    std::vector<int64_t> ns;
+    for (auto & s : split(getenv("MMVW_N"), "1,2,3,4,5,8")) ns.push_back(atoll(s.c_str()));
+    const int64_t nmax = std::max<int64_t>(16, *std::max_element(ns.begin(), ns.end()));
+    int red_total = 0;
+    for (auto & tn : split(getenv("MMVW_TYPES"), "q4_K,q5_K,q6_K,q8_0,iq4_xs,f16")) {
+        ggml_type t = GGML_TYPE_COUNT;
+        for (int i = 0; i < GGML_TYPE_COUNT; ++i) {
+            const char * nm = ggml_type_name((ggml_type) i);
+            if (nm && tn == nm) t = (ggml_type) i;
+        }
+        if (t == GGML_TYPE_COUNT) { printf("{\"type\":\"%s\",\"error\":\"unknown type\"}\n", tn.c_str()); continue; }
+        for (auto & sh : split(getenv("MMVW_SHAPES"), "6144x2560,10240x2560,2560x6144,6144x2048,6144x4096,6144x3072")) {
+            const int64_t m = atoll(sh.c_str()), k = atoll(sh.c_str() + sh.find('x') + 1);
+            std::mt19937 rng((uint32_t) (m * 31 + k));
+            std::normal_distribution<float> nd(0.0f, 1.0f);
+            std::vector<float> af((size_t) (m * k));
+            for (auto & v : af) v = nd(rng) * 0.02f;
+            std::vector<uint8_t> aq(ggml_row_size(t, k) * m);
+            if (t == GGML_TYPE_F16) ggml_fp32_to_fp16_row(af.data(), (ggml_fp16_t *) aq.data(), m * k);
+            else ggml_quantize_chunk(t, af.data(), aq.data(), 0, m, k, nullptr);
+            std::vector<float> bf((size_t) (k * nmax));
+            for (auto & v : bf) v = nd(rng) * scale;
+            const std::vector<float> ref = run(t, m, k, 1, aq, bf);
+            for (int64_t n : ns) {
+                const std::vector<float> o = run(t, m, k, n, aq, bf);
+                long nd0 = 0; double mx = 0; long first = -1;
+                for (int64_t i = 0; i < m; ++i) if (memcmp(&o[i], &ref[i], 4) != 0) {
+                    if (nd0++ == 0) first = (long) i;
+                    mx = std::max(mx, (double) std::fabs(o[i] - ref[i]));
+                }
+                red_total += nd0 ? 1 : 0;
+                printf("{\"type\":\"%s\",\"m\":%lld,\"k\":%lld,\"n\":%lld,\"col0_differ\":%ld,\"maxdiff\":%.6g,\"first_row\":%ld,\"red\":%d}\n",
+                    tn.c_str(), (long long) m, (long long) k, (long long) n, nd0, mx, first, nd0 ? 1 : 0);
+                fflush(stdout);
+            }
+        }
+    }
+    printf("{\"red_total\":%d}\n", red_total);
+    ggml_backend_free(g_be);
+    return 0;
+}
