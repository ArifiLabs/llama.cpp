+#define WBLOCK_QK 32
+#define WBLOCK_BYTES 24
+#define ACT_BLOCKS_PER_WBLOCK 1
+#endif
+
+#if MOE_CACHE_WTYPE == 11
+layout (binding = 0) readonly buffer A {block_q2_K data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 84
+#define ACT_BLOCKS_PER_WBLOCK 8
