+#if MOE_CACHE_WTYPE == 14
+layout (binding = 0) readonly buffer A {block_iq2_xs data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 74
+#define ACT_BLOCKS_PER_WBLOCK 8
+#endif
+
+#if MOE_CACHE_WTYPE == 15
+layout (binding = 0) readonly buffer A {block_iq2_s data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 82
+#define ACT_BLOCKS_PER_WBLOCK 8
+#endif
+
+#if MOE_CACHE_WTYPE == 16
+layout (binding = 0) readonly buffer A {block_iq3_xxs data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 98
+#define ACT_BLOCKS_PER_WBLOCK 8
+#endif
+
+#if MOE_CACHE_WTYPE == 17
+layout (binding = 0) readonly buffer A {block_iq3_s data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 110
+#define ACT_BLOCKS_PER_WBLOCK 8
+#endif
+
+#if MOE_CACHE_WTYPE == 18
+layout (binding = 0) readonly buffer A {block_iq1_s data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 50
+#define ACT_BLOCKS_PER_WBLOCK 8
+#endif
+
+#if MOE_CACHE_WTYPE == 19
+layout (binding = 0) readonly buffer A {block_iq1_m data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 56
+#define ACT_BLOCKS_PER_WBLOCK 8
+#endif
