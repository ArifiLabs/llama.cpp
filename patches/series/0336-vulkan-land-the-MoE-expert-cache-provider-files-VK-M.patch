+
+#if MOE_CACHE_WTYPE == 12
+layout (binding = 0) readonly buffer A {block_q3_K data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 110
+#define ACT_BLOCKS_PER_WBLOCK 8
+#endif
+
+#if MOE_CACHE_WTYPE == 13
+layout (binding = 0) readonly buffer A {block_iq2_xxs data_slab[];};
+#define WBLOCK_QK 256
+#define WBLOCK_BYTES 66
