 src/llama-arch.h        |  3 +++
 src/llama-model.h       |  5 +++++
 src/models/qwen4exp.cpp | 39 +++++++++++++++++++++++++++++++--------
 4 files changed, 45 insertions(+), 8 deletions(-)

