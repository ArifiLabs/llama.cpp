 ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp |  2 +-
 .../ggml-vulkan/vulkan-shaders/mul_mat_vec_base.glsl | 12 +++++++++++-
 .../vulkan-shaders/mul_mat_vec_iq2_s.comp            |  2 +-
 .../vulkan-shaders/mul_mat_vec_iq3_s.comp            |  2 +-
 .../vulkan-shaders/mul_mat_vec_iq3_xxs.comp          |  2 +-
 .../vulkan-shaders/mul_mat_vec_iq4_xs.comp           |  2 +-
 6 files changed, 16 insertions(+), 6 deletions(-)

