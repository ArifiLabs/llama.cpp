From 4c8855430d59f97e7041bb3e845ebec8f86f247c Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Wed, 7 Oct 2026 19:27:28 -0400
Subject: [PATCH] tests: lane-299 exact-equality op cases at verify widths 2..8
 for the shipped fusions HC_POST_W and GDN_BANK

NMSE alone missed HC_POST_RMS drifting at n_tokens 2..4 (lane-299 ab14). These cases are gated by the GGML_ARIFI_OP_DUMP byte dump: the fused run and the GGML_VK_DISABLE_HC_POST_W / GGML_VK_DISABLE_GDN_BANK run must produce the same sha256, and the GGML_VK_*_PLANT run must differ. Runner: cache/fusion-x1-lane/build-16.ps1.

Origin: lane-299 (HQ84 12:5x order)
Measured-effect: UNMEASURED (test-only; exact-equality receipt in cache/fusion-x1-lane/cells/build16-*-optx-verdict.txt)
---
 tests/test-backend-ops.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 1e404d8f6b..b7d448e873 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10366,6 +10366,10 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_dsv4_hc_post(4096, 21, true));
     test_cases.emplace_back(new test_dsv4_hc_post_w(2560, 1));        // qwen4exp decode
     test_cases.emplace_back(new test_dsv4_hc_post_w(2560, 8));        // MTP verify window
+    // lane-299 HQ84: every verify width 2..7 too; gated by GGML_ARIFI_OP_DUMP sha (fused == GGML_VK_DISABLE_HC_POST_W), not NMSE
+    for (int64_t n : {2, 3, 4, 5, 6, 7}) {
+        test_cases.emplace_back(new test_dsv4_hc_post_w(2560, n));
+    }
     test_cases.emplace_back(new test_dsv4_hc_post_w(31, 17));
     test_cases.emplace_back(new test_dsv4_hc_post_w(31, 17, false));  // comb pipeline variant
 
@@ -12960,6 +12964,11 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_gated_delta_net_bank(16, 128, 3, 1, 2, true,  1));
     test_cases.emplace_back(new test_gated_delta_net_bank(4,  64,  6, 4, 4, true,  2));
     test_cases.emplace_back(new test_gated_delta_net_bank(4,  64,  4, 1, 2, true,  0));
+    // lane-299 HQ84: qwen4exp GDN 48 v heads x 128 (ssm.inner_size 6144 / state_size 128), verify widths 2..8, one and min(n,3) snapshots; gated by dump sha (fused == GGML_VK_DISABLE_GDN_BANK)
+    for (int64_t n = 2; n <= 8; ++n) {
+        test_cases.emplace_back(new test_gated_delta_net_bank(48, 128, n, 1, 1, true));
+        test_cases.emplace_back(new test_gated_delta_net_bank(48, 128, n, std::min<int64_t>(n, 3), std::min<int64_t>(n, 3), true));
+    }
     // lane-299 layout copies: mode, C, hist, n_t (GDN conv tail 10240x3, PLE conv 10240 hist 9)
     test_cases.emplace_back(new test_l299_layout(0, 10240, 3, 1));
     test_cases.emplace_back(new test_l299_layout(0, 10240, 3, 4));
