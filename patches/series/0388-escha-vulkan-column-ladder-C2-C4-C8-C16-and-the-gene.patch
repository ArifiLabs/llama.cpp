+// (3.91 -> 0.81 t/s, same box, same session, verified against a saved binary). The arithmetic arm
+// must not pay for a table it never reads.
+#if ESCHA_LUT
+layout (binding = 4) readonly buffer L { uint data_l[]; };   // 32768 uints = 65536 f16 values
+#endif
