+int main(void) {
+    enum { N = 64 };
+
+    float src[N];
+    float fp3[N];
+    float fp6[N];
+    float fp8[N];
+
+    block_rocmfp3 q3[N / QK_ROCMFP3];
+    block_rocmfp6 q6[N / QK_ROCMFP6];
+    block_rocmfp8 q8[N / QK_ROCMFP8];
