+            continue;
+        }
+        const float y = rocmfpx_fp6_decoded_value(x[i], inv_scale) * scale;
+        const float d = x[i] - y;
+        err += d*d;
+        if (err > best_err) {
+            return err;
+        }
+    }
+
+    return err;
+}
