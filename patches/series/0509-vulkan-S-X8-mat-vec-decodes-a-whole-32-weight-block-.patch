From 6f04f43d553e517216ad76814893ed15cf590e8a Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Thu, 10 Sep 2026 11:29:17 -0400
Subject: [PATCH] vulkan: S-X8 mat-vec decodes a whole 32-weight block per
 thread (R46 ranks 2+4)

The kernel gave one thread one weight POSITION. Each of the 32 threads over a block therefore re-read that block's dmin/dmax/config and re-evaluated sx8_range() for its own single weight: 96 header reads, 64 plane bytes and 32 range evaluations to produce 32 weights. One thread now owns the whole block - 3 header reads, 24 plane bytes, 4 range evaluations - and threads stride whole blocks by BLOCK_SIZE. Same weight bytes off memory, a fraction of the instructions.

sx8_nib4() / sx8_low4() / sx8_levels4() live in types.glsl beside sx8_range(), so the decode constants keep ONE home shared with dequant_sx8 (the F-110 rule). A 16-bit view of qh/ql was evaluated and rejected: qh starts at byte 5 of the 30-byte block, an odd offset, so a uint16 array over it cannot align to the 4-element groups the packing is built from.

Correctness: MUL_MAT sx8 12/12, MUL_MAT_ID 2/2, identical to the baseline binary; test-quantize-fns sx8 clean with the same 6 pre-existing failures on other types. Planted-RED bracket recorded in the lane report: the sweep goes red at a +3.95% step-constant drift but stays GREEN at +0.63%, so the oracle runs the code and its sensitivity floor is now a measured number rather than an assumption.

Origin: ArifiLabs (native)
Lane: lane-230
---
 .../vulkan-shaders/mul_mat_vec_sx8.comp       | 88 ++++++++++++-------
 .../src/ggml-vulkan/vulkan-shaders/types.glsl | 27 ++++++
 2 files changed, 81 insertions(+), 34 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_sx8.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_sx8.comp
index 955b0ac08..6ba715338 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_sx8.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_sx8.comp
@@ -13,10 +13,21 @@ layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 // S-X8 is far simpler than the TQ family this file's shape is borrowed from.
 // There is no rotation, so no butterfly, no shared memory and no barrier: the
 // stored block already holds the weights, and decode is 32 independent
-// per-weight expressions. One thread therefore owns one weight POSITION, and
-// the workgroup covers gl_WorkGroupSize.x / 32 blocks at a time. That keeps a
-// wave64 device (the 780M reports warp size 64) fully occupied instead of
-// running the 32-thread half-wave the legacy TQ kernels use.
+// per-weight expressions.
+//
+// lane-230 / R46: one thread now owns one 32-weight BLOCK, not one weight
+// POSITION. The old mapping gave each of 32 threads its own weight and made
+// every one of them re-read the block header and re-evaluate sx8_range(), so a
+// single block cost 96 header reads, 64 plane bytes and 32 range evaluations
+// for 32 weights. Owning the whole block costs 3 header reads, 24 plane bytes
+// and 4 range evaluations -- the same weight bytes, a fraction of the
+// instructions. Threads stride whole blocks by BLOCK_SIZE, so any workgroup
+// size is correct and a wave64 device stays fully occupied.
+//
+// A 16-bit view of qh/ql was evaluated and REJECTED: qh starts at byte 5 of the
+// 30-byte block (2 + 2 + 1 header), an ODD offset, so a uint16 array over it
+// cannot align to the 4-element groups the packing is built from. Byte reads
+// move the same cache lines anyway; only the instruction count mattered here.
 //
 // reduce_result() sums across the whole workgroup, so partials from different
 // blocks land in the same accumulator -- which is exactly what a dot product
@@ -25,7 +36,8 @@ layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 // Decode reference: dequantize_row_sx8() in ggml/src/ggml-quants.c. The scalars
 // live in sx8_range() (types.glsl) so this shader and dequant_sx8.comp cannot
 // drift apart from each other; both still mirror the C by hand, which is the
-// F-110 hazard the lane PREREG's planted-RED recipe checks.
+// F-110 hazard the lane PREREG's planted-RED recipe checks. sx8_levels4() lives
+// beside it for the same reason.
 
 void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
     const uint tid = gl_LocalInvocationID.x;
@@ -42,40 +54,48 @@ void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
 
     const uint num_blocks_per_row = p.ncols / 32u;
 
-    const uint elem     = tid & 31u;          // weight position inside a block
-    const uint blk_base = tid >> 5u;          // which block this thread starts on
-    const uint blk_step = BLOCK_SIZE >> 5u;   // blocks covered per iteration
-
-    // Constant for this thread: which sub-block of 8 it sits in, and where its
-    // 4 high bits and 2 low bits live. The low bits are stored BIG-endian within
-    // their byte -- (3 - (j & 3)) -- which is the one packing detail worth
-    // re-reading against the C before trusting a number out of this kernel.
-    const uint sb       = elem >> 3u;
-    const uint qh_byte  = elem >> 1u;
-    const uint qh_shift = (elem & 1u) * 4u;
-    const uint ql_byte  = elem >> 2u;
-    const uint ql_shift = (3u - (elem & 3u)) * 2u;
-
-    for (uint blk = blk_base; blk < num_blocks_per_row; blk += blk_step) {
-        // Activation for this thread's weight position, one per column.
-        float bv[NUM_COLS];
-        [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
-            bv[c] = float(data_b[c * p.batch_stride_b + b_offset + blk * 32u + elem]);
-        }
-
+    for (uint blk = tid; blk < num_blocks_per_row; blk += BLOCK_SIZE) {
+        // Block header, read ONCE per row for the whole block.
+        float dlo[NUM_ROWS];
+        float dhi[NUM_ROWS];
+        uint  cfg[NUM_ROWS];
         [[unroll]] for (uint n = 0; n < num_rows; ++n) {
             const uint ib = a_offset + (first_row + n) * num_blocks_per_row + blk;
+            dlo[n] = float(data_a[ib].dmin);
+            dhi[n] = float(data_a[ib].dmax);
+            cfg[n] = uint(data_a[ib].config);
+        }
 
-            float rlo, step;
-            sx8_range(float(data_a[ib].dmin), float(data_a[ib].dmax),
-                      (uint(data_a[ib].config) >> (sb * 2u)) & 3u, rlo, step);
-
-            const uint hi = (uint(data_a[ib].qh[qh_byte]) >> qh_shift) & 0xFu;
-            const uint lo = (uint(data_a[ib].ql[ql_byte]) >> ql_shift) & 0x3u;
-            const float w = rlo + step * float((hi << 2u) | lo);
+        const uint b_base = b_offset + blk * 32u;
 
+        // One sub-block of 8 weights at a time: one range strategy, one pair of
+        // 4-element groups.
+        [[unroll]] for (uint sb = 0; sb < 4u; ++sb) {
+            float bv[NUM_COLS][8];
             [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
-                temp[c][n] += FLOAT_TYPE(w * bv[c]);
+                [[unroll]] for (uint e = 0; e < 8u; ++e) {
+                    bv[c][e] = float(data_b[c * p.batch_stride_b + b_base + sb * 8u + e]);
+                }
+            }
+
+            [[unroll]] for (uint n = 0; n < num_rows; ++n) {
+                const uint ib = a_offset + (first_row + n) * num_blocks_per_row + blk;
+
+                float rlo, step;
+                sx8_range(dlo[n], dhi[n], (cfg[n] >> (sb * 2u)) & 3u, rlo, step);
+
+                [[unroll]] for (uint g = 0; g < 2u; ++g) {
+                    const uint qh_pair = uint(data_a[ib].qh[sb * 4u + g * 2u])
+                                       | (uint(data_a[ib].qh[sb * 4u + g * 2u + 1u]) << 8u);
+                    const uint levels  = sx8_levels4(qh_pair, uint(data_a[ib].ql[sb * 2u + g]));
+
+                    [[unroll]] for (uint e = 0; e < 4u; ++e) {
+                        const float w = rlo + step * float((levels >> (e * 8u)) & 0xFFu);
+                        [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
+                            temp[c][n] += FLOAT_TYPE(w * bv[c][g * 4u + e]);
+                        }
+                    }
+                }
             }
         }
     }
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl
index afab99250..6c1ab9cd8 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl
@@ -2108,6 +2108,33 @@ void sx8_range(float lo_f, float hi_f, uint s, out float rlo, out float step) {
     const float rhi = hi_f - q * float(3u * uint(s == 1u) + uint(s == 3u));
     step = max((rhi - rlo) * 0.015873, 1e-10);
 }
+
+// Four consecutive six-bit levels, packed one per byte of the returned uint.
+// lane-230 / R46: the mat-vec used to give one weight POSITION to one thread, which
+// cost five buffer reads and one sx8_range() per weight. These two helpers let ONE
+// thread decode four weights from three byte reads, so a whole 32-weight block costs
+// 3 header + 24 plane reads instead of 96 + 64.
+//
+// qh_pair packs the two qh bytes that cover elements 4g..4g+3: byte 2g in bits 0-7
+// (elements 4g low nibble, 4g+1 high nibble) and byte 2g+1 in bits 8-15 (elements
+// 4g+2, 4g+3). Spreading them 16 bits apart puts each nibble in its own byte lane.
+uint sx8_nib4(uint qh_pair) {
+    const uint x = (qh_pair & 0xFFu) | ((qh_pair & 0xFF00u) << 8u);
+    return (x & 0x000F000Fu) | (((x >> 4u) & 0x000F000Fu) << 8u);
+}
+
+// ql byte g carries the 2 low bits of elements 4g..4g+3 at shifts 6,4,2,0 -- BIG-endian
+// within the byte, the one packing detail worth re-reading against the C. The four
+// shifts below are that order written out; the mask kills the cross-byte spill.
+uint sx8_low4(uint ql_byte) {
+    return ((ql_byte >> 6u) | (ql_byte << 4u) | (ql_byte << 14u) | (ql_byte << 24u)) & 0x03030303u;
+}
+
+// Each byte of the result is one level in [0,63]. The <<2 cannot spill into the next
+// byte lane: sx8_nib4 leaves the high nibble of every byte zero.
+uint sx8_levels4(uint qh_pair, uint ql_byte) {
+    return (sx8_nib4(qh_pair) << 2u) | sx8_low4(ql_byte);
+}
 #endif
 
 #if defined(DATA_A_IQ4_NL) || defined(DATA_A_IQ4_XS)
