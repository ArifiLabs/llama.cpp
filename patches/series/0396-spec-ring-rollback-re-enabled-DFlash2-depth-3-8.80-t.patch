From d32df90516e045750d34a7131ab2baf2db6098ff Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 24 Aug 2026 21:01:57 -0400
Subject: [PATCH] spec: ring rollback re-enabled - DFlash2 depth 3 = 8.80 t/s
 (2.0x plain), 0 degenerate

The dummy-node probe (k1, no ring, no drafter, ONE harmless extra graph node: 15/16 outputs
flip, 0 degenerate) proves the residual Vulkan 'ring divergence' was graph-layout float-order
noise, not corruption - byte-identity across DIFFERENT graphs is not a valid gate on this
backend. With the wrong-age bank fix already landed (08a82030a), need_n_rs_seq returns
draft.n_max again: rejection rollback rides the bank, no checkpoint restore, no accepted-token
replay. LLAMA_RING_OFF=1 = conservative fallback (checkpoint mode + on-device saves, 8.02).

Measured (Huihui Q4_K + DFlash2 Q4_K_M, 16-corpus temp0, vs plain 4.28-4.53):
  ring n3: 8.80 t/s, 0 degenerate, diffs eyeballed = fluent tie-flips
  ring n5: 6.94, 2 REPEAT | ring n7: 6.51, 4 REPEAT  -> depth-correlated slide, deep bank
  slots (>3) still carry a real defect - bounded, documented, n3 stays clear of it.
Evidence: research/local-inference/lane-evidence/2026-08-24-ring-repair/.
---
 common/common.h               | 28 ++++++++++++++++------------
 src/models/delta-net-base.cpp |  8 ++++++++
 2 files changed, 24 insertions(+), 12 deletions(-)

diff --git a/common/common.h b/common/common.h
index d2ef835bf..206bfaba6 100644
--- a/common/common.h
+++ b/common/common.h
@@ -405,18 +405,22 @@ struct common_params_speculative {
     }
 
     uint32_t need_n_rs_seq() const {
-        // F-136 ROOT FIX: always 0. Returning draft.n_max here flipped the TARGET's whole recurrent
-        // graph (prefill, plain decode, and verification alike) onto the K>1 snapshot-bank path the
-        // moment an MTP/EAGLE3/DFLASH/DSPARK drafter was attached. Measured on Qwen3.5-4B with NO
-        // drafter and NO speculation, one variable (LLAMA_FORCE_RS_SEQ=7): 1/16 outputs identical
-        // to the K=1 path, five hard repetition loops. The bank machinery corrupts the recurrent
-        // state (wrong-age snapshot writes, and same-buffer bank copies with no dependency edges),
-        // so the target became a DIFFERENT, degraded model whenever a drafter was attached - the
-        // whole F-136 "speculative decoding changes the output" symptom, seeded at prefill.
-        // With n_rs_seq=0 the target computes identically with and without a drafter, and
-        // rejection rollback rides the server's speculative CHECKPOINT path (spec_ckpt
-        // save/restore), whose hybrid recurrent-state serialization is position-exact.
-        return 0u;
+        // F-136 history, two acts (evidence: lane-evidence/2026-08-22-f136-spec-losslessness/ and
+        // .../2026-08-24-ring-repair/):
+        // (1) The REAL corruption was the wrong-age snapshot-bank writes (fixed in delta-net-base,
+        //     rode 08a82030a). CPU KFLIP is byte-identical K=8 vs K=1 after that fix.
+        // (2) The residual Vulkan "divergence" attributed to the ring was proven to be graph-layout
+        //     float-order noise: ONE harmless extra graph node with NO ring and NO drafter flips
+        //     15/16 outputs (k1-dummy probe, 0 degenerate). Byte-identity across DIFFERENT graphs
+        //     is not a valid gate on Vulkan; the ring is not broken by that evidence.
+        // The ring path avoids the per-rejection checkpoint restore + accepted-token replay, so it
+        // is the fast rollback. LLAMA_RING_OFF=1 restores the checkpoint-only mode (n_rs_seq=0),
+        // which pairs with LLAMA_SPEC_CKPT_ON_DEVICE=1 (12 ms saves) as the conservative fallback.
+        static const bool ring_off = getenv("LLAMA_RING_OFF") != nullptr;
+        if (ring_off) {
+            return 0u;
+        }
+        return draft.n_max > 0 ? (uint32_t) draft.n_max : 0u;
     }
 };
 
diff --git a/src/models/delta-net-base.cpp b/src/models/delta-net-base.cpp
index 3e4aa7e1d..6b919cccc 100644
--- a/src/models/delta-net-base.cpp
+++ b/src/models/delta-net-base.cpp
@@ -476,6 +476,14 @@ ggml_tensor * llm_build_delta_net_base::build_conv_state(
 
     const size_t row_size  = ggml_row_size(conv_states_all->type, row_count);
 
+    // ring-repair alignment-noise probe (2026-08-24): one harmless extra node (cont of the conv
+    // state, result unused beyond a scratch write) on the PASSING minimal config. If plain-decode
+    // output drifts, the "bank machinery corruption" is really allocator-layout numeric noise.
+    static const bool rs_dummy_node = getenv("LLAMA_RS_DUMMY_NODE") != nullptr;
+    if (rs_dummy_node) {
+        ggml_build_forward_expand(gf, ggml_cont(ctx0, qkv_mixed));
+    }
+
     // ring-repair bisect gate (2026-08-24): force the single-slot write path even with K>1.
     // Banks go stale (rollback unusable) but plain-decode output must then equal K=1 -
     // discriminates bank-write machinery from the rest. Not a shipping mode.
