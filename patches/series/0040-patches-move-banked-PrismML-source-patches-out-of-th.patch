++// the shader's `if (ib >= p.nel/128) return;` correctness depends on the block
++// count not being a multiple of 16. we run num_blocks in {1, 15, 16, 17, 31,
++// 32, 33, 48, 65}
++
++static void test_dequant_q2_0_boundary() {
