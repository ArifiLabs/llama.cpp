+static bool ggml_cuda_env_list_has(const char * list, const char * name) {
+    if (list == nullptr || list[0] == '\0') {
+        return false;
+    }
+
+    const char * tok = list;
+    while (*tok != '\0') {
+        while (*tok == ',' || *tok == ' ' || *tok == '\t') {
+            ++tok;
+        }
+
+        const char * end = tok;
+        while (*end != '\0' && *end != ',') {
+            ++end;
+        }
+
+        const size_t len = end - tok;
+        if (len > 0) {
+            const std::string token(tok, len);
+            if (std::strstr(name, token.c_str()) != nullptr) {
+                return true;
+            }
+        }
+
+        if (*end == '\0') {
+            break;
+        }
+
+        tok = end + 1;
+    }
+
+    return false;
+}
