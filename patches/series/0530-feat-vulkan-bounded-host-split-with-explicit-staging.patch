+    // host-visible and could hold all three. What stops it is the bound, and only the bound.
+    const std::vector<std::vector<heapres_split_cand>> three_buffers = {
+        { {0, 8 * MiB, false}, {1, 8 * MiB, true} },
+        { {0, 8 * MiB, false}, {1, 8 * MiB, true} },
