@@ -2473,6 +2473,33 @@
       "workload": "Qwen3.8-Flash-Next qwen4exp: upstream #29761 full and MTP-only GGUFs, and our sidecar, CPU + Vulkan (Radeon 890M).",
       "measured_effect": "Capability: upstream #29761 qwen4exp GGUFs (full and MTP-only) load and draft with logits bit-equal to our sidecar of the same weights; our sidecar logits hash unchanged. Speed not measured (loader row).",
