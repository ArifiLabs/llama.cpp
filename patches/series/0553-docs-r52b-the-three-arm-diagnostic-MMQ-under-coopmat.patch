+#!/usr/bin/env python3
+"""R52b: prove the packed S-X8 mul_mm tile decode is bit-identical to the C reference.
+
+The packed path replaces the per-weight scalar extraction in
+mul_mm_funcs.glsl load_a_to_shmem() with the sx8_levels4() helper already in
+types.glsl (lines 2121-2137, minted by lane-230 / R46 for the mat-vec).
+
+Checked here, exhaustively over every byte value:
+  1. sx8_nib4 / sx8_low4 / sx8_levels4 (the GLSL helpers, mirrored) reproduce
+     sx8_level() from ggml/src/ggml-quants.c:2404-2408 for all 32 positions.
+  2. The group mapping the new mul_mm branch uses -- sub-block iqs reads
+     qh[4*iqs .. 4*iqs+3] and ql[2*iqs], ql[2*iqs+1] -- lands each weight at the
+     SAME k_pair slot the shipped scalar loop wrote it to.
+  3. The VMEM accounting quoted in the report: 16 byte reads per 8 weights
+     before, 6 after.
+Exit 0 and print PACKED-DECODE-EXACT on success.
+"""
+import itertools
+import sys
+
+M32 = 0xFFFFFFFF
+
+
+def sx8_nib4(qh_pair: int) -> int:
+    x = (qh_pair & 0xFF) | ((qh_pair & 0xFF00) << 8)
+    return ((x & 0x000F000F) | (((x >> 4) & 0x000F000F) << 8)) & M32
+
+
+def sx8_low4(ql_byte: int) -> int:
+    return ((ql_byte >> 6) | (ql_byte << 4) | (ql_byte << 14) | (ql_byte << 24)) & 0x03030303
+
+
+def sx8_levels4(qh_pair: int, ql_byte: int) -> int:
+    return ((sx8_nib4(qh_pair) << 2) | sx8_low4(ql_byte)) & M32
+
+
+def unpack8(v: int):
+    return [(v >> (8 * i)) & 0xFF for i in range(4)]
+
+
+def c_sx8_level(qh, ql, j: int) -> int:
+    hi = (qh[j >> 1] >> ((j & 1) * 4)) & 0xF
+    lo = (ql[j >> 2] >> ((3 - (j & 3)) * 2)) & 0x3
+    return (hi << 2) | lo
+
+
+def main() -> int:
+    mismatches = 0
+    combos = 0
+
+    # (1): every group g of 4 weights reads qh[2g], qh[2g+1] and ql[g]; the C
+    # extraction depends on those three bytes and on j&3 only, so one group with
+    # every (a, b, q) triple is exhaustive over the arithmetic. g = 0 is used;
+    # the index mapping for the other groups is checked separately in (2b).
+    g = 0
+    for a, b, q in itertools.product(range(256), range(256), range(256)):
+        combos += 1
+        lv = unpack8(sx8_levels4(a | (b << 8), q))
+        qh = {2 * g: a, 2 * g + 1: b}
+        ql = {g: q}
+        for t in range(4):
+            ref = c_sx8_level(qh, ql, 4 * g + t)
+            if lv[t] != ref:
+                mismatches += 1
+                if mismatches < 5:
+                    print(f"MISMATCH g={g} t={t} a={a} b={b} q={q} got={lv[t]} want={ref}")
+
+    # (2b): the read indices the new branch uses must cover exactly the bytes the
+    # shipped scalar loop touched for the same sub-block.
+    for iqs in range(4):
+        scalar_qh, scalar_ql = set(), set()
+        for i in range(8):
+            j = iqs * 8 + i
+            scalar_qh.add(j >> 1)
+            scalar_ql.add(j >> 2)
+        packed_qh = {4 * iqs, 4 * iqs + 1, 4 * iqs + 2, 4 * iqs + 3}
+        packed_ql = {2 * iqs, 2 * iqs + 1}
+        if scalar_qh != packed_qh or scalar_ql != packed_ql:
+            print(f"INDEX MISMATCH iqs={iqs} qh {sorted(scalar_qh)} vs {sorted(packed_qh)} "
+                  f"ql {sorted(scalar_ql)} vs {sorted(packed_ql)}")
+            mismatches += 1
+
+    # (3): VMEM accounting per 8 weights (one invocation, LOAD_VEC_A = 8).
+    scalar_reads = 8 * 2          # one qh byte + one ql byte per weight
+    packed_reads = 4 + 2          # 4 qh bytes + 2 ql bytes for the whole sub-block
+    assert scalar_reads == 16 and packed_reads == 6
+
+    print(f"positions=32 combos={combos} mismatches={mismatches}")
+    print(f"byte_reads_per_8_weights scalar={scalar_reads} packed={packed_reads}")
+    if mismatches:
+        print("PACKED-DECODE-MISMATCH")
+        return 1
+    print("PACKED-DECODE-EXACT")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
