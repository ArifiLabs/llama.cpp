   "local_checkouts": {
     "_comment": "TurboQuant is not a remote of this fork. These are sibling clones on disk. Relative to this repo's parent directory unless `path` is absolute.",
     "llama-cpp-turboquant": {
@@ -70,7 +84,6 @@
       "role": "TurboQuant recompress pipeline"
     }
   },
-
   "build": {
     "_comment": [
       "The recipe is recovered by DIFFING a CMakeCache against the committed snapshot, never by",
@@ -80,9 +93,10 @@
     "cache_snapshot": "tools/arifi-sync/recipe/build-vulkan.cache-snapshot.txt",
     "live_cache": "build-vulkan/CMakeCache.txt",
     "build_dir": "build-vulkan",
-    "targets": ["llama-server"]
+    "targets": [
+      "llama-server"
+    ]
   },
-
   "judge": {
     "_comment": [
       "F-085, President-ruled and BINDING: the regression judge is llama-server.",
@@ -92,7 +106,11 @@
     ],
     "binary": "llama-server",
     "model": "C:/ArifiLabs/models/gguf/ternary/Ternary-Bonsai-27B-Abliterated-LowDeg-Q2_0.g128.gguf",
-    "args": ["-ngl", "99", "--no-host"],
+    "args": [
