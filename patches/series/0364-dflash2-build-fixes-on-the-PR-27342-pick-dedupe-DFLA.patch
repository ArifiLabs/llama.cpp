From 82bc66c5fe381e77dd8221cd0d9b3524ce60102d Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Wed, 19 Aug 2026 11:24:11 -0400
Subject: [PATCH] dflash2: build fixes on the PR #27342 pick - dedupe
 DFLASH_BLOCK_SIZE enum/hparam/kv-map (fork DFlash1 originals keep authority,
 default 16) + ml. reference fix (the shadow the fork's own comment documents)

---
 src/llama-arch.cpp  | 2 +-
 src/llama-arch.h    | 2 +-
 src/llama-hparams.h | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/llama-arch.cpp b/src/llama-arch.cpp
index aeefa47509..9d93be6b7f 100644
--- a/src/llama-arch.cpp
+++ b/src/llama-arch.cpp
@@ -362,7 +362,7 @@ static const std::map<llm_kv, const char *> LLM_KV_NAMES = {
 
     { LLM_KV_TARGET_LAYERS,         "%s.target_layers"        },
     { LLM_KV_TARGET_HIDDEN_SIZE,    "%s.target_hidden_size"   },
-    { LLM_KV_DFLASH_BLOCK_SIZE,       "%s.block_size"           },
+    // LLM_KV_DFLASH_BLOCK_SIZE mapped once in the fork's DFlash1 block below (dedupe of PR #27342)
     { LLM_KV_DFLASH_CONV_KERNEL_SIZE, "%s.conv_kernel_size"    },
     { LLM_KV_DFLASH_CONV_GROUP_SIZE,  "%s.conv_group_size"     },
     { LLM_KV_DFLASH_SELECTOR_RANK,    "%s.selector_rank"       },
diff --git a/src/llama-arch.h b/src/llama-arch.h
index 6b6e0cd634..1f4190f6c7 100644
--- a/src/llama-arch.h
+++ b/src/llama-arch.h
@@ -410,7 +410,7 @@ enum llm_kv {
 
     LLM_KV_TARGET_LAYERS,
     LLM_KV_TARGET_HIDDEN_SIZE,
-    LLM_KV_DFLASH_BLOCK_SIZE,
+    // LLM_KV_DFLASH_BLOCK_SIZE lives in the fork's DFlash1 block below (dedupe of PR #27342)
     LLM_KV_DFLASH_CONV_KERNEL_SIZE,
     LLM_KV_DFLASH_CONV_GROUP_SIZE,
     LLM_KV_DFLASH_SELECTOR_RANK,
diff --git a/src/llama-hparams.h b/src/llama-hparams.h
index e1b3319eb7..569b7d4cf2 100644
--- a/src/llama-hparams.h
+++ b/src/llama-hparams.h
@@ -247,7 +247,7 @@ struct llama_hparams {
     // output embedding dimension (0 = use n_embd)
     uint32_t n_embd_out_impl = 0;
 
-    uint32_t dflash_block_size       = 0;
+    // dflash_block_size lives in the fork's DFlash1 block below, default 16 (dedupe of PR #27342)
     uint32_t dflash_conv_kernel_size = 0;
     uint32_t dflash_conv_group_size  = 0;
     uint32_t dflash_selector_rank    = 0;
