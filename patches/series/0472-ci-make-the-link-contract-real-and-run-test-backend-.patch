From 31764c3192714bcca08408ebae76870580f07034 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Sun, 6 Sep 2026 04:21:14 -0400
Subject: [PATCH] ci: make the link contract real, and run test-backend-ops on
 the CPU job

Two gaps in the matrix as R17 left it:

  1. Every job built only test-quantize-fns against SHARED libraries. A
     shared libggml-cuda.so accepts an undefined symbol at link time, so the
     exact defect this lane exists for (WI-1699: declared, called, never
     defined) would have passed the CUDA job green. BUILD_SHARED_LIBS=OFF on
     every job, and every job now also links test-backend-ops, which pulls
     every backend entry point into one executable. An unresolved definition
     in any backend now fails its job by construction.

  2. No job executed a backend op. A new cpu-ubuntu job runs
     `test-backend-ops test -b CPU` (the filter is required - without it the
     tool skips the CPU device in test mode) with the ArifiLabs weight
     formats ON, so every fork op executes against the reference path. The
     test-quantize-fns step uses the same six-row baseline gate as the other
     jobs; pipefail so the test's status, not tail's, is the step's.

Upstream workflows untouched. Still compile-verified-not-benched, still
never run: the branch is not pushed.

WI: WI-1698
Lane: lane-210
---
 .github/workflows/arifi-backends-matrix.yml | 77 +++++++++++++++++++--
 1 file changed, 73 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/arifi-backends-matrix.yml b/.github/workflows/arifi-backends-matrix.yml
index fff4321061..cca3c9918a 100644
--- a/.github/workflows/arifi-backends-matrix.yml
+++ b/.github/workflows/arifi-backends-matrix.yml
@@ -20,6 +20,17 @@
 # Intel GPU, so nothing here executes a GPU kernel and nothing here is a benchmark.
 # A green run means "compile-verified, not benched" and must be reported that way.
 #
+# Link contract (lane-210 part 2): every job builds STATIC libraries and links
+# test-backend-ops. A shared libggml-cuda.so tolerates an undefined symbol at link
+# time (that is how WI-1699 - a declared, called, never-defined
+# ggml_cuda_moe_cache_mmv_fused - passed every gate for a day); a static link into
+# an executable does not. test-backend-ops pulls every backend entry point, so an
+# unresolved definition in any backend fails its job here, by construction.
+#
+# The cpu-ubuntu job is the one job that also RUNS test-backend-ops (-b CPU): every
+# op the fork adds or touches executes on the CPU backend against the reference
+# implementation, with the ArifiLabs weight formats ON.
+#
 # test-quantize-fns is BASELINED, not required to exit 0: it exits 1 on this fork
 # because six ROCmFPX rows fail, and those six are pre-existing (the rig's own
 # receipt on the same base reports them line for line). The step passes on zero
@@ -59,14 +70,71 @@ env:
   # every job compiles the ArifiLabs weight formats; see the header note
   ARIFI_CMAKE_COMMON: >-
     -DCMAKE_BUILD_TYPE=Release
+    -DBUILD_SHARED_LIBS=OFF
     -DGGML_NATIVE=OFF
     -DGGML_ARIFI_ROCMFPX_FORMATS=ON
     -DGGML_ARIFI_TURBO_WEIGHT_QUANTS=ON
     -DLLAMA_BUILD_EXAMPLES=OFF
     -DLLAMA_BUILD_TOOLS=OFF
     -DLLAMA_BUILD_TESTS=ON
+  # the two targets every job must compile AND link: the CPU quant test and the
+  # whole-backend entry-point puller
+  ARIFI_TARGETS: test-quantize-fns test-backend-ops
 
 jobs:
+  cpu-ubuntu:
+    name: CPU (compile + run test-backend-ops)
+    runs-on: ubuntu-24.04
+    timeout-minutes: 90
+    steps:
+      - uses: actions/checkout@v6
+
+      - name: Dependencies
+        run: sudo apt-get update && sudo apt-get install -y ninja-build cmake libssl-dev
+
+      - name: Configure + build
+        run: |
+          set -o pipefail
+          cmake -S . -B build -G Ninja \
+            ${ARIFI_CMAKE_COMMON} \
+            2>&1 | tee build-cpu.log
+          cmake --build build --target ${ARIFI_TARGETS} 2>&1 | tee -a build-cpu.log
+
+      - name: test-quantize-fns (CPU, baselined)
+        shell: bash
+        run: |
+          set -o pipefail
+          set +e
+          ./build/bin/test-quantize-fns 2>&1 | tee -a build-cpu.log
+          rc=${PIPESTATUS[0]}
+          set -e
+          # same gate as every other job: exactly the six banked ROCmFPX rows, or none
+          fails=$(grep -c 'FAILED' build-cpu.log || true)
+          echo "test-quantize-fns rc=$rc, FAILED rows=$fails (baseline 6)"
+          if [ "$rc" -eq 0 ] && [ "$fails" -eq 0 ]; then exit 0; fi
+          if [ "$rc" -eq 1 ] && [ "$fails" -eq 6 ]; then
+            echo "matches the banked ROCmFPX baseline - not a regression"; exit 0
+          fi
+          echo "REGRESSION: expected 0 or the baselined 6 failures, got $fails (rc $rc)"
+          exit 1
+
+      - name: test-backend-ops (CPU backend vs reference)
+        shell: bash
+        run: |
+          # -b CPU: without the filter test-backend-ops SKIPS the CPU device in test
+          # mode (tests/test-backend-ops.cpp, "Skipping CPU backend"). pipefail so the
+          # test's exit status - not tail's - is the step's.
+          set -o pipefail
+          ./build/bin/test-backend-ops test -b CPU 2>&1 | tee test-backend-ops-cpu.log | tail -n 40
+
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: arifi-build-log-cpu
+          path: |
+            build-cpu.log
+            test-backend-ops-cpu.log
+
   cuda-ubuntu:
     name: CUDA (compile only, no GPU)
     runs-on: ubuntu-24.04
@@ -90,7 +158,7 @@ jobs:
             -DCMAKE_CUDA_ARCHITECTURES=89-real \
             -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined \
             2>&1 | tee build-cuda.log
-          cmake --build build --target test-quantize-fns 2>&1 | tee -a build-cuda.log
+          cmake --build build --target ${ARIFI_TARGETS} 2>&1 | tee -a build-cuda.log
 
       - name: test-quantize-fns (CPU, baselined)
         shell: bash
@@ -149,7 +217,7 @@ jobs:
             -DGGML_METAL=ON \
             -DGGML_METAL_EMBED_LIBRARY=${{ matrix.embed }} \
             2>&1 | tee build-metal.log
-          cmake --build build --target test-quantize-fns 2>&1 | tee -a build-metal.log
+          cmake --build build --target ${ARIFI_TARGETS} 2>&1 | tee -a build-metal.log
 
       - name: test-quantize-fns (CPU, baselined)
         shell: bash
@@ -207,7 +275,7 @@ jobs:
             -DCMAKE_C_COMPILER=icx \
             -DCMAKE_CXX_COMPILER=icpx \
             2>&1 | tee build-sycl.log
-          cmake --build build --target test-quantize-fns 2>&1 | tee -a build-sycl.log
+          cmake --build build --target ${ARIFI_TARGETS} 2>&1 | tee -a build-sycl.log
 
       - name: test-quantize-fns (CPU, baselined)
         shell: bash
@@ -260,6 +328,7 @@ jobs:
         run: |
           cmake -S . -B build `
             -DCMAKE_BUILD_TYPE=Release `
+            -DBUILD_SHARED_LIBS=OFF `
             -DGGML_NATIVE=OFF `
             -DGGML_ARIFI_ROCMFPX_FORMATS=ON `
             -DGGML_ARIFI_TURBO_WEIGHT_QUANTS=ON `
@@ -267,7 +336,7 @@ jobs:
             -DLLAMA_BUILD_TOOLS=OFF `
             -DLLAMA_BUILD_TESTS=ON `
             -DGGML_VULKAN=ON 2>&1 | Tee-Object -FilePath build-vulkan.log
-          cmake --build build --config Release --target test-quantize-fns 2>&1 | Tee-Object -FilePath build-vulkan.log -Append
+          cmake --build build --config Release --target test-quantize-fns test-backend-ops 2>&1 | Tee-Object -FilePath build-vulkan.log -Append
 
       - name: test-quantize-fns (CPU, baselined)
         shell: pwsh
