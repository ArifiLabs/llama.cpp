From 8fb570d792788c4e2a22d918933a2d1a4b8d41ac Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Thu, 20 Aug 2026 20:48:45 -0400
Subject: [PATCH] escha vulkan: column-blocked escha_mm - one weight decode
 serves 4 columns (part 2)

Decoding a weight tile does not depend on the activation column, but the kernel gave each
workgroup exactly one column, so the ENTIRE weight matrix was re-decoded once per column.
Measured on a 780M: cost is strictly linear in ncols, 1.15 ms/col (escha2 5120x12288) and
2.12 ms/col (escha3 17408x5120). That redundancy is the prefill cost.

Each workgroup now stages ESCHA_COLS activation columns in shared memory and accumulates
one decoded weight against all of them, so the decode is paid once per column BLOCK.
Shared memory is C*512 bytes (2 kB at C=4, against 32 kB on this device) and the Hadamard
butterfly is fused across the C columns, so the barrier count does not depend on C.
Tail handling: loads are clamped and stores are gated on cc < ncols, so a ragged final
block never writes outside the real column range.

ESCHA_COLS=1 still compiles the original kernel; it is built as a second pipeline pair and
selected by GGML_VK_ESCHA_NO_MULTICOL for A/B, mirroring GGML_VK_DISABLE_TQ_SUBGROUP.

Committed before the GPU parity run per the F-124 standing rule; parity and the A/B numbers
follow on this build.

Origin: ArifiLabs (native)
Measured-effect: pending on this commit, before-numbers are 1.15 and 2.12 ms per column
Lane: lane-164
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp          | 21 ++++-
 .../ggml-vulkan/vulkan-shaders/escha_mm.comp  | 82 ++++++++++++++-----
 .../vulkan-shaders/vulkan-shaders-gen.cpp     |  5 ++
 tests/test-backend-ops.cpp                    | 10 ++-
 4 files changed, 90 insertions(+), 28 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 031da3a78..a6f65f941 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -1055,7 +1055,8 @@ struct vk_device_struct {
     vk_pipeline pipeline_topk_f32[num_topk_pipelines];
     vk_pipeline pipeline_sum_rows_f32;
     vk_pipeline pipeline_fwht_f32[4];
-    vk_pipeline pipeline_escha_mm[2]; // [0]=ESCHA2 (K=2), [1]=ESCHA3 (K=3) — lane-164
+    vk_pipeline pipeline_escha_mm[2];    // [0]=ESCHA2 (K=2), [1]=ESCHA3 (K=3) — lane-164
+    vk_pipeline pipeline_escha_mm_mc[2]; // same, multi-column (ESCHA_MM_COLS per workgroup)
     vk_pipeline pipeline_cumsum_f32;
     vk_pipeline pipeline_cumsum_small_f32;
     vk_pipeline pipeline_cumsum_multipass1_f32;
@@ -5992,6 +5993,8 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
     // ArifiLabs Escha-W2 fused linear (lane-164): portable shared-memory shader, fixed 128 threads
     ggml_vk_create_pipeline(device, device->pipeline_escha_mm[0], "escha_mm_k2_f32", escha_mm_k2_f32_len, escha_mm_k2_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
     ggml_vk_create_pipeline(device, device->pipeline_escha_mm[1], "escha_mm_k3_f32", escha_mm_k3_f32_len, escha_mm_k3_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
+    ggml_vk_create_pipeline(device, device->pipeline_escha_mm_mc[0], "escha_mm_k2_c4_f32", escha_mm_k2_c4_f32_len, escha_mm_k2_c4_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
+    ggml_vk_create_pipeline(device, device->pipeline_escha_mm_mc[1], "escha_mm_k3_c4_f32", escha_mm_k3_c4_f32_len, escha_mm_k3_c4_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
 
     const uint32_t cumsum_elem_per_thread = (device->vendor_id == VK_VENDOR_ID_AMD || device->vendor_id == VK_VENDOR_ID_INTEL) ? 2 : 4;
     ggml_vk_create_pipeline(device, device->pipeline_cumsum_f32,       "cumsum_f32", cumsum_f32_len, cumsum_f32_data, "main", 2, sizeof(vk_op_sum_rows_push_constants), {1, 1, 1}, { 256, device->subgroup_size, cumsum_elem_per_thread }, 1, true, true, device->subgroup_size);
@@ -10368,7 +10371,17 @@ static void ggml_vk_escha_mm(ggml_backend_vk_context * ctx, vk_context& subctx,
     const uint32_t n_out = (uint32_t) src0->ne[1];
     const uint32_t ncols = (uint32_t) (src1->ne[1] * src1->ne[2] * src1->ne[3]);
 
-    vk_pipeline pipeline = ctx->device->pipeline_escha_mm[src0->type == GGML_TYPE_ESCHA3 ? 1 : 0];
+    // Columns served by one workgroup. The weight decode dominates and does not depend on the
+    // column, so blocking columns divides the decode cost by this factor; the knob keeps the
+    // original one-column kernel reachable for A/B (lane-163 precedent).
+    // Keep in sync with the ESCHA_COLS define for the _mc pipelines in vulkan-shaders-gen.cpp.
+    constexpr uint32_t ESCHA_MM_COLS = 4;
+    static const bool no_multicol = getenv("GGML_VK_ESCHA_NO_MULTICOL") != nullptr;
+
+    const int kidx = src0->type == GGML_TYPE_ESCHA3 ? 1 : 0;
+    vk_pipeline pipeline = no_multicol ? ctx->device->pipeline_escha_mm[kidx]
+                                       : ctx->device->pipeline_escha_mm_mc[kidx];
+    const uint32_t cols_per_wg = no_multicol ? 1 : ESCHA_MM_COLS;
     GGML_ASSERT(pipeline != nullptr);
 
     ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
@@ -10398,14 +10411,14 @@ static void ggml_vk_escha_mm(ggml_backend_vk_context * ctx, vk_context& subctx,
     // per column, so raise it only from a measured ncols curve (test-backend-ops perf -o ESCHA_MM).
     constexpr uint32_t COLS_PER_DISPATCH = 32;
 
-    const std::array<uint32_t, 3> elements = { wg_x, std::min(ncols, COLS_PER_DISPATCH), 1 };
+    const std::array<uint32_t, 3> elements = { wg_x, CEIL_DIV(std::min(ncols, COLS_PER_DISPATCH), cols_per_wg), 1 };
     ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { a_buf, b_buf, aux_buf, dst_buf }, pc, elements);
 
     for (uint32_t off = COLS_PER_DISPATCH; off < ncols; off += COLS_PER_DISPATCH) {
         pc.col_offset = off;
         subctx->s->buffer->buf.pushConstants(pipeline->layout, vk::ShaderStageFlagBits::eCompute,
                                              0, sizeof(pc), &pc);
-        subctx->s->buffer->buf.dispatch(wg_x, std::min(COLS_PER_DISPATCH, ncols - off), 1);
+        subctx->s->buffer->buf.dispatch(wg_x, CEIL_DIV(std::min(COLS_PER_DISPATCH, ncols - off), cols_per_wg), 1);
     }
 }
 
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
index 44f1a2e8a..c70661caf 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
@@ -7,9 +7,19 @@
 //   y = D(rout*s_out) * H128( decode(codes)^T * H128(D(rin*s_in) * x) ) + bias
 //
 // One workgroup = one 128-channel output block (8 adjacent 16x16 code tiles per
-// in-block) for one activation column. Thread j owns output channel ob*128+j.
-// The activation block is staged + Hadamard-transformed in shared memory
-// (portable barriers version; the lane-163 subgroup butterfly is an upgrade path).
+// in-block) for a BLOCK of ESCHA_COLS activation columns. Thread j owns output
+// channel ob*128+j. The activation blocks are staged + Hadamard-transformed in
+// shared memory (portable barriers version; the lane-163 subgroup butterfly is an
+// upgrade path).
+//
+// ESCHA_COLS (lane-164 part 2): decoding a weight tile does not depend on the
+// activation column, but the original kernel gave each workgroup exactly one column
+// and so re-decoded the ENTIRE weight matrix once per column - prefill paid the whole
+// decode ncols times. Staging C columns lets one decode serve C accumulators, so the
+// decode cost falls ~C-fold; only the far cheaper staging, Hadamard and LDS reads
+// scale with C. Shared memory is C*512 bytes and the butterfly is fused across the C
+// columns, so the barrier count does not depend on C. ESCHA_COLS=1 reproduces the
+// original kernel exactly and is kept as the A/B arm.
 //
 // Decode math is the recovered cbA generator (Terra-64, trial-evidence/escha-decoder):
 // deterministic-by-spec here — integer ops, unpackHalf2x16 (exact), one f32 add
@@ -19,6 +29,11 @@
 
 layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
 
+#ifndef ESCHA_COLS
+#define ESCHA_COLS 1
+#endif
+#define NC (ESCHA_COLS)
+
 layout (push_constant) uniform parameter {
     uint n_in;
     uint n_out;
@@ -32,7 +47,7 @@ layout (binding = 1) readonly  buffer B { float data_b[]; };  // x [n_in, ncols]
 layout (binding = 2) readonly  buffer C { float data_c[]; };  // aux: rin | rout | bias
 layout (binding = 3) writeonly buffer D { float data_d[]; };  // y [n_out, ncols]
 
-shared float sh[128];
+shared float sh[NC][128];
 
 const float INV_SQRT128 = 0.08838834764831845;
 
@@ -88,12 +103,18 @@ uint shr64_32(uint lo, uint hi, uint s) {
     return hi >> (s - 32u);
 }
 
+// one butterfly over all NC staged columns; 2 barriers per step regardless of NC
 void hadamard128(uint tid) {
     [[unroll]] for (uint step = 1u; step < 128u; step <<= 1u) {
-        const float a = sh[tid];
-        const float o = sh[tid ^ step];
+        float a[NC], o[NC];
+        [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+            a[cj] = sh[cj][tid];
+            o[cj] = sh[cj][tid ^ step];
+        }
         barrier();
-        sh[tid] = ((tid & step) == 0u) ? (a + o) : (o - a);
+        [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+            sh[cj][tid] = ((tid & step) == 0u) ? (a[cj] + o[cj]) : (o[cj] - a[cj]);
+        }
         barrier();
     }
 }
@@ -101,7 +122,7 @@ void hadamard128(uint tid) {
 void main() {
     const uint tid  = gl_LocalInvocationID.x;
     const uint ob   = gl_WorkGroupID.x;      // output 128-block
-    const uint col  = p.col_offset + gl_WorkGroupID.y; // activation column (dispatch is chunked)
+    const uint col0 = p.col_offset + gl_WorkGroupID.y * NC; // first column of this block
     const uint ot   = ob * 8u + (tid >> 4u); // this thread's out tile
     const uint tcol = tid & 15u;             // column within the tile
 
@@ -111,12 +132,20 @@ void main() {
     // col >= 8 was produced by components c in 0..3; col < 8 by c in 4..7
     const uint c0      = (tcol >= 8u) ? 0u : 4u;
 
-    float acc = 0.0;
+    float acc[NC];
+    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+        acc[cj] = 0.0;
+    }
 
     const uint n_ib = p.n_in / 128u;
     for (uint ib = 0u; ib < n_ib; ++ib) {
-        const uint gi = ib * 128u + tid;
-        sh[tid] = data_b[col * p.n_in + gi] * data_c[gi];
+        const uint  gi  = ib * 128u + tid;
+        const float rin = data_c[gi];
+        [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+            // clamp the tail: those lanes recompute a duplicate column that is never stored
+            const uint cc = min(col0 + cj, p.ncols - 1u);
+            sh[cj][tid] = data_b[cc * p.n_in + gi] * rin;
+        }
         barrier();
         hadamard128(tid);
         // fold the input-side 1/sqrt(128): sh is read-only below, scale at use
@@ -134,8 +163,11 @@ void main() {
                 const uint word = shr64_32(data_a[base + pw], data_a[base + qw], ((lane & 1u) == 0u) ? 16u : 0u);
                 [[unroll]] for (uint k = 0u; k < 4u; ++k) {
                     const uint c   = c0 + k;
-                    const uint row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
-                    acc += sh[t*16u + row] * escha_F((word >> (2u*c)) & 0xFFFFu);
+                    const uint  row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
+                    const float w   = escha_F((word >> (2u*c)) & 0xFFFFu); // decoded ONCE for all NC columns
+                    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+                        acc[cj] += sh[cj][t*16u + row] * w;
+                    }
                 }
 #else
                 // K=3 crossed 96-byte bitstream (PTX lines 2282-2312)
@@ -152,8 +184,11 @@ void main() {
                 [[unroll]] for (uint k = 0u; k < 4u; ++k) {
                     const uint c   = c0 + k;
                     const uint row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
-                    const uint win = (c < 4u) ? (pp >> (3u*c)) : (rr >> (3u*(c - 4u)));
-                    acc += sh[t*16u + row] * escha_F(win & 0xFFFFu);
+                    const uint  win = (c < 4u) ? (pp >> (3u*c)) : (rr >> (3u*(c - 4u)));
+                    const float w   = escha_F(win & 0xFFFFu);              // decoded ONCE for all NC columns
+                    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+                        acc[cj] += sh[cj][t*16u + row] * w;
+                    }
                 }
 #endif
             }
@@ -162,11 +197,18 @@ void main() {
     }
 
     // output-side transform + scales + bias; both 1/sqrt(128) factors fold here
-    sh[tid] = acc;
+    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+        sh[cj][tid] = acc[cj];
+    }
     barrier();
     hadamard128(tid);
-    const uint oc = ob * 128u + tid;
-    const float yv = sh[tid] * (INV_SQRT128 * INV_SQRT128) * data_c[p.n_in + oc]
-                   + data_c[p.n_in + p.n_out + oc];
-    data_d[col * p.n_out + oc] = yv;
+    const uint  oc   = ob * 128u + tid;
+    const float rout = data_c[p.n_in + oc];
+    const float bias = data_c[p.n_in + p.n_out + oc];
+    [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+        const uint cc = col0 + cj;
+        if (cc < p.ncols) {   // tail guard: never store outside the real column range
+            data_d[cc * p.n_out + oc] = sh[cj][tid] * (INV_SQRT128 * INV_SQRT128) * rout + bias;
+        }
+    }
 }
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
index ce6bf19b1..7e5415a89 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
@@ -1207,8 +1207,13 @@ void process_shaders() {
     string_to_spv("fwht_shmem_f32", "fwht.comp", {{"FWHT_SHMEM", "1"}});
 
     // ArifiLabs Escha-W2 fused linear (lane-164)
+    // C=1 arm: byte-identical to the original one-column-per-workgroup kernel, kept for A/B
     string_to_spv("escha_mm_k2_f32", "escha_mm.comp", {{"ESCHA_K", "2"}});
     string_to_spv("escha_mm_k3_f32", "escha_mm.comp", {{"ESCHA_K", "3"}});
+    // multi-column arm: one weight decode serves ESCHA_MM_COLS columns (keep in sync with
+    // ESCHA_MM_COLS in ggml-vulkan.cpp)
+    string_to_spv("escha_mm_k2_c4_f32", "escha_mm.comp", {{"ESCHA_K", "2"}, {"ESCHA_COLS", "4"}});
+    string_to_spv("escha_mm_k3_c4_f32", "escha_mm.comp", {{"ESCHA_K", "3"}, {"ESCHA_COLS", "4"}});
     string_to_spv("count_equal_i32", "count_equal.comp", merge_maps(base_dict, {{"A_TYPE", "int"}, {"B_TYPE", "int"}, {"D_TYPE", "int"}}));
     string_to_spv("cumsum_f32", "cumsum.comp", merge_maps(base_dict, {{"A_TYPE", "float"}, {"D_TYPE", "float"}}));
     string_to_spv("cumsum_multipass1_f32", "cumsum_multipass1.comp", merge_maps(base_dict, {{"A_TYPE", "float"}, {"D_TYPE", "float"}}));
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 33b48bbdb..28a33b574 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10818,10 +10818,12 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     std::vector<std::unique_ptr<test_case>> test_cases;
 
     // ArifiLabs Escha-W2 fused linear (lane-164): real 27B projection shapes across the
-    // decode->prefill ncols range. One workgroup per (output 128-block, column), so cost is
-    // linear in ncols and a single dispatch at prefill batch is ~1000x a decode dispatch —
-    // which is what puts it against the GPU watchdog (F-124). Measure it, don't infer it.
-    for (int64_t ncols : {1, 8, 64, 256, 512, 1024, 2048}) {
+    // decode->prefill ncols range. Cost is strictly linear in ncols (measured on a 780M:
+    // 1.15 us*1000/col for escha2 5120x12288, 2.12 for escha3 17408x5120, from ncols 1/8/64),
+    // which is what put an unguarded ncols=2048 dispatch at ~4.3 s, past the GPU watchdog
+    // (F-124). 1/8/64 pins the per-column slope in ~5 min; larger ncols adds no information
+    // and costs hours, because n_runs is sized from bytes moved, not from decode work.
+    for (int64_t ncols : {1, 8, 64}) {
         test_cases.emplace_back(new test_escha_mm(GGML_TYPE_ESCHA2, 5120, 12288, ncols));
         test_cases.emplace_back(new test_escha_mm(GGML_TYPE_ESCHA3, 17408, 5120, ncols));
     }
