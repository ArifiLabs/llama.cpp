From 51b205a44407a68cba48c0cdc35e5989ebd7e02c Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Tue, 18 Aug 2026 10:16:23 -0400
Subject: [PATCH] repo-env.json (WI-1540 tail): the engine repo's env manifest
 - PowerShell-only law (F-107), three-flag configure (F-111), cmd.exe
 redirection (F-108), type-id FLAG E, series discipline, runbook pointer

---
 repo-env.json | 41 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)
 create mode 100644 repo-env.json

diff --git a/repo-env.json b/repo-env.json
new file mode 100644
index 000000000..dc4cc943f
--- /dev/null
+++ b/repo-env.json
@@ -0,0 +1,41 @@
+{
+  "repo": "C:/ArifiLabs/research/local-inference/src/arifilabs-llama.cpp (ArifiLabs llama.cpp fork — canonical branch arifi/main)",
+  "python": "C:/ArifiLabs/shared/.venv/Scripts/python.exe",
+  "module_namespace": "arifi_core.* (company tooling); in-repo tooling = tools/arifi-sync/arifi_sync.py",
+  "shell_law": {
+    "shell": "powershell",
+    "why": "F-107: Git Bash /mingw64/bin shadows the WinLibs runtime DLLs — vulkan-shaders-gen.exe dies 0xC0000139 while the wrapper reports exit 0. Engine builds run from PowerShell ONLY."
+  },
+  "build": {
+    "configure_flags": ["-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DGGML_VULKAN=ON", "-DGGML_ARIFI_ROCMFPX_FORMATS=ON", "-DGGML_ARIFI_TURBO_WEIGHT_QUANTS=ON", "-DCMAKE_C_FLAGS=-D_WIN32_WINNT=0x0A00", "-DCMAKE_CXX_FLAGS=-D_WIN32_WINNT=0x0A00"],
+    "targets": ["llama-cli", "llama-server", "llama-quantize", "test-backend-ops", "test-quantize-fns"],
+    "parallel_note": "-j2 and not more: Vulkan shader generation is memory-hungry; a wider build dies on this unified-memory box (mul_mm shader RAM class). F-111: all three flag groups load-bearing — ROCMFPX_FORMATS, TURBO_WEIGHT_QUANTS, and _WIN32_WINNT=0x0A00 in BOTH C and CXX."
+  },
+  "gotchas": [
+    {
+      "rule": "Build success = artifact on disk + exe MTIME moved, never a wrapper's exit 0. Two builds in one lane 'succeeded' with binaries unchanged.",
+      "source_row": "registers/failure-ledger.jsonl#F-107"
+    },
+    {
+      "rule": "Native tool output (llama-cli etc.) is logged via cmd.exe /c \"... > f 2>&1\" — PowerShell *> silently drops native stderr and fakes a crash.",
+      "source_row": "registers/failure-ledger.jsonl#F-108"
+    },
+    {
+      "rule": "docs/TYPE-ID-ALLOCATION.md is BINDING on type ids. FLAG E (lane-143): turboquant TURBO2_0=43 vs our Q2_0_G128=43 is byte-identical and silent-capable — OUR ids always; the lane-149 build-time constant guard enforces the GLSL side.",
+      "source_row": "board/programs/local-inference/lanes/2026-08-17-lane-143-REPORT.md (FLAG table)"
+    },
+    {
+      "rule": "Series discipline: patches/ is generated by tools/arifi-sync (`series regen` + `series check` exit 0). Never hand-edit patches. arifi/main stays flat, ZERO merges.",
+      "source_row": "tools/arifi-sync/sources.json (_ref_comment) + UPDATE-RUNBOOK.md"
+    },
+    {
+      "rule": "Update procedure = UPDATE-RUNBOOK.md in this repo, proven live twice (lane-152 upstream bump, lane-153 restage). Fix the runbook in the same commit as any workaround.",
+      "source_row": "UPDATE-RUNBOOK.md"
+    },
+    {
+      "rule": "Any model launch: CC_RUN_ANNOUNCE + ARIFI_GPU_RESIDENT_FLOOR_GB default 7.0 (President floor ruling, register amendment 82c3d85d), one model at a time.",
+      "source_row": "registers (floor ruling, 2026-08-17)"
+    }
+  ],
+  "updated": {"date": "2026-08-18", "author": "hq-seat-35 59c22564 (WI-1540 tail: authored by the WI-1540 builder, reconstructed from F-107/F-108/F-111 + UPDATE-RUNBOOK.md and committed here)"}
+}
