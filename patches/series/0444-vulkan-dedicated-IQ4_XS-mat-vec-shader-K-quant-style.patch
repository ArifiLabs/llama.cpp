From 2c63e919793508e12fd886f0818cb1eed35f19db Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Wed, 2 Sep 2026 19:52:28 -0400
Subject: [PATCH] vulkan: dedicated IQ4_XS mat-vec shader (K-quant style, 16
 threads per superblock) + the 17408x5120 perf rows for test-backend-ops
 (lane-209 rank 5; gates run next)

Conflict-resolved: S1 HOT SPOT IQ4_XS: add/add of mul_mat_vec_iq4_xs.comp vs upstream df750f76b (8 threads/superblock, +6-17% RDNA4 claim); kept OUR lane-209 16-thread K-quant-style shader (measured on the 780M, and the R75 decider series builds on it); upstream's shader body is NOT carried - owed A/B upstream-vs-ours on the rig; gen line = upstream (iq4_xs + tq1_0) with our comment
---
 .../vulkan-shaders/mul_mat_vec_iq4_xs.comp    | 103 ++++++++++--------
 .../vulkan-shaders/vulkan-shaders-gen.cpp     |   1 +
 tests/test-backend-ops.cpp                    |   9 ++
 3 files changed, 69 insertions(+), 44 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_iq4_xs.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_iq4_xs.comp
index a2b99d9ab1..e3ad9f286c 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_iq4_xs.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_iq4_xs.comp
@@ -1,72 +1,87 @@
 #version 450
 
 #extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
 
 #include "mul_mat_vec_base.glsl"
 
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
-FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
+// arifi lane-209: dedicated IQ4_XS mat-vec, K-quant style (mirrors mul_mat_vec_q4_k.comp).
+//
+// Before this shader IQ4_XS ran the generic mul_mat_vec.comp: each thread took 8 consecutive k of a
+// 256-block and called dequantize4() twice, which re-decoded the sub-block scale each call, loaded
+// the scales as separate byte/u16 loads, and used only ONE nibble half of each packed32 qs word (the
+// other half was fetched again by the thread 16 positions away). On the 780M that path ran at
+// 58-78% of the box's best mat-vec rate at n=1 while q4_K's dedicated shader ran at 96-100%
+// (lane-204 census, CENSUS-TABLE.txt).
+//
+// Here 16 threads share a 256-superblock: thread itid takes sub-block ib32 = itid/2 and byte-half
+// h = itid%2 -> two packed32 words -> 8 low-nibble values (k = 32*ib32 + 8h + 0..7) and 8
+// high-nibble values (k = 32*ib32 + 16 + 8h + 0..7): 16 MACs per row per superblock from 2 word
+// loads, one scale decode per row per superblock. The value order is the one dequant_funcs.glsl
+// uses (value k < 16 = low nibble of byte k, value 16+k = high nibble of byte k).
 
-// dedicated iq4_xs mat-vec, mirrors mul_mat_vec_iq3_s.comp
-// one packed32 word per l, so the 6-bit subblock scale is hoisted to a single fma after register accumulation
+FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
 
-void calc_superblock(const uint a_offset, const uint b_offset, const uint ib32, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
-    const uint y_idx = i * QUANT_K + 32 * ib32;
+void calc_superblock(const uint a_offset, const uint b_offset, const uint ib32, const uint q_offset, const uint y_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
+    const uint y1_idx = i * QUANT_K + y_offset;   // low-nibble values
+    const uint y2_idx = y1_idx + 16;              // high-nibble values
 
-    uint ibi = a_offset + first_row * num_blocks_per_row + i;
     [[unroll]] for (uint n = 0; n < num_rows; ++n) {
-        const float d = float(data_a[ibi].d);
-        const uint sl = (data_a[ibi].scales_l[ib32/2] >> (4 * (ib32 & 1))) & 0xF;
-        const uint sh = (data_a[ibi].scales_h >> (2 * ib32)) & 3;
-        const float dscale = d * float(int(sl | (sh << 4)) - 32);
+        const uint ib = a_offset + (first_row + n) * num_blocks_per_row + i;
 
-        FLOAT_TYPE sum[NUM_COLS];
-        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
-            sum[j] = FLOAT_TYPE(0);
-        }
+        const FLOAT_TYPE d = FLOAT_TYPE(data_a[ib].d);
+        // scales_l is 4 bytes = 8 nibbles, nibble ib32 sits at bit 4*ib32 of the packed32 word
+        const uint sl = (data_a_packed32[ib].scales_l >> (4 * ib32)) & 0xF;
+        const uint sh = (data_a[ib].scales_h >> (2 * ib32)) & 3;
+        const FLOAT_TYPE dl = d * FLOAT_TYPE(int(sl | (sh << 4)) - 32);
 
-        [[unroll]] for (uint l = 0; l < 4; ++l) {
-            const uint w = data_a_packed32[ibi].qs[4 * ib32 + l];
-            const u8vec4 q0 = unpack8(w & 0x0F0F0F0F);
-            const u8vec4 q1 = unpack8((w >> 4) & 0x0F0F0F0F);
-
-            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
-                const vec4 b0 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + l]);
-                const vec4 b1 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 4 + l]);
-
-                sum[j] = fma(FLOAT_TYPE(b0.x), FLOAT_TYPE(kvalues_iq4nl[q0.x]),
-                        fma(FLOAT_TYPE(b0.y), FLOAT_TYPE(kvalues_iq4nl[q0.y]),
-                        fma(FLOAT_TYPE(b0.z), FLOAT_TYPE(kvalues_iq4nl[q0.z]),
-                        fma(FLOAT_TYPE(b0.w), FLOAT_TYPE(kvalues_iq4nl[q0.w]),
-                        fma(FLOAT_TYPE(b1.x), FLOAT_TYPE(kvalues_iq4nl[q1.x]),
-                        fma(FLOAT_TYPE(b1.y), FLOAT_TYPE(kvalues_iq4nl[q1.y]),
-                        fma(FLOAT_TYPE(b1.z), FLOAT_TYPE(kvalues_iq4nl[q1.z]),
-                        fma(FLOAT_TYPE(b1.w), FLOAT_TYPE(kvalues_iq4nl[q1.w]),
-                        sum[j]))))))));
-            }
-        }
+        const uint32_t q0_u32 = data_a_packed32[ib].qs[q_offset];
+        const uint32_t q1_u32 = data_a_packed32[ib].qs[q_offset + 1];
+
+        const u8vec4 q0_lo = unpack8(q0_u32 & 0x0F0F0F0F);
+        const u8vec4 q1_lo = unpack8(q1_u32 & 0x0F0F0F0F);
+        const u8vec4 q0_hi = unpack8((q0_u32 >> 4) & 0x0F0F0F0F);
+        const u8vec4 q1_hi = unpack8((q1_u32 >> 4) & 0x0F0F0F0F);
+
+        const vec4 v0 = vec4(kvalues_iq4nl[q0_lo.x], kvalues_iq4nl[q0_lo.y], kvalues_iq4nl[q0_lo.z], kvalues_iq4nl[q0_lo.w]);
+        const vec4 v1 = vec4(kvalues_iq4nl[q1_lo.x], kvalues_iq4nl[q1_lo.y], kvalues_iq4nl[q1_lo.z], kvalues_iq4nl[q1_lo.w]);
+        const vec4 v2 = vec4(kvalues_iq4nl[q0_hi.x], kvalues_iq4nl[q0_hi.y], kvalues_iq4nl[q0_hi.z], kvalues_iq4nl[q0_hi.w]);
+        const vec4 v3 = vec4(kvalues_iq4nl[q1_hi.x], kvalues_iq4nl[q1_hi.y], kvalues_iq4nl[q1_hi.z], kvalues_iq4nl[q1_hi.w]);
 
         [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
-            temp[j][n] = fma(dscale, sum[j], temp[j][n]);
+            const vec4 by10 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y1_idx) / 4    ]);
+            const vec4 by11 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y1_idx) / 4 + 1]);
+            const vec4 by20 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y2_idx) / 4    ]);
+            const vec4 by21 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y2_idx) / 4 + 1]);
+
+            const FLOAT_TYPE sum = fma(FLOAT_TYPE(by10.x), v0.x, fma(FLOAT_TYPE(by10.y), v0.y, fma(FLOAT_TYPE(by10.z), v0.z, fma(FLOAT_TYPE(by10.w), v0.w,
+                                   fma(FLOAT_TYPE(by11.x), v1.x, fma(FLOAT_TYPE(by11.y), v1.y, fma(FLOAT_TYPE(by11.z), v1.z, fma(FLOAT_TYPE(by11.w), v1.w,
+                                   fma(FLOAT_TYPE(by20.x), v2.x, fma(FLOAT_TYPE(by20.y), v2.y, fma(FLOAT_TYPE(by20.z), v2.z, fma(FLOAT_TYPE(by20.w), v2.w,
+                                   fma(FLOAT_TYPE(by21.x), v3.x, fma(FLOAT_TYPE(by21.y), v3.y, fma(FLOAT_TYPE(by21.z), v3.z, FLOAT_TYPE(by21.w) * v3.w)))))))))))))));
+            temp[j][n] = fma(dl, sum, temp[j][n]);
         }
-
-        ibi += num_blocks_per_row;
     }
 }
 
 void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
     uint a_offset, b_offset, d_offset;
-
     get_offsets(a_offset, b_offset, d_offset);
 
     const uint num_blocks_per_row = p.ncols / QUANT_K;
 
-    // 8 threads are used to process each block
-    const uint blocks_per_wg = gl_WorkGroupSize.x/8;
+    // 16 threads are used to process each block
+    const uint it_size = gl_WorkGroupSize.x/16;
     const uint tid = gl_LocalInvocationID.x;
-    const uint itid = tid % 8;  // 0...7
-    const uint ix = tid / 8;
+    const uint itid = tid%16;  // 0...15
+    const uint ix = tid/16;
+
+    const uint ib32 = itid / 2;                     // sub-block 0...7 (32 values each)
+    const uint h    = itid % 2;                     // byte half of the sub-block's 16 qs bytes
+    const uint q_offset = 4*ib32 + 2*h;             // packed32 word index of the first of this thread's 2 words
+    const uint y_offset = 32*ib32 + 8*h;            // k of this thread's first low-nibble value
 
     [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
         [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
@@ -74,8 +89,8 @@ void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
         }
     }
 
-    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
-        calc_superblock(a_offset, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);
+    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += it_size)
+        calc_superblock(a_offset, b_offset, ib32, q_offset, y_offset, i, num_blocks_per_row, first_row, num_rows);
 
     reduce_result(temp, d_offset, first_row, num_rows, tid);
 }
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
index 014dbeded3..0232bba404 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
@@ -854,6 +854,7 @@ void process_shaders() {
     for (const auto& tname : type_names) {
         // mul mat vec
         std::string data_a_key = "DATA_A_" + to_uppercase(tname);
+        // arifi lane-209: iq4_xs gets a dedicated K-quant-style shader (mul_mat_vec_iq4_xs.comp)
         std::string shader = (string_ends_with(tname, "_k") || string_starts_with(tname, "iq1_") || string_starts_with(tname, "iq2_") || string_starts_with(tname, "iq3_") || tname == "iq4_xs" || tname == "tq2_0" || tname == "tq1_0") ? "mul_mat_vec_" + tname + ".comp" : "mul_mat_vec.comp";
 
         string_to_spv("mul_mat_vec_" + tname + "_f32_f32", shader, merge_maps(base_dict, {{data_a_key, "1"}, {"B_TYPE", "float"}, {"B_TYPEV2", "vec2"}, {"B_TYPEV4", "vec4"}, {"D_TYPE", "float"}}));
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 35e6ab40e5..018938dd8f 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -12140,6 +12140,15 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
         }
     }
 
+    // ArifiLabs lane-209: the 27B ffn row (17408x5120) at the plain / DFlash2-verify widths, for the types the
+    // seat and the Unleashed quality winners actually carry there (q4_K = the yardstick shader at 96-100% of
+    // best on the 780M). `-p "m=17408"` narrows perf to these 24 rows.
+    for (int bs : {1, 2, 3, 4, 5, 8}) {
+        for (ggml_type type_a : {GGML_TYPE_Q4_K, GGML_TYPE_IQ4_XS, GGML_TYPE_IQ3_S, GGML_TYPE_Q4_0_ROCMFP4_FAST}) {
+            test_cases.emplace_back(new test_mul_mat(type_a, GGML_TYPE_F32, 17408, bs, 5120, {1,  1}, {1, 1}));
+        }
+    }
+
     // qwen3-30b-a3b
     for (int bs : {1, 4, 8, 32, 64, 128, 256, 512}) {
         for (ggml_type type_a : {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_Q4_0, GGML_TYPE_Q8_0, GGML_TYPE_Q4_K, GGML_TYPE_Q6_K, GGML_TYPE_IQ2_XS, GGML_TYPE_IQ4_XS}) {
