diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q5_k.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q5_k.comp
index 54d7e1bcd..b1dd195aa 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q5_k.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q5_k.comp
@@ -6,112 +6,175 @@
 
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
+// ArifiLabs lane-234 R48 - ACTIVATION HOIST.
+//
+// The weight decode of this shader was already shared across NUM_COLS columns upstream. The
+// ACTIVATION side was not: with the row loop outermost, the eight vec2 loads of data_b were
+// issued num_rows times per superblock per column, for bytes that do not depend on the row.
+// Arm 1 loads each activation vector once per superblock and reuses it across all rows, so the
+// term that grows with the batch width is divided by NUM_ROWS while the weight term is untouched.
+//
+// Both arms call the same decode_superblock() and the same accumulate_column(): the fma chains,
+// their operand order and the accumulation order into temp[j][n] are one piece of code, so the
+// two arms are bit-identical by construction and this is a scheduling change only.
+//
+// Gated by specialization constant 3 so ONE binary serves both arms:
+//   1 (default) = activation hoisted        0 = the shipped loop order, byte for byte.
+// The host reads GGML_ARIFI_Q5K_B_HOIST=0 to build the pipelines with 0. The opt-out is
+// load-bearing: the hoisted arm holds NUM_ROWS rows of decoded weights live across the column
+// loop, and lane-230 measured that shape spilling on this device class.
+layout (constant_id = 3) const uint ARIFI_Q5K_B_HOIST = 1;
+
 FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
 
+// Verbatim lift of the shipped per-row decode. No expression below was rewritten; the only change
+// is that the eight sc* and sixteen q4_* locals are written into caller-supplied arrays.
+void decode_superblock(const uint a_offset, const uint v_im, const uint l0, const uint q_offset, const uint i, const uint num_blocks_per_row, const uint row, out FLOAT_TYPEV2 dm, out FLOAT_TYPE sc[8], out FLOAT_TYPE q4[16]) {
+    const uint ib = a_offset + row*num_blocks_per_row + i;
+
+    dm = FLOAT_TYPEV2(data_a[ib].dm);
+
+    const uint32_t scale0_u32 = data_a_packed16[ib].scales[v_im    ];
+    const uint32_t scale4_u32 = data_a_packed16[ib].scales[v_im + 2];
+    const uint32_t scale8_u32 = data_a_packed16[ib].scales[v_im + 4];
+
+    const uint32_t scale_0_4_l = (scale4_u32 << 16) | scale0_u32;
+    const uint32_t scale_0_4_h = (scale_0_4_l & 0xC0C0C0C0) >> 2;
+    const vec4 scale_0_4_l_f = vec4(unpack8(scale_0_4_l & 0x3F3F3F3F));
