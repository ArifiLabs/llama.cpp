From b6cd445ffd7804553e97deb5943e1681d5ec225e Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Thu, 8 Oct 2026 05:01:16 -0400
Subject: [PATCH] lane-298: kv-zero fills batched into one Vulkan submit + one
 fence per apply

zero_stale_cells issued one ggml_backend_tensor_memset per (attention layer, K/V, run); on a buffer that is not
host-visible (KV under the UMA device-local-first placement) each one is a synchronous fillBuffer + submit +
waitForFences. The v0.1.3.1 gate showed point prefill a little slower than v0.1.3.0, short prompts most (Q57).

The Vulkan backend now exports ggml_backend_vk_memset_batch (reg proc address). Between begin and end, every
GPU-path ggml_vk_buffer_memset on the calling thread records its fill into one transfer command buffer per device
(device mutex held); the end submits once and waits once. Same fills, same queue, same bytes, so F-141 holds.
The KV cache uses it inside zero_stale_cells when V is not transposed (the set_2d upload of transposed V shares
the transfer command pool, so that path keeps per-call submits). The kv-zero log line gains 'batched 0/1'.
GGML_VK_MEMSET_BATCH=0 restores one submit per fill.

Origin: lane-298
Measured-effect: UNMEASURED (build + smoke + prefill re-cut queued; receipts cells/kvzb-*)
---
 ggml/src/ggml-vulkan/ggml-vulkan-buffers.cpp | 50 ++++++++++++++++++++
 ggml/src/ggml-vulkan/ggml-vulkan-common.h    |  1 +
 ggml/src/ggml-vulkan/ggml-vulkan.cpp         | 11 ++++-
 src/llama-kv-cache.cpp                       | 26 +++++++++-
 4 files changed, 86 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-buffers.cpp b/ggml/src/ggml-vulkan/ggml-vulkan-buffers.cpp
index 54254bbc4a..0c79f61e31 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan-buffers.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-buffers.cpp
@@ -1650,6 +1650,38 @@ void ggml_vk_buffer_memset_async(vk_context& ctx, vk_buffer& dst, size_t offset,
     ctx->s->buffer->buf.fillBuffer(dst->buffer, offset, size, c);
 }
 
+// lane-298: memset batch. Between ggml_vk_memset_batch(true) and (false) every GPU-path ggml_vk_buffer_memset on this
+// thread records its fill into ONE transfer command buffer per device (device mutex held for the batch); the end submits
+// once and waits once. Same fills, same queue, same bytes; only the per-fill submit + fence wait goes.
+// GGML_VK_MEMSET_BATCH=0 = one submit per fill (the v0.1.3.0 path).
+struct vk_memset_batch_entry {
+    vk_device  device;
+    vk_context ctx;
+};
+static thread_local bool g_vk_memset_batch_on = false;
+static thread_local std::vector<vk_memset_batch_entry> g_vk_memset_batch;
+
+void ggml_vk_memset_batch(bool begin) {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_VK_MEMSET_BATCH");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    if (begin) {
+        g_vk_memset_batch_on = enabled;
+        return;
+    }
+    g_vk_memset_batch_on = false;
+    for (auto & b : g_vk_memset_batch) {
+        ggml_vk_ctx_end(b.ctx);
+        ggml_vk_submit(b.ctx, b.device->fence);
+        VK_CHECK(b.device->device.waitForFences({ b.device->fence }, true, UINT64_MAX), "vk_memset_batch waitForFences", b.device);
+        b.device->device.resetFences({ b.device->fence });
+        ggml_vk_queue_command_pools_cleanup(b.device);
+        b.device->mutex.unlock();
+    }
+    g_vk_memset_batch.clear();
+}
+
 void ggml_vk_buffer_memset(vk_buffer& dst, size_t offset, uint32_t c, size_t size) {
     VK_LOG_DEBUG("ggml_vk_buffer_memset(" << offset << ", " << c << ", " << size << ")");
 
@@ -1659,6 +1691,24 @@ void ggml_vk_buffer_memset(vk_buffer& dst, size_t offset, uint32_t c, size_t siz
         return;
     }
 
+    if (g_vk_memset_batch_on) {
+        vk_memset_batch_entry * b = nullptr;
+        for (auto & x : g_vk_memset_batch) {
+            if (x.device == dst->device) {
+                b = &x;
+            }
+        }
+        if (b == nullptr) {
+            dst->device->mutex.lock();
+            vk_context subctx = ggml_vk_create_temporary_context(dst->device->transfer_queue->cmd_pool);
+            ggml_vk_ctx_begin(dst->device, subctx);
+            g_vk_memset_batch.push_back({ dst->device, subctx });
+            b = &g_vk_memset_batch.back();
+        }
+        b->ctx->s->buffer->buf.fillBuffer(dst->buffer, offset, size, c);
+        return;
+    }
+
     std::lock_guard<std::recursive_mutex> guard(dst->device->mutex);
     vk_context subctx = ggml_vk_create_temporary_context(dst->device->transfer_queue->cmd_pool);
     ggml_vk_ctx_begin(dst->device, subctx);
diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-common.h b/ggml/src/ggml-vulkan/ggml-vulkan-common.h
index 814891cdf0..c3a412e92b 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan-common.h
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-common.h
@@ -75,6 +75,7 @@ void ggml_vk_buffer_copy_async(vk_context& ctx, vk_buffer& dst, size_t dst_offse
 void ggml_vk_buffer_copy(vk_buffer& dst, size_t dst_offset, vk_buffer& src, size_t src_offset, size_t size);
 void ggml_vk_buffer_memset_async(vk_context& ctx, vk_buffer& dst, size_t offset, uint32_t c, size_t size);
 void ggml_vk_buffer_memset(vk_buffer& dst, size_t offset, uint32_t c, size_t size);
+void ggml_vk_memset_batch(bool begin);
 vk_buffer ggml_vk_buffer_from_host_ptr(vk_device & device, void * ptr, size_t size);
 
 // pipelines
diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 51fe07a0f2..2fed20ddcb 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -19950,11 +19950,20 @@ static ggml_backend_dev_t ggml_backend_vk_reg_get_device(ggml_backend_reg_t reg,
     return devices[device];
 }
 
+// lane-298: "ggml_backend_vk_memset_batch" = void (*)(bool begin), used by the KV cache's kv-zero to batch its fills
+static void * ggml_backend_vk_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
+    GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_vk_memset_batch") == 0) {
+        return (void *) ggml_vk_memset_batch;
+    }
+    return nullptr;
+}
+
 static const struct ggml_backend_reg_i ggml_backend_vk_reg_i = {
     /* .get_name         = */ ggml_backend_vk_reg_get_name,
     /* .get_device_count = */ ggml_backend_vk_reg_get_device_count,
     /* .get_device       = */ ggml_backend_vk_reg_get_device,
-    /* .get_proc_address = */ NULL,
+    /* .get_proc_address = */ ggml_backend_vk_reg_get_proc_address,
 };
 
 ggml_backend_reg_t ggml_backend_vk_reg() {
diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 8a19577daa..1c54c71da7 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -1865,6 +1865,25 @@ void llama_kv_cache::zero_stale_cells(const slot_info & sinfo, uint32_t lo, uint
     uint32_t n_cells = 0;
     uint32_t n_runs  = 0;
 
+    // lane-298: backends that can batch memsets (Vulkan: one submit + one fence for the whole apply instead of one per
+    // layer x K/V x run). Same fills, same bytes. Not used with transposed V (its set_2d upload shares the command pool).
+    using memset_batch_fn = void (*)(bool);
+    std::vector<memset_batch_fn> batch;
+    auto batch_begin = [&]() {
+        if (!batch.empty() || v_trans) {
+            return;
+        }
+        for (const auto & [_, buf] : ctxs_bufs) {
+            ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buf.get()));
+            ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+            auto fn = reg ? (memset_batch_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_vk_memset_batch") : nullptr;
+            if (fn && std::find(batch.begin(), batch.end(), fn) == batch.end()) {
+                fn(true);
+                batch.push_back(fn);
+            }
+        }
+    };
+
     for (uint32_t s = 0; s < sinfo.n_stream(); ++s) {
         const uint32_t strm  = sinfo.strm[s];
         const auto &   cells = v_cells[strm];
@@ -1881,6 +1900,7 @@ void llama_kv_cache::zero_stale_cells(const slot_info & sinfo, uint32_t lo, uint
             while (j < n && dirty[j] && cells.is_empty(j)) {
                 dirty[j++] = 0;
             }
+            batch_begin();
             zero_cells(strm, i, j, zeros);
             n_cells += j - i;
             n_runs++;
@@ -1892,8 +1912,12 @@ void llama_kv_cache::zero_stale_cells(const slot_info & sinfo, uint32_t lo, uint
         }
     }
 
+    for (auto fn : batch) {
+        fn(false);
+    }
+
     if (n_cells > 0) {
-        LLAMA_LOG_INFO("%s: kv-zero %u freed cells in %u runs, window [%u, %u)\n", __func__, n_cells, n_runs, lo, n_kv);
+        LLAMA_LOG_INFO("%s: kv-zero %u freed cells in %u runs, window [%u, %u), batched %d\n", __func__, n_cells, n_runs, lo, n_kv, (int) !batch.empty());
     }
 
     kv_zero_pending = left;
