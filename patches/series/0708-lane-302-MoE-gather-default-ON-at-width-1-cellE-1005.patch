From e8bf3e8121ee6af1f891c817783fb58eef359a5f Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 5 Oct 2026 20:45:05 -0400
Subject: [PATCH] lane-302: MoE gather default ON at width 1 (cellE-10052000
 served ABBA x2: mean +0.34%, ids IDENT 48/48); GGML_ARIFI_MOE_GATHER=0 opts
 out; protected-wins entry amended with served fields

Lane: lane-302
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit f6df6bc0433def42bde87da91d334fecb58f9072)

Origin: ArifiLabs (native) - fork-authored (lane-302); no upstream origin exists.
Measured-effect: UNMEASURED on its own - protected-wins registration commit; the number is in the entry it adds
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 3 ++-
 tools/arifi-sync/protected-wins.json | 9 +++++----
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index b8a1dcfe2f..061f77c207 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -3934,7 +3934,8 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         // row's arithmetic against the NUM_COLS=1 id pipeline.
         {
             const char * env = getenv("GGML_ARIFI_MOE_GATHER");
-            const uint32_t g = env == nullptr ? 0u : (uint32_t) atoi(env);
+            // default ON at width 1 (lane-302 cellE-10052000 served ABBA x2); GGML_ARIFI_MOE_GATHER=0 opts out
+            const uint32_t g = env == nullptr ? 1u : (uint32_t) atoi(env);
             device->moe_gather_cols = (g == 1 || g == 2 || g == 4) ? g : 0u;
             const char * plant = getenv("GGML_ARIFI_MOE_GATHER_PLANT");
             device->moe_gather_plant = plant != nullptr && plant[0] == '1';
diff --git a/tools/arifi-sync/protected-wins.json b/tools/arifi-sync/protected-wins.json
index 358bc2b1cb..a29c557d44 100644
--- a/tools/arifi-sync/protected-wins.json
+++ b/tools/arifi-sync/protected-wins.json
@@ -1807,7 +1807,7 @@
     {
       "id": "vulkan-moe-gather-slot-major-matvec-id",
       "status": "active",
-      "_registered": "2026-10-05, lane-302 (Opus 5.5). Registered as an OP-LEVEL win that ships DEFAULT OFF. The served A/B (cellB-10051832) FAILED its pre-registered read rule (round 2 pairs -1.5..-2.8%), so no served t/s win may be quoted from this entry.",
+      "_registered": "2026-10-05, lane-302 (Opus 5.5). Registered as an OP-LEVEL win that shipped DEFAULT OFF. The served A/B (cellB-10051832) FAILED its pre-registered read rule (round 2 pairs -1.5..-2.8%, unbalanced order). Amended same day: the balanced served A/B (cellE-10052000, warm arm discarded, ABBA x2) PASSED its pre-registered default-on rule, so the gather is DEFAULT ON at width 1 from the flip commit (lane-302 branch, commit-msg-6).",
       "mechanism": "MUL_MAT_ID small-batch mat-vec (n_tokens 2..8) gets gather pipelines whose linear workgroup id maps to (row block = linear / nslots, slot = linear % nslots): consecutive workgroups are the routed slots of one weight row block, so slots that picked the same expert read that row block from L2 instead of DRAM. Per-workgroup math is unchanged (a permutation of work order), so output is byte-identical to the old path. GGML_ARIFI_MOE_GATHER unset = old path; =1 = slot-major gather (the measured width); =2/4 = multi-column variants that lose at real routing (padded-column ALU).",
       "commit": "088636633d",
       "also_commits": [
@@ -1828,12 +1828,13 @@
       "evidence": [
         "cache/moe-gather-x1-lane/NOTES.md",
         "cache/moe-gather-x1-lane/cells/cellB-10051832-read.json",
+        "cache/moe-gather-x1-lane/cells/cellE-10052000-read.json",
         "board/programs/local-inference/lanes/2026-10-05-lane-302-REPORT.md"
       ],
-      "quality_gate": "Byte identity harness on real qwen4exp expert tensors 100% IDENT g1/g2/g4 vs old path; test-backend-ops MUL_MAT_ID served shapes 1099/1099 g4 + 40/40 g1/g2, planted wrong arm RED (37 FAIL) (cellA-10051633). Served greedy token ids IDENT on all 12 request pairs (cellB-10051832).",
+      "quality_gate": "Byte identity harness on real qwen4exp expert tensors 100% IDENT g1/g2/g4 vs old path; test-backend-ops MUL_MAT_ID served shapes 1099/1099 g4 + 40/40 g1/g2, planted wrong arm RED (37 FAIL) (cellA-10051633). Served greedy token ids IDENT on all 12 request pairs (cellB-10051832) and on all 48 request pairs (cellE-10052000).",
       "workload": "Qwen3.8-Flash-Next qwen4exp IQ3_S serve file MoE experts (IQ4_NL down, IQ2_S / IQ3_XXS / IQ3_S / IQ4_XS gate-up), 512 experts top-10, AMD Radeon 890M (RDNA3.5), MTP verify width 4.",
-      "measured_effect": "Op level, timed pass 100 reps, g1/g0 us per op at real routing n4 / n8: IQ4_NL 0.93/0.92, IQ2_S 0.94/0.91, IQ3_XXS 0.81/0.77, IQ3_S 0.90/0.83, IQ4_XS 0.73/0.65 (cellA-10051633). Perf logger main_b4 (85 verify graphs) g1/off: IQ2_S 0.79, IQ3_XXS 0.83, IQ3_S 0.86, IQ4_NL 0.88 vs untouched control q2_0 0.88 and non-MUL_MAT_ID graph time 0.97 (run-level offset; only IQ2_S/IQ3_XXS/IQ3_S drop clearly beyond the q2_0 control). Served decode: NOT shown.",
-      "valid_conditions": "Vulkan MUL_MAT_ID mat-vec id path, n_tokens 2..8, opt-in env. n_tokens 1 never reaches the gather (plain decode measured -1.3..+2.3%, single round). Q2_0 down (q8_1 MMVQ id pipeline) has no gather variant."
+      "measured_effect": "Op level, timed pass 100 reps, g1/g0 us per op at real routing n4 / n8: IQ4_NL 0.93/0.92, IQ2_S 0.94/0.91, IQ3_XXS 0.81/0.77, IQ3_S 0.90/0.83, IQ4_XS 0.73/0.65 (cellA-10051633). Perf logger main_b4 (85 verify graphs) g1/off: IQ2_S 0.79, IQ3_XXS 0.83, IQ3_S 0.86, IQ4_NL 0.88 vs untouched control q2_0 0.88 and non-MUL_MAT_ID graph time 0.97 (run-level offset; only IQ2_S/IQ3_XXS/IQ3_S drop clearly beyond the q2_0 control). Served decode (cellE-10052000, dven40k MTP serve line, 12 rounds per arm per prompt, warm discarded): pooled pct short +1.16, long +0.43, copy +0.46, agent -0.69, mean +0.34%; per-pair spread -4.9..+5.71%. Small served gain inside round-level noise per pair; passes the pre-registered rule (mean > 0, no prompt < -1%).",
+      "valid_conditions": "Vulkan MUL_MAT_ID mat-vec id path, n_tokens 2..8, default ON (GGML_ARIFI_MOE_GATHER=0 opts out; =2/4 select the losing multi-column widths). n_tokens 1 never reaches the gather (plain decode measured -1.3..+2.3%, single round). Q2_0 down (q8_1 MMVQ id pipeline) has no gather variant."
     }
   ]
 }
