 ggml/src/ggml-vulkan/ggml-vulkan-types.h      |  1 +
 ggml/src/ggml-vulkan/ggml-vulkan.cpp          | 46 ++++++++++++++++++-
 .../vulkan-shaders/concat_transpose.comp      | 43 +++++++++++++++++
 .../vulkan-shaders/vulkan-shaders-gen.cpp     |  1 +
 4 files changed, 90 insertions(+), 1 deletion(-)
