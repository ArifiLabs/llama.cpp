         ]:
@@ -345,6 +398,30 @@ def selftest() -> int:
         else:
             print(f"SELFTEST FAIL — GREEN half wrong: {ids}")
             ok = False
+
+        # GREEN half for the ids that are NOT ambiguous, so their geometry check is
+        # exercised rather than merely present.
