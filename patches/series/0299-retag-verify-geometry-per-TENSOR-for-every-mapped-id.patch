-            "(16 B/32) in their files and OUR TQ4_1S (20 B/32) in ours; call plan() with "
-            "the data_start/file_size from parse_gguf()."
+            f"REFUSED: cannot verify the geometry of ids {sorted(mapped)} without byte spans. "
+            f"Call plan() with the data_start/file_size/alignment from parse_gguf()."
         )
-    if 46 in hist and data_start is not None:
-        verdict, votes = classify_id46(tensors, data_start, file_size)
-        if verdict == "ours":
