From ffeb40523b4fc7e46a31940662c70744b27aa2c6 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Sun, 6 Sep 2026 03:46:50 -0400
Subject: [PATCH] cuda: union upstream's mul_mat_id_needs_sync predicate with
 our TQ arm

Second repair under the President's 2026-09-06 reversal of the off-rig drop
policy. This one costs real CUDA-graph coverage, and nothing on this estate could
have measured it.

Upstream b10819 factored the "does mul_mat_id fall back to the stream-
synchronizing path" test out of the CUDA-graph scan loop into
ggml_cuda_mul_mat_id_needs_sync (ggml-cuda.cu:1876) and made it TIGHTER: after
the mmvq/AMD-mmvf early exits it also asks should_use_mmq and should_use_mmf, so
a non-quantized src0 that mmq or mmf will handle no longer disables CUDA graphs.

The b10819 base move kept the fork's older inline copy instead:

  if (!ggml_is_quantized(node->src[0]->type) || is_tq_w || node->ne[2] > mmvq_mmid_max)

which disables CUDA graphs for EVERY non-quantized src0 - so an F16 or BF16 MoE
model loses graph capture on CUDA even when mmf handles the op without a sync.
The upstream predicate was dropped, the CUDA-graph gain with it. Upstream's
GGML_ASSERT on the fallback path was dropped in the same hunk, so the invariant
the refactor exists to protect was also unguarded.

RESOLUTION - union. Upstream's predicate is adopted as the single source of truth
for both call sites, with the ArifiLabs arm carried onto it: TQ4_1S/TQ3_1S have
no mmvq/mmq/mmf kernel and always take the dequant-to-f16 cuBLAS fallback, so
they return true early. Same TQ behaviour as the fork's is_tq_w term, upstream's
tighter answer everywhere else.

Two smaller things the shared predicate closes, neither of them the point:
  - the fork read node->src[0]->type BEFORE testing node->op == GGML_OP_MUL_MAT_ID;
    upstream's form reads src[0] only inside that branch
  - ggml_cuda_should_use_mmq takes a tensor in this fork, not a type, so the
    predicate uses the fork's signature

NOT VERIFIED here: this estate has no CUDA toolchain. Union-by-mechanism-read;
compile verification is PENDING the first run of the CUDA job in
.github/workflows/arifi-backends-matrix.yml. No performance claim is made - the
mechanism is a graph-capture eligibility widening, not a kernel change.

Origin: upstream llama.cpp b10819 (6a1a922d2), PR #18958, unioned with the ArifiLabs TQ fallback arm
WI: WI-1698
Lane: lane-210
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 52 +++++++++++++++++++++++++++++----
 1 file changed, 46 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 3f1b13f0e0..e1c1364b09 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2020,6 +2020,49 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor
     ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);
 }
 
+// UNION (R17, lane-210): upstream b10819 factored the "does mul_mat_id fall back to the
+// stream-synchronizing path" test out of the CUDA-graph loop into this predicate, and made it
+// TIGHTER - a non-quantized src0 that mmq or mmf will handle no longer disables CUDA graphs.
+// The fork's b10819 base move kept its own older inline copy in the graph loop, which drops that
+// gain on every F16/BF16 MoE. Upstream's predicate is adopted here with the ArifiLabs TQ arm
+// carried onto it: TQ4_1S/TQ3_1S weights take the dequant-to-f16 cuBLAS fallback, so they always
+// need the sync. Single source of truth for both call sites, as upstream intends.
+// ref: https://github.com/ggml-org/llama.cpp/pull/18958
+// [TAG_MUL_MAT_ID_CUDA_GRAPHS]
+static bool ggml_cuda_mul_mat_id_needs_sync(const ggml_tensor * dst, const int cc) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return true;
+    }
+
+    // ArifiLabs: TQ weight types have no mmvq/mmq/mmf kernel - they always take the fallback
+    if (src0->type == GGML_TYPE_TQ4_1S || src0->type == GGML_TYPE_TQ3_1S) {
+        return true;
+    }
+
+    if (dst->ne[2] <= MMVQ_MAX_BATCH_SIZE) {
+        if (ggml_is_quantized(src0->type)) {
+            if (dst->ne[2] <= get_mmvq_mmid_max_batch(src0->type, cc)) {
+                return false;
+            }
+        } else if (GGML_CUDA_CC_IS_AMD(cc)) {
+            return false;
+        }
+    }
+
+    if (ggml_cuda_should_use_mmq(src0, cc, src1->ne[2], /*n_experts=*/src0->ne[2])) {
+        return false;
+    }
+
+    if (ggml_cuda_should_use_mmf(src0->type, cc, WARP_SIZE, src0->ne, src0->nb, src1->ne[2], /*mul_mat_id=*/true)) {
+        return false;
+    }
+
+    return true;
+}
+
 static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const ggml_tensor * src0 = dst->src[0];
     const ggml_tensor * src1 = dst->src[1];
@@ -2064,7 +2107,7 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
     }
 
     // note: this path should not be reached when recording CUDA graphs, because it requires stream synchronization
-    // TODO: add asserts to verify this. should work with CUDA, HIP, etc.
+    GGML_ASSERT(ggml_cuda_mul_mat_id_needs_sync(dst, cc));
     cudaStream_t stream = ctx.stream();
 
     GGML_ASSERT(nb12 % nb11 == 0);
@@ -2691,13 +2734,10 @@ static bool ggml_cuda_graph_check_compability(ggml_cgraph * cgraph) {
         }
 
         // [TAG_MUL_MAT_ID_CUDA_GRAPHS]
-        const bool is_tq_w = (node->src[0]->type == GGML_TYPE_TQ4_1S || node->src[0]->type == GGML_TYPE_TQ3_1S);
         if (node->op == GGML_OP_MUL_MAT_ID) {
             const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
-            const int mmvq_mmid_max = get_mmvq_mmid_max_batch(node->src[0]->type, cc);
-            if (!ggml_is_quantized(node->src[0]->type) || is_tq_w || node->ne[2] > mmvq_mmid_max) {
-                // under these conditions, the mul_mat_id operation will need to synchronize the stream, so we cannot use CUDA graphs
-                // TODO: figure out a way to enable for larger batch sizes, without hurting performance
+            if (ggml_cuda_mul_mat_id_needs_sync(node, cc)) {
+                // the mul_mat_id fallback path synchronizes the stream, so we cannot use CUDA graphs
                 // ref: https://github.com/ggml-org/llama.cpp/pull/18958
                 use_cuda_graph = false;
 #ifndef NDEBUG
