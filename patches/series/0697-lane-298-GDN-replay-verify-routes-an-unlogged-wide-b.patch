From d42ee555f74ad6bde47e632b20884d69eb80322f Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Tue, 6 Oct 2026 09:18:41 -0400
Subject: [PATCH] lane-298 GDN replay: verify routes an unlogged wide-batch
 partial reject to the draft-time checkpoint

shpa-10060844 sar1 (LLAMA_GDN_REPLAY=1, ngram-mod n-max 12) aborted at common.cpp:1691
"failed to remove sequence 0 with p0=2125, p1=-1": a verify batch wider than rs_planes()-1 is not
logged (rep.n = 0), so seq_rm's replay guard refuses any ring rollback, but the verify site chose the
ring path whenever n_rollback <= n_rs_seq. With replay on, n_draft > n_rs_seq now restores the
checkpoint that the draft-time block already saved under the same condition. Replay-off path unchanged.

(cherry picked from commit 3462b81fc83559169b0dc4e82cf412bb9005bae3)

Origin: ArifiLabs (native) - fork-authored (lane-298); no upstream origin exists.
Measured-effect: UNMEASURED - no served number for this commit in the release ledger or the commit message
---
 tools/server/server-context.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 6a2bf00e15..7a772f7717 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -4693,9 +4693,14 @@ private:
 
                 const uint32_t n_rollback = slot.spec_draft.size() + 1 - accepted.size();
 
+                // lane-298 GDN replay: a verify batch wider than the ring is not logged, so the ring cannot roll it
+                // back at all; its checkpoint was saved at draft time (same n_draft > n_rs_seq condition)
+                static const bool gdn_rep_v = getenv("LLAMA_GDN_REPLAY") != nullptr;
                 const bool use_ckpt_tgt =
                     ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL ||
-                    (ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS && n_rollback > llama_n_rs_seq(ctx_tgt));
+                    (ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS && n_rollback > llama_n_rs_seq(ctx_tgt)) ||
+                    (ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS && gdn_rep_v && n_rollback > 0 &&
+                     n_draft > llama_n_rs_seq(ctx_tgt));
 
                 slot.spec_rep_partial = n_rollback > 0 && !use_ckpt_tgt;
 
