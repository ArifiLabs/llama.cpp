From 16f0ae402b36271f19dd688fccd6d62b1ae71ca0 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 28 Sep 2026 04:23:00 -0400
Subject: [PATCH] tests: V023 asserting regression check - SILU must stay fused
 with its MUL on Vulkan (lane-296 B3)

Exit 1 on the pre-fix union c63cad345^ (0 SILU_MUL / 864 SILU), exit 0 on c63cad345 and on vanilla b11178. Receipts: cache/lane296/ev15/B3-V023-{U7,U8,V}.{txt,rc}.

Lane: lane-296
Receipts: cache/lane296/ev15/B3-V023-U7.rc, cache/lane296/ev15/B3-V023-U8.rc
---
 tests/test-arifi-v023-silu-mul-fusion.py | 64 ++++++++++++++++++++++++
 1 file changed, 64 insertions(+)
 create mode 100644 tests/test-arifi-v023-silu-mul-fusion.py

diff --git a/tests/test-arifi-v023-silu-mul-fusion.py b/tests/test-arifi-v023-silu-mul-fusion.py
new file mode 100644
index 0000000000..c048845e75
--- /dev/null
+++ b/tests/test-arifi-v023-silu-mul-fusion.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""ARIFI lane-296 V023 regression check: Vulkan graph_optimize must not split SILU from the MUL it fuses with.
+
+Runs llama-cli on a Qwen3.x gated-delta-net model with GGML_VK_PERF_LOGGER=1 and reads the per-graph op census.
+On those models every standalone SILU is the GDN z-gate, which upstream fuses into SILU_MUL. The pre-fix union
+(c63cad345^) logged 0 SILU_MUL and 48 SILU per graph; the fix logs 48 SILU_MUL and 0 SILU.
+Scope: bases that carry upstream's UNARY+MUL fusion (b11178 on). Older engines (r86i, b10825) read RED by design.
+
+  python tests/test-arifi-v023-silu-mul-fusion.py <bin-dir> <qwen3.x-gdn.gguf>
+
+Exit 0 = fused (GREEN), 1 = the pair split (RED), 2 = the run itself failed or logged no graph.
+"""
+import os
+import re
+import subprocess
+import sys
+
+LINE = re.compile(r"^(?P<op>[A-Z][A-Z0-9_ ]*?): (?P<n>\d+) x ", re.M)
+
+
+def census(text):
+    fused = standalone = graphs = 0
+    for m in LINE.finditer(text):
+        op, n = m.group("op"), int(m.group("n"))
+        if op == "SILU_MUL SILU":
+            fused += n
+            graphs += 1
+        elif op == "SILU":
+            standalone += n
+            graphs += 1
+    return fused, standalone, graphs
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(__doc__)
+        return 2
+    exe = os.path.join(argv[1], "llama-cli.exe" if os.name == "nt" else "llama-cli")
+    env = dict(os.environ, GGML_VK_PERF_LOGGER="1")
+    cmd = [exe, "-m", argv[2], "-ngl", "99", "-c", "512", "-n", "8", "--temp", "0", "--top-k", "1",
+           "--seed", "42", "--no-warmup", "-st", "-p", "The capital of France is"]
+    r = subprocess.run(cmd, env=env, capture_output=True, text=True, encoding="utf-8", errors="replace",
+                       stdin=subprocess.DEVNULL, timeout=1800)
+    fused, standalone, graphs = census(r.stdout + r.stderr)
+    print(f"V023 census: SILU_MUL={fused} standalone SILU={standalone} graph-lines={graphs} rc={r.returncode}")
+    if r.returncode != 0 or graphs == 0:
+        print("V023 ERROR: run failed or no perf-logger graph was printed")
+        return 2
+    if standalone > 0 or fused == 0:
+        print("V023 RED: SILU split from its MUL (graph_optimize reorder regression)")
+        return 1
+    print("V023 GREEN: every SILU fused with its MUL")
+    return 0
+
+
+def selftest():
+    assert census("SILU_MUL SILU: 48 x 97.3 us = 1 us\nSSM_CONV_SILU SSM_CONV: 48 x 2 us = 1 us\n") == (48, 0, 1)
+    assert census("MUL: 48 x 45.6 us = 1 us\nSILU: 48 x 33.1 us = 1 us\n") == (0, 48, 1)
+    assert census("junk\n") == (0, 0, 0)
+
+
+if __name__ == "__main__":
+    selftest()
+    sys.exit(main(sys.argv))
