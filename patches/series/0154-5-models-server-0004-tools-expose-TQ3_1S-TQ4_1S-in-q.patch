From 659c27a7fa372e6da889da3b291b3f5eab675367 Mon Sep 17 00:00:00 2001
From: m <arifilabs@users.noreply.github.com>
Date: Sat, 15 Aug 2026 19:57:09 -0400
Subject: [PATCH] 
 5-models-server/0004-tools-expose-TQ3_1S-TQ4_1S-in-quantize-table-and-lla.patch

---
 tools/llama-bench/llama-bench.cpp | 6 ++++++
 tools/quantize/quantize.cpp       | 2 ++
 2 files changed, 8 insertions(+)

diff --git a/tools/llama-bench/llama-bench.cpp b/tools/llama-bench/llama-bench.cpp
index 36a2139ad1..3ce9d52387 100644
--- a/tools/llama-bench/llama-bench.cpp
+++ b/tools/llama-bench/llama-bench.cpp
@@ -524,6 +524,12 @@ static ggml_type ggml_type_from_name(const std::string & s) {
     if (s == "turbo4") {
         return GGML_TYPE_TURBO4_0;
     }
+    if (s == "tq3_1s") {
+        return GGML_TYPE_TQ3_1S;
+    }
+    if (s == "tq4_1s") {
+        return GGML_TYPE_TQ4_1S;
+    }
 
     return GGML_TYPE_COUNT;
 }
diff --git a/tools/quantize/quantize.cpp b/tools/quantize/quantize.cpp
index 5fac293439..a10440bcf2 100644
--- a/tools/quantize/quantize.cpp
+++ b/tools/quantize/quantize.cpp
@@ -62,6 +62,8 @@ static const std::vector<quant_option> QUANT_OPTIONS = {
     { "IQ1_M",    LLAMA_FTYPE_MOSTLY_IQ1_M,    " 1.75 bpw quantization",            },
     { "TQ1_0",    LLAMA_FTYPE_MOSTLY_TQ1_0,    " 1.69 bpw ternarization",           },
     { "TQ2_0",    LLAMA_FTYPE_MOSTLY_TQ2_0,    " 2.06 bpw ternarization",           },
+    { "TQ3_1S",   LLAMA_FTYPE_MOSTLY_TQ3_1S,   " 4.00 bpw WHT-rotated",             },
+    { "TQ4_1S",   LLAMA_FTYPE_MOSTLY_TQ4_1S,   " 5.00 bpw WHT-rotated",             },
     { "Q2_K",     LLAMA_FTYPE_MOSTLY_Q2_K,     " 2.96G, +3.5199 ppl @ Llama-3-8B",  },
     { "Q2_K_S",   LLAMA_FTYPE_MOSTLY_Q2_K_S,   " 2.96G, +3.1836 ppl @ Llama-3-8B",  },
     { "IQ3_XXS",  LLAMA_FTYPE_MOSTLY_IQ3_XXS,  " 3.06 bpw quantization",            },
