+        "ggml/src/ggml-vulkan/ggml-vulkan-types.h",
+        "ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_base.glsl",
+        "ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp"
+      ],
