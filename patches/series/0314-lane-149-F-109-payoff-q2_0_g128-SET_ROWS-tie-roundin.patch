From e893f6f7262e2b11ba313c1844474da80a30ab37 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 17 Aug 2026 23:16:25 -0400
Subject: [PATCH] lane-149 F-109 payoff: q2_0_g128 SET_ROWS tie-rounding fixed.
 GLSL round() breaks .5 ties implementation-chosen; CPU roundf is
 half-away-from-zero. 8 f16 failures -> 2, ERR 5.1e-4 -> 1.7e-5

---
 ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp b/ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp
index f463d2e1a..a5c75fb99 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp
@@ -370,7 +370,13 @@ void quantize(uint dst_idx, uint src_idx)
     }
 
     [[unroll]] for (int j = 0; j < QUANT_K_Q2_0_G128; ++j) {
-        int q = int(round(float(data_s[src_idx + j]) * id)) + 1;
+        // GLSL round() breaks ties in an IMPLEMENTATION-CHOSEN direction (GLSL spec 8.3); the CPU
+        // reference (quantize_row_q2_0_g128_ref, ggml-quants.c) uses roundf = half AWAY from zero.
+        // f16 sources land on exact .5 ties often enough that the two disagreed on real cases —
+        // 8 SET_ROWS(f16 -> q2_0_g128) failures, ERR up to 5.1e-4, found the moment lane-149 added
+        // q2_0_g128 to all_types (F-109). Same expression as quantize_q2_0() above.
+        const float x = float(data_s[src_idx + j]) * id;
+        int q = int(x >= 0.0 ? floor(x + 0.5) : ceil(x - 0.5)) + 1;
         q = clamp(q, 0, 3);
         data_q[dst_idx].qs[j / 4] |= uint8_t(q << ((j % 4) * 2));
     }
