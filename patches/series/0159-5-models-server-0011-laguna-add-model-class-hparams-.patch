From 80f359a5d6a94ed7b5fa25ef9307859a0f12f88e Mon Sep 17 00:00:00 2001
From: m <m@l>
Date: Sat, 15 Aug 2026 19:57:19 -0400
Subject: [PATCH] 
 5-models-server/0011-laguna-add-model-class-hparams-wiring-vocab-pre-toke.patch

---
 src/llama-model.cpp   |  1 +
 src/llama-model.h     |  1 +
 src/models/laguna.cpp | 19 ++++++++++++++++++-
 src/models/models.h   | 22 ++++++++++++++++++++++
 4 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index f45bd9963..23a5401e5 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -845,6 +845,7 @@ const char * llm_type_name(llm_type type) {
         case LLM_TYPE_24B_A2B:       return "24B.A2B";
         case LLM_TYPE_26B_A4B:       return "26B.A4B";
         case LLM_TYPE_30B_A3B:       return "30B.A3B";
+        case LLM_TYPE_118B_A8B:      return "118B.A8B";
         case LLM_TYPE_31B_A3_5B:     return "31B.A3.5B";
         case LLM_TYPE_35B_A3B:       return "35B.A3B";
         case LLM_TYPE_48B_A3B:       return "48B.A3B";
diff --git a/src/llama-model.h b/src/llama-model.h
index 51a9045a8..4f27164da 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -125,6 +125,7 @@ enum llm_type {
     LLM_TYPE_24B_A2B, // lfm2moe
     LLM_TYPE_26B_A4B, // Gemma4
     LLM_TYPE_30B_A3B,
+    LLM_TYPE_118B_A8B,
     LLM_TYPE_31B_A3_5B,
     LLM_TYPE_35B_A3B, // Qwen3.5
     LLM_TYPE_48B_A3B, // Kimi Linear
diff --git a/src/models/laguna.cpp b/src/models/laguna.cpp
index 82c9a9538..78974d801 100644
--- a/src/models/laguna.cpp
+++ b/src/models/laguna.cpp
@@ -172,6 +172,9 @@ llama_model_laguna::graph::graph(const llama_model & model, const llm_graph_para
     const float kq_scale = 1.0f / sqrtf(float(n_embd_head));
 
     for (int il = 0; il < n_layer; ++il) {
+        // residual-stream capture for speculative drafters (EAGLE3 / DFlash)
+        res->t_layer_inp[il] = inpL;
+
         const bool    is_swa_il   = hparams.is_swa(il);
         const int64_t n_head_il   = hparams.n_head(il);
         const int64_t n_head_kv_il = hparams.n_head_kv(il);
@@ -261,7 +264,10 @@ llama_model_laguna::graph::graph(const llama_model & model, const llm_graph_para
             cb(cur, "attn_o_proj", il);
         }
 
-        if (il == n_layer - 1 && inp_out_ids) {
+        // When unmasked nextn extraction is on (DFlash needs the pre-norm
+        // hidden state for every token), defer the output-row gather to
+        // after the final-norm capture below (qwen35 pattern).
+        if (il == n_layer - 1 && inp_out_ids && cparams.embeddings_nextn_masked) {
             cur   = ggml_get_rows(ctx0,   cur, inp_out_ids);
             inpSA = ggml_get_rows(ctx0, inpSA, inp_out_ids);
         }
@@ -321,7 +327,18 @@ llama_model_laguna::graph::graph(const llama_model & model, const llm_graph_para
     }
 
     cur = inpL;
+
+    // pre-final-norm residual stream: the DFlash drafter's last capture point
+    // ("input of layer n_layer" in the training convention)
+    cb(cur, "h_nextn", -1);
+    res->t_h_nextn = cur;
+
     cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
+
+    if (!cparams.embeddings_nextn_masked && inp_out_ids) {
+        cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+    }
+
     cb(cur, "result_norm", -1);
     res->t_embd = cur;
 
diff --git a/src/models/models.h b/src/models/models.h
index 80f1e6dc4..770fd40df 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -1339,6 +1339,15 @@ struct llama_model_dflash : public llama_model_base {
     void load_arch_hparams(llama_model_loader & ml) override;
     void load_arch_tensors(llama_model_loader & ml) override;
 
+    // set when dflash.decoder_arch == "laguna": draft layers follow the Laguna
+    // decoder contract (softplus attn gate, per-aux feature norms, context K/V
+    // through input_layernorm, causal noise-block attention)
+    bool decoder_laguna = false;
+
+    // per-aux-feature RMSNorm weights stacked to [n_embd, n_aux], applied
+    // before concat + fc (Laguna drafters)
+    ggml_tensor * aux_norm = nullptr;
+
     template <bool is_enc>
     struct graph : public llm_graph_context {
         graph(const llama_model & model, const llm_graph_params & params);
@@ -1354,6 +1363,19 @@ struct llama_model_dflash : public llama_model_base {
 };
 
 
+struct llama_model_laguna : public llama_model_base {
+    llama_model_laguna(const struct llama_model_params & params) : llama_model_base(params) {}
+    void load_arch_hparams(llama_model_loader & ml) override;
+    void load_arch_tensors(llama_model_loader & ml) override;
+
+    struct graph : public llm_graph_context {
+        graph(const llama_model & model, const llm_graph_params & params);
+    };
+
+    std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params & params) const override;
+};
+
+
 struct llama_model_mistral4 : public llama_model_deepseek2 {
     llama_model_mistral4(const struct llama_model_params & params) : llama_model_deepseek2(params) {}
     // reuse load_arch_hparams and load_arch_tensors from llama_model_deepseek2
