From d629fb9dc451a53dcaa939767bb40405b31850f7 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Sat, 12 Sep 2026 22:24:08 -0400
Subject: [PATCH] fix(checkpoint): make device finalization fallible

(cherry picked from commit e4aed44e76cb093fbf4882b724dc1a2b35b276c4)
---
 CMakeLists.txt                                |   7 +
 common/common.cpp                             |  60 ++-
 common/common.h                               |   7 +-
 .../speculative-simple/speculative-simple.cpp |  17 +-
 src/CMakeLists.txt                            |  13 +
 src/llama-context.cpp                         | 242 ++++++---
 tests/test-recurrent-state-rollback.cpp       |  10 +-
 tests/test-save-load-state.cpp                | 469 ++++++++++++++++++
 tools/server/server-context.cpp               |  46 +-
 9 files changed, 766 insertions(+), 105 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6dca80e83..d831ed8c3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -22,6 +22,13 @@ endif()
 
 message(STATUS "llama.cpp version: ${LLAMA_VERSION}")
 
+# R46b: the deterministic checkpoint fault-injection seam (LLAMA_R46_CKPT_FAIL_ALLOC / _COPY).
+# OFF in every build, including dev builds and builds with LLAMA_BUILD_TESTS=ON, so no ordinary
+# source-built binary reads those environment variables. Only a build that explicitly passes
+# -DLLAMA_TEST_CHECKPOINT_FAULT_INJECTION=ON compiles the seam, and that build is for running the
+# injected-failure checkpoint tests, never for serving.
+option(LLAMA_TEST_CHECKPOINT_FAULT_INJECTION "llama: compile the checkpoint fault-injection test seam (tests only, never serve with this ON)" OFF)
+
 #set(CMAKE_WARN_DEPRECATED YES)
 set(CMAKE_WARN_UNUSED_CLI YES)
 
