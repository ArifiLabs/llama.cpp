+            if (use_ckpt_dft && !ckpt.update_dft(ctx_dft, seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY)) {
+                // R46b: no drafter image to roll back to - rebuild the drafter sequence
