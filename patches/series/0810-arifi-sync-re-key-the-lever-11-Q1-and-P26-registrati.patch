         "ggml/src/ggml-vulkan/ggml-vulkan.cpp",
         "ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp"
@@ -2425,7 +2425,7 @@
       "status": "active",
       "_registered": "2026-10-09, lane 298 relaunch-102 at the v0132 pick of lane 299 Q1 5acd125e21 (HQ85 07:3x pick order T1, Q0, Q1). Entry text from lane 299 MERGE-READY row Q1.",
       "mechanism": "New device field mmvq_wide_rows_from_q8_0, read only by the Q8_0 q8_1 MMVQ pipeline (rm_int_n_q8_0). On AMD 0x150e (Radeon 890M) with the generic knob unset it is 8, so Q8_0 keeps its own rows at every NUM_COLS <= 8 instead of the inherited RDNA3 static 4-row shape at NUM_COLS >= 5. Rows only: bit-identical by construction. Every other device and type keeps the shipped pipeline.",
-      "commit": "1b78a88413d0ef0ad563c1fab27dd040ed23cb15",
+      "commit": "b164ec401fa1f5a64b472bb7d271bed40fa08bd2",
       "protected_paths": [
