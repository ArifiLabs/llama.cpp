+// tail length in cells. 0 = feature off. Read once.
+static uint32_t llama_kv_tail_cells() {
+    static int64_t cached = -1;
+
+    if (cached < 0) {
+        const char * s = getenv("LLAMA_KV_TAIL");
+        const int64_t v = s ? atoll(s) : 0;
+        cached = v > 0 ? v : 0;
+    }
+
+    return (uint32_t) cached;
+}
