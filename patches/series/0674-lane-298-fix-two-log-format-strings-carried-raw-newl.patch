From 30f87df9e79eee4c0fac1a1888828c0136a6442d Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 5 Oct 2026 19:10:52 -0400
Subject: [PATCH] lane-298 fix: two log format strings carried raw newlines
 instead of \n (cf4f877c07 build break)

Lane: lane-298
(cherry picked from commit 7d23681a80eb2777a1bf4ad2cc177555e2511de9)

Origin: ArifiLabs (native) - fork-authored (lane-298); no upstream origin exists.
Measured-effect: UNMEASURED on its own - supporting commit; see release ledger Table 2 (lane 298), the number sits on that win's main commit
---
 src/llama-memory-recurrent.cpp | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/src/llama-memory-recurrent.cpp b/src/llama-memory-recurrent.cpp
index d11dc68583..47a590a353 100644
--- a/src/llama-memory-recurrent.cpp
+++ b/src/llama-memory-recurrent.cpp
@@ -58,13 +58,11 @@ llama_memory_recurrent::llama_memory_recurrent(
         rs_replay = rs_r1 && getenv("LLAMA_GDN_REPLAY") != nullptr && S_r > 0 && H_r > 0 &&
                     (int64_t) hparams.n_embd_s() == S_r * S_r * H_r;
         if (rs_replay && (getenv("GGML_VK_DISABLE_GDN_BANK") || getenv("GGML_VK_DISABLE_FUSION"))) {
-            LLAMA_LOG_WARN("%s: LLAMA_GDN_REPLAY refused: GDN_BANK fusion is disabled
-", __func__);
+            LLAMA_LOG_WARN("%s: LLAMA_GDN_REPLAY refused: GDN_BANK fusion is disabled\n", __func__);
             rs_replay = false;
         }
         if (rs_replay) {
-            LLAMA_LOG_INFO("%s: GDN deferred commit + replay ACTIVE (log %u rows per half)
-", __func__, rs_planes());
+            LLAMA_LOG_INFO("%s: GDN deferred commit + replay ACTIVE (log %u rows per half)\n", __func__, rs_planes());
         }
     }
 
