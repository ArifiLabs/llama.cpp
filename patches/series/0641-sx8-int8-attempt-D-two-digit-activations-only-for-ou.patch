diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1.comp
index 4f30216a2b..3bc206632c 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1.comp
@@ -117,6 +117,31 @@ shared float buf_b_dh[BN * BK_STEP * 2];
 shared float buf_b_s[BN * BK_STEP];
 #endif
 
+#if defined(SX8_SKIP)
+#if defined(MUL_MAT_ID)
+#error "SX8_SKIP is dense only"
+#endif
+// attempt D: one bit per k-step (BK * BK_STEP values) of this workgroup's column tile; set = some residual block of
+// the tile in that k-step is non-zero. Covers K up to 64 * 32 * 128.
+#define SX8_SKIP_WORDS 64
+shared uint sx8_skip_mask[SX8_SKIP_WORDS];
+// first active k-step at or after block b (block = start_k + i * BK * BK_STEP), end_k if none
+uint sx8_skip_next(uint b, uint start_k, uint end_k) {
+    if (b >= end_k) return end_k;
+    uint i = (b - start_k) / (BK * BK_STEP);
+    const uint nks = (end_k - start_k + BK * BK_STEP - 1) / (BK * BK_STEP);
+    while (i < nks) {
+        const uint w = sx8_skip_mask[i / 32] >> (i % 32);
+        if (w != 0) {
+            i += uint(findLSB(w));
+            return i < nks ? start_k + i * (BK * BK_STEP) : end_k;
+        }
+        i = (i / 32 + 1) * 32;
+    }
+    return end_k;
+}
+#endif
+
 #if defined(DATA_A_IQ4_NL) || defined(DATA_A_IQ4_XS) || defined(DATA_A_MXFP4) || defined(DATA_A_NVFP4)
 shared int8_t cm1_kvalues[16];
 #endif
@@ -300,9 +325,46 @@ void main() {
     block_a_prefetch pre_a[A_LOADS * BK_STEP];
     block_b_prefetch pre_b[B_LOADS * BK_STEP];
 
+#if defined(SX8_SKIP)
+    {
+        const uint KSTEP = BK * BK_STEP;
+        const uint nks = (end_k - start_k + KSTEP - 1) / KSTEP;
+        for (uint i = gl_LocalInvocationID.x; i < SX8_SKIP_WORDS; i += BLOCK_SIZE) {
+            sx8_skip_mask[i] = 0u;
+        }
+        barrier();
+        // k-step fastest: one column's consecutive x4 blocks sit next to each other in memory
+        for (uint t = gl_LocalInvocationID.x; t < BN * nks; t += BLOCK_SIZE) {
+            const uint c = t / nks;
+            const uint s = t % nks;
+            if (ic * BN + c < p.N) {
+                const uint ib = (batch_idx * p.batch_stride_b + (ic * BN + c) * p.stride_b + start_k) / BK + s * BK_STEP;
+                bool any = false;
+                [[unroll]] for (uint ks = 0; ks < BK_STEP; ks++) {
+                    if (start_k + s * KSTEP + ks * BK < end_k) {
+                        const uint ib_k = ib + ks;
+                        any = any || float(data_b[ib_k / 4].ds[ib_k % 4].x) != 0.0;
+                    }
+                }
+                if (any) {
+                    atomicOr(sx8_skip_mask[s / 32], 1u << (s % 32));
+                }
+            }
+        }
+        barrier();
+    }
+    const uint first_block = sx8_skip_next(start_k, start_k, end_k);
+    pos_a_ib += (first_block - start_k) / BK;
+    pos_b_ib += (first_block - start_k) / BK;
+    if (first_block < end_k) {
+        PREFETCH_BLOCK(first_block)
+    }
+#else
+    const uint first_block = start_k;
     if (start_k < end_k) {
         PREFETCH_BLOCK(start_k)
     }
+#endif
 
     const uint a_row0 = warp_r * WM;
     const uint b_col0 = warp_c * WN;
@@ -314,15 +376,25 @@ void main() {
 
     barrier();
 
+#if defined(SX8_SKIP)
+    for (uint block = first_block; block < end_k; ) {
+#else
     for (uint block = start_k; block < end_k; block += BK * BK_STEP) {
+#endif
         STORE_BLOCK_TO_LDS(block)
 
         barrier();
 
+#if defined(SX8_SKIP)
+        const uint next_block = sx8_skip_next(block + BK * BK_STEP, start_k, end_k);
+        pos_a_ib += (next_block - block) / BK;
+        pos_b_ib += (next_block - block) / BK;
+#else
         pos_a_ib += BK_STEP;
         pos_b_ib += BK_STEP;
 
         const uint next_block = block + BK * BK_STEP;
+#endif
         if (next_block < end_k) {
             PREFETCH_BLOCK(next_block)
         }
@@ -533,6 +605,9 @@ void main() {
         }
 
         barrier();
+#if defined(SX8_SKIP)
+        block = next_block;
+#endif
     }
 
 #undef PREFETCH_BLOCK
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp b/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp
index c81302d203..d8425a50c4 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp
@@ -30,6 +30,9 @@ layout(constant_id = 3) const uint RES_SHIFT = 0;
 // lane sx8-int8 attempt E: 1 = one scale per 16-value half block, ds = (d0, d1). Only the S-X8 H16 cm1 kernel reads it
 // (it sums the int8 activations exactly, so the block sum ds.y is not needed). Not combined with RESIDUAL.
 layout(constant_id = 4) const uint HALF = 0;
+// lane sx8-int8 attempt D: with RESIDUAL, write the second digit only for blocks with amax > GATE * mean|x| (an outlier
+// block); every other block gets q2 = 0, d2 = 0, so the SX8_SKIP matmul can skip it. 0 = off (every block).
+layout(constant_id = 5) const uint GATE = 0;
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
 layout (binding = 0) readonly buffer A {vec4 data_a[];};
@@ -108,8 +111,31 @@ void quantize(const uint wgid) {
         q = clamp(q, vec4(-127.0), vec4(127.0));
     }
     if (RESIDUAL != 0) {
+        bool keep = true;
+        if (GATE != 0) {
+            const float thread_asum = abs_vals.x + abs_vals.y + abs_vals.z + abs_vals.w;
+#ifndef USE_SUBGROUPS
+            barrier();
+            shmem[tid] = thread_asum;
+            barrier();
+            [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
+                if (iqs < s) {
+                    shmem[tid] += shmem[tid + s];
+                }
+                barrier();
+            }
+            const float asum = shmem[block_in_wg * 8];
+#else
+            const float asum = subgroupClusteredAdd(thread_asum, 8);
+#endif
+            // amax > GATE * (asum / 32)
+            keep = amax * 32.0 > float(GATE) * asum;
+        }
         // second int8 digit: requantize x - q1 * f16(d1), q1 recomputed exactly as the first pass stored it
         vals -= q * float(f16vec2(vec2(d, 0.0)).x);
+        if (!keep) {
+            vals = vec4(0.0);
+        }
         vals = ldexp(vals, ivec4(int(RES_SHIFT)));
         const vec4 abs_r = abs(vals);
         const float thread_rmax = max(max(abs_r.x, abs_r.y), max(abs_r.z, abs_r.w));
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
index ab26491fe0..e6526b3df3 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
@@ -740,6 +740,8 @@ void matmul_shaders(bool fp16, MatMulIdType matmul_id_type, bool coopmat, bool c
         // attempt E: 16-value activation scales (SX8_H16), and its RED twin.
         string_to_spv(shader_name + "_sx8h_q8_1", "mul_mmq_cm1.comp", merge_maps(merge_maps(base_dict, sx8_cm1_dict), {{"SX8_H16", "1"}}), fp16, coopmat, coopmat2, f16acc);
         string_to_spv(shader_name + "_sx8hred_q8_1", "mul_mmq_cm1.comp", merge_maps(merge_maps(base_dict, sx8_cm1_dict), {{"SX8_H16", "1"}, {"SX8_CM1_RED", "1"}}), fp16, coopmat, coopmat2, f16acc);
+        // attempt D: second (residual) pass that skips k-steps whose residual blocks are all zero (gated quantizer).
+        string_to_spv(shader_name + "_sx8skip_q8_1", "mul_mmq_cm1.comp", merge_maps(merge_maps(base_dict, sx8_cm1_dict), {{"SX8_SKIP", "1"}}), fp16, coopmat, coopmat2, f16acc);
     }
 
     // TurboQuant weight types, ROTATED matmul.
