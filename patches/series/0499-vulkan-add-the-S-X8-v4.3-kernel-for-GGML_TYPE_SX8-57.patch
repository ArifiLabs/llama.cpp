+    float16_t dmin;    // range low
+    float16_t dmax;    // range high
+    uint8_t   config;  // 4 sub-block strategies, 2 bits each
+    uint8_t   qh[16];  // level high nibbles
+    uint8_t   ql[8];   // level low quads
