From 6de0593e647b2ecf50e906dcae349ce720c1abac Mon Sep 17 00:00:00 2001
From: m <m@l>
Date: Sat, 15 Aug 2026 20:52:26 -0400
Subject: [PATCH] 
 layer7/0011-metal-restore-lost-kernel-templates-add-offline-shad.patch

---
 .github/workflows/build-apple.yml | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/.github/workflows/build-apple.yml b/.github/workflows/build-apple.yml
index 289e5144e..5f3e07b3e 100644
--- a/.github/workflows/build-apple.yml
+++ b/.github/workflows/build-apple.yml
@@ -109,6 +109,31 @@ jobs:
           cd build
           ctest -L main --verbose --timeout 900
 
+  macos-latest-metal-offline-compile:
+    runs-on: macos-latest
+
+    steps:
+      - name: Clone
+        uses: actions/checkout@v6
+
+      - name: Generate embedded Metal source
+        run: |
+          cmake -B build \
+            -DGGML_METAL_EMBED_LIBRARY=ON \
+            -DGGML_METAL_SHADER_DEBUG=OFF \
+            -DLLAMA_BUILD_COMMON=OFF \
+            -DLLAMA_BUILD_EXAMPLES=OFF \
+            -DLLAMA_BUILD_TOOLS=OFF \
+            -DLLAMA_BUILD_TESTS=OFF \
+            -DLLAMA_BUILD_SERVER=OFF \
+            -DLLAMA_BUILD_APP=OFF
+          cmake --build build --target ggml-metal -j $(sysctl -n hw.logicalcpu)
+
+      - name: Offline Metal shader compile
+        run: |
+          xcrun -sdk macosx metal -fno-fast-math -I ggml/src -I ggml/src/ggml-metal \
+            -c build/ggml/src/ggml-metal/autogenerated/ggml-metal-embed.metal -o /dev/null
+
   macos-latest-ios-xcode:
     runs-on: macos-latest
 
