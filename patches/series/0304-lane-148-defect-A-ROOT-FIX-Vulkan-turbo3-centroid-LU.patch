From 259c90e5ae96ea931ca06734e9cdb110da0b5980 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 17 Aug 2026 20:38:59 -0400
Subject: [PATCH] lane-148 defect A ROOT FIX: Vulkan turbo3 centroid LUT was
 stale at 5 sites - CPY turbo3->f32 ERR 8.4302e-5 -> OK. CPU/CUDA/Metal/SYCL
 all carry CENTROIDS_3BIT (-0.190207,-0.118786,-0.066822,-0.021663); Vulkan
 alone carried a table whose midpoints do not match nearest_centroid_3bit().
 copy_to_quant.comp's TM decision boundaries were derived from the stale table
 and are corrected too.

---
 .../ggml-vulkan/vulkan-shaders/copy_to_quant.comp    | 12 ++++++++----
 .../ggml-vulkan/vulkan-shaders/dequant_funcs.glsl    |  5 +++--
 .../vulkan-shaders/dequant_funcs_cm2.glsl            |  5 +++--
 .../ggml-vulkan/vulkan-shaders/dequant_turbo3_0.comp |  8 ++++++--
 .../vulkan-shaders/flash_attn_dequant.glsl           |  6 +++---
 5 files changed, 23 insertions(+), 13 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp b/ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp
index 7b1fccdc09..f463d2e1ad 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/copy_to_quant.comp
@@ -268,15 +268,19 @@ const float TS2[128] = float[128](
 
 const float TINV = 0.08838834764831845;  // 1 / sqrt(128)
 
+// SOURCE OF TRUTH: CENTROIDS_3BIT in ggml/src/ggml-turbo-quant.c
 const float TC[8] = float[8](
-    -0.190685, -0.117832, -0.065717, -0.021460,
-     0.021460,  0.065717,  0.117832,  0.190685
+    -0.190207, -0.118786, -0.066822, -0.021663,
+     0.021663,  0.066822,  0.118786,  0.190207
 );
 
+// Decision boundaries = midpoints of TC. Must equal nearest_centroid_3bit()'s
+// thresholds in ggml/src/ggml-turbo-quant.c, or the GPU encoder picks a
+// different index than the CPU encoder for values near a boundary.
 const float TM[7] = float[7](
-    -0.154259, -0.091775, -0.043589,
+    -0.154496, -0.092804, -0.044243,
      0.0,
-     0.043589,  0.091775,  0.154259
+     0.044243,  0.092804,  0.154496
 );
 
 #if defined(SET_ROWS)
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl
index 84b77155c6..17a3297fec 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl
@@ -783,9 +783,10 @@ vec2 get_dm(uint ib, uint a_offset) {
 #if defined(DATA_A_TURBO3_0)
 vec2 dequantize(uint ib, uint iqs, uint a_offset) {
     // PolarQuant 3-bit centroids (Lloyd-Max for Gaussian)
+    // SOURCE OF TRUTH: CENTROIDS_3BIT in ggml/src/ggml-turbo-quant.c
     const float centroids[8] = float[8](
-        -0.190685, -0.117832, -0.065717, -0.021460,
-         0.021460,  0.065717,  0.117832,  0.190685
+        -0.190207, -0.118786, -0.066822, -0.021663,
+         0.021663,  0.066822,  0.118786,  0.190207
     );
 
     // iqs is the element index within the block (0..31), we decode 2 consecutive elements
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs_cm2.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs_cm2.glsl
index c4b967ab4a..0f21917020 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs_cm2.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs_cm2.glsl
@@ -1432,9 +1432,10 @@ layout(buffer_reference, std430, buffer_reference_align = 2) buffer decodeBufTUR
 
 float16_t dequantFuncTURBO3_0(const in decodeBufTURBO3_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
 {
+    // SOURCE OF TRUTH: CENTROIDS_3BIT in ggml/src/ggml-turbo-quant.c
     const float centroids[8] = float[8](
-        -0.190685, -0.117832, -0.065717, -0.021460,
-         0.021460,  0.065717,  0.117832,  0.190685
+        -0.190207, -0.118786, -0.066822, -0.021663,
+         0.021663,  0.066822,  0.118786,  0.190207
     );
     const float norm = float(bl.block.norm);
     const uint j = coordInBlock[1];
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dequant_turbo3_0.comp b/ggml/src/ggml-vulkan/vulkan-shaders/dequant_turbo3_0.comp
index c12dd5f8e9..aab5e3103e 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/dequant_turbo3_0.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dequant_turbo3_0.comp
@@ -10,9 +10,13 @@ layout (binding = 0) readonly buffer A {block_turbo3_0 data_a[];};
 layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};
 
 void main() {
+    // SOURCE OF TRUTH: CENTROIDS_3BIT in ggml/src/ggml-turbo-quant.c. CUDA
+    // (ggml-cuda/turbo-quant.cuh), Metal and SYCL carry the same eight values.
+    // ponytail: five GLSL copies of this table, kept in sync by hand; a shared
+    // include is the upgrade if it drifts again (it drifted once — lane-148).
     const float centroids[8] = float[8](
-        -0.190685, -0.117832, -0.065717, -0.021460,
-         0.021460,  0.065717,  0.117832,  0.190685
+        -0.190207, -0.118786, -0.066822, -0.021663,
+         0.021663,  0.066822,  0.118786,  0.190207
     );
 
     // Each workgroup processes one 128-element block
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_dequant.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_dequant.glsl
index db320689b3..411300f12e 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_dequant.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_dequant.glsl
@@ -149,9 +149,9 @@ layout (binding = 1) readonly buffer K_PACKED_Q5_1_P32 { block_q5_1_packed32 dat
 // alignment (iqs%4 == 0), so all 4 elements share qs byte (iqs/4) and signs
