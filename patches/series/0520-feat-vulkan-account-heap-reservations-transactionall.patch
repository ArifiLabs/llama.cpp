+    heapres_check(ggml_vk_heapres_two_ledgers_isolated(1, 4 * MiB, 4 * MiB),
+                  "same heap index on two ledgers: holds for heap 1 too");
+
+    ggml_vk_heapres_reset();
+    return 0;
+}
