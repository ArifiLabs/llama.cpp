+                    for (int b = 0; b < 8; ++b) {
+                        const uint8_t byte = qs[b];
+                        // Extract 4 two-bit codes, map {0,1,2,3} -> {-1,0,1,2}
+                        sumi += ((int) ((byte >> 0) & 3) - 1) * a_blk->qs[b * 4 + 0];
