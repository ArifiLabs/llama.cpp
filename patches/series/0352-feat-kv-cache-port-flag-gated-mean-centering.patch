         /*.moe_cache_budget_mib        =*/ 0,
+#ifdef GGML_ARIFI_KV_MEANCENTER
+        /*.path_kv_mean_center         =*/ nullptr,
+#endif
         /*.abort_callback              =*/ nullptr,
         /*.abort_callback_data         =*/ nullptr,
         /*.embeddings                  =*/ false,
@@ -4083,6 +4122,15 @@ llama_context * llama_init_from_model(
         }
     }
 
+#ifdef GGML_ARIFI_KV_MEANCENTER
