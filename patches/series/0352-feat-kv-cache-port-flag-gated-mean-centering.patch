+    struct gguf_context * ctx_gguf = gguf_init_from_file(path, gguf_params);
+    if (!ctx_gguf) {
+        LLAMA_LOG_ERROR("%s: failed to load K-cache mean-centering bias file from %s\n", __func__, path);
+        return false;
