From 9ef414e29d762a835ebbfc7f4bafb8592f9d58f2 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Wed, 7 Oct 2026 19:41:27 -0400
Subject: [PATCH] ggml : require input tensors to be GGML_OP_NONE

ggml_set_input now asserts the tensor is a leaf, and the warning in llama_graph_n_input_tensors becomes an
assert. Audit before landing (CHECKED): every ggml_set_input call our stack added since b11178 (23 calls in
llama-graph.cpp incl. the dsv4 inputs and the GDN bank/replay inputs s_copy_bank, s_wrow, rep_ctl, rep_wrow;
eagle3.cpp inp_g; glm5-next.cpp k-pool inputs; qwen4exp.cpp read_rows, fresh_*, blk_*, MTP tokens/embd/h) takes a
tensor fresh from ggml_new_tensor_*; no view or op result is flagged as input. Clean apply.

Taken-from: ggml-org/llama.cpp@b5cf8ce02a (#29647)
Measured-effect: NO RUNTIME EFFECT - guard only, no runtime cost; test-llama-archs over all archs builds every graph under the assert (redgreen-4).
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml.c       | 1 +
 src/llama-context.cpp | 5 +----
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 62a83fe395..bf74f29080 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -8584,6 +8584,7 @@ void ggml_graph_dump_dot(const struct ggml_cgraph * gb, const struct ggml_cgraph
 ////////////////////////////////////////////////////////////////////////////////
 
 void ggml_set_input(struct ggml_tensor * tensor) {
+    GGML_ASSERT(tensor->op == GGML_OP_NONE);
     tensor->flags |= GGML_TENSOR_FLAG_INPUT;
 }
 
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index c71ac2b028..ca087455ba 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -674,10 +674,7 @@ static int llama_graph_n_input_tensors(ggml_cgraph * gf) {
     }
 
     for (const auto & [tensor, nodes] : users) {
-        if (tensor->op != GGML_OP_NONE) {
-            LLAMA_LOG_WARN("%s: input tensor '%32s' has op %s, expected GGML_OP_NONE\n",
-                    __func__, tensor->name, ggml_op_name(tensor->op));
-        }
+        GGML_ASSERT(tensor->op == GGML_OP_NONE);
         for (const ggml_tensor * node : nodes) {
             LLAMA_LOG_DEBUG("%s: input tensor '%32s' [%s, ne = { %5" PRId64 ", %5" PRId64 ", %5" PRId64 ", %5" PRId64 " }] is used by node '%s' (%s)\n",
                     __func__, tensor->name, ggml_type_name(tensor->type),
