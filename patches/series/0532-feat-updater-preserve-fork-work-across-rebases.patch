+```bash
+recorded_by="$(git config --get user.email)"
+[ -n "$recorded_by" ] || recorded_by="$(git config --get user.name)"
+[ -n "$recorded_by" ] || recorded_by="${USER:-${USERNAME:-}}"
+if [ -z "$recorded_by" ] || ! printf '%s' "$recorded_by" | grep -Eq '^[A-Za-z0-9._@+ -]+$'; then
+    echo 'REFUSE: no shell-safe identity for --recorded-by.' >&2
+    echo '        Set one:  git config user.email you@example.invalid' >&2
+    false
+else
+    python tools/arifi-sync/arifi_sync.py protected-win replay-map --ref arifi/main \
+        --retained-ref arifi-pre-rebase --recorded-by "$recorded_by" --write
+fi
+```
