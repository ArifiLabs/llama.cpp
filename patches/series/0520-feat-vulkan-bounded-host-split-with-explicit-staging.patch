+        }
+        ledger = l;
+        heap   = h;
+        bytes  = b;
+        return true;
+    }
+
+    bool release() {
+        if (bytes == 0) {
+            return false;
+        }
+        const uint64_t b = bytes;
+        bytes = 0;
+        return ledger->release(heap, b);
+    }
