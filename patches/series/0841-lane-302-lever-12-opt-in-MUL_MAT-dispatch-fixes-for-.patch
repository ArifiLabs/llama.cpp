From 78a3f7d19b308ee66829c46898b18d64d401a464 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Fri, 9 Oct 2026 07:37:41 -0400
Subject: [PATCH] lane-302 lever 12: opt-in MUL_MAT dispatch fixes for long-K
 small-M weights at verify widths 9..64

Cell AC (cache/moe-gather-x1-lane/cells/cellAC-10090708, perf logger, harness/op_width_split.py) shows
the qwen4exp hyper-connection bf16 matmuls starving the GPU on ngram verify graphs:
hc_attn_inject (m=4, k=10240) runs 1054-1081 us at n 23/31 but 168 us at n 47, because
ggml_vk_guess_split_k only splits when n >= the tile N (32): below it one workgroup walks all of K.
hc_down (m=320, k=10240) runs ~1000 us at n 47..62 on the medium 64x64 tile (5 workgroups) and
584 us at n 65 on the large tile; ~97 calls of each per verify graph.

GGML_ARIFI_MM_SPLITK_SMALLN=1 lets split_k run below the tile N; =2 is a planted wrong arm (the
last split stops 256 short of K, test-backend-ops must go RED). GGML_ARIFI_MM_LARGE_MIN_N=<n0>
(n0 > 32) makes MUL_MAT (not MUL_MAT_ID) take the large tile for m > 64 and n >= n0. Unset = the
stock selection and dispatch, unchanged. Startup line prints both values and the core count.
test-backend-ops: hc bf16 eval cases at n 9..65 and perf cases (+ the served q6_K pair).
Split_k reorders the fp32 K sum, so the S arm is not bit-exact to stock by construction.

Origin: lane-302
Measured-effect: UNMEASURED (opt-in, default OFF; gates + op timing = cell AD)
Lane: lane-302
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 39 +++++++++++++++++++++++++++-
 tests/test-backend-ops.cpp           | 16 ++++++++++++
 2 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 2fed20ddcb..fc39621d8e 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -645,6 +645,26 @@ static uint32_t moe_gather_nounroll_env() {
     return (e != nullptr && (e[0] == '1' || e[0] == '2')) ? (uint32_t) (e[0] - '0') : 0u;
 }
 
+// lane-302 lever 12 (cell AC): verify-width MUL_MAT starves the GPU on long-K / small-M weights (hc_attn_inject 4x10240 at
+// n < 32 = 1 workgroup; hc_down 320x10240 at n 33..64 = 5). Both opt-in until measured; unset = stock selection.
+// GGML_ARIFI_MM_SPLITK_SMALLN: 1 = split_k also when n < the tile's N; 2 = planted wrong arm (drops the K tail, test only)
+static uint32_t mm_splitk_smalln_env() {
+    static const uint32_t v = [] {
+        const char * e = getenv("GGML_ARIFI_MM_SPLITK_SMALLN");
+        return (e != nullptr && (e[0] == '1' || e[0] == '2')) ? (uint32_t) (e[0] - '0') : 0u;
+    }();
+    return v;
+}
+// GGML_ARIFI_MM_LARGE_MIN_N=<n0>: MUL_MAT (not _ID) takes the large tile for m > 64 and n >= n0 (n0 > 32); 0/unset = stock
+static uint32_t mm_large_min_n_env() {
+    static const uint32_t v = [] {
+        const char * e = getenv("GGML_ARIFI_MM_LARGE_MIN_N");
+        const long n0 = e != nullptr ? strtol(e, nullptr, 10) : 0;
+        return n0 > 32 ? (uint32_t) n0 : 0u;
+    }();
+    return v;
+}
+
 // lane-302 Route A: IQ3_S gather grid init (spec 4 of mul_mat_vec_iq3_s.comp), opt-in until measured.
 // 1 = batched loads before stores (byte-identical by construction); 2 = planted wrong arm (test only)
 static uint32_t moe_gather_iq3s_init_env() {
@@ -3280,6 +3300,20 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
             return (uint32_t)configs.size() - 1;
         };
         device->matmul_id_tile_selector = device->matmul_tile_selector;
+        if (mm_large_min_n_env() != 0) {
+            // lane-302 lever 12: MUL_MAT only; the _ID selector keeps the stock copy above
+            device->matmul_tile_selector = [stock = device->matmul_id_tile_selector](uint32_t m, uint32_t n, uint32_t k, uint32_t scc,
+                                              const std::vector<vk_matmul_pipeline_pair>& configs) -> uint32_t {
+                if (configs.size() >= 3 && m > 64 && n >= mm_large_min_n_env()) return (uint32_t)configs.size() - 1;
+                return stock(m, n, k, scc, configs);
+            };
+        }
+    }
+    static bool lever12_logged = false;
+    if (!lever12_logged) {
+        lever12_logged = true;
+        fprintf(stderr, "ggml_vulkan: MUL_MAT small-n split_k %u, large tile min n %u, cores %u (lane-302 lever 12: GGML_ARIFI_MM_SPLITK_SMALLN / _MM_LARGE_MIN_N)\n",
+                mm_splitk_smalln_env(), mm_large_min_n_env(), device->shader_core_count);
     }
 
     // mul mat vec
@@ -7664,7 +7698,7 @@ static uint32_t ggml_vk_guess_split_k(ggml_backend_vk_context * ctx, uint32_t m,
     }
 
     uint32_t split_k = 1;
-    if (ctx->device->shader_core_count != 0 && n >= pipeline->wg_denoms[1]) {
+    if (ctx->device->shader_core_count != 0 && (n >= pipeline->wg_denoms[1] || mm_splitk_smalln_env() != 0)) {
         // If k is 'large' and the SMs will fill less than halfway, use split_k.
         uint32_t m_tiles = CEIL_DIV(m, pipeline->wg_denoms[0]);
         uint32_t n_tiles = CEIL_DIV(n, pipeline->wg_denoms[1]);
@@ -7729,6 +7763,9 @@ void ggml_vk_matmul(
     // Round the split size up to a multiple of 256 (k-quant alignment)
     uint32_t k_split = CEIL_DIV(k, split_k);
     k_split = ROUNDUP_POW2(k_split, 256);
+    if (mm_splitk_smalln_env() == 2 && n < pipeline->wg_denoms[1] && k_split > 256) {
+        k_split -= 256; // lane-302 lever 12 planted wrong arm: the last split stops short of K
+    }
 
     ggml_pipeline_request_descriptor_sets(ctx, pipeline, CEIL_DIV(batch, ctx->device->properties.limits.maxComputeWorkGroupCount[2]));
 
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index d7095b5898..12a5711150 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -12019,6 +12019,13 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         }
     }
     test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_Q4_0, GGML_TYPE_F32, 32, 2, false, 2880, 32, 2880));
+    // arifi lane-302 lever 12: qwen4exp hyper-connection bf16 weights at the ngram verify widths
+    // (hc_attn_inject 4x10240, hc_down 320x10240, hc_up 10240x320); n straddles the 32 / 64 tile edges
+    for (int n : {9, 16, 23, 31, 32, 33, 47, 62, 64, 65}) {
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, 4, n, 10240, {1, 1}, {1, 1}));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, 320, n, 10240, {1, 1}, {1, 1}));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, 10240, n, 320, {1, 1}, {1, 1}));
+    }
 
     // multiple blocks per row: exercises the block-stride loop and the
     // per-expert base offset, which k == 256 alone leaves untested
@@ -13018,6 +13025,15 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
         test_cases.emplace_back(new test_mul_mat(type, GGML_TYPE_F32, 12288, 4096, 2560, {1, 1}, {1, 1}));
     }
 
+    // arifi lane-302 lever 12: qwen4exp hc bf16 matmuls + the served dense q6_K pair at the ngram verify widths
+    for (int n : {16, 23, 31, 33, 47, 62, 65}) {
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, 4, n, 10240, {1, 1}, {1, 1}));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, 320, n, 10240, {1, 1}, {1, 1}));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, 10240, n, 320, {1, 1}, {1, 1}));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q6_K, GGML_TYPE_F32, 2560, n, 6144, {1, 1}, {1, 1}));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q6_K, GGML_TYPE_F32, 10240, n, 2560, {1, 1}, {1, 1}));
+    }
+
     // lane 301 lever 4: QSA mask chain + FA at served decode/prefill shapes (fused vs GGML_ARIFI_QSA_MASKFUSE=0, RGP target)
     test_cases.emplace_back(new test_qsa_mask_fa(8192,  1,  1, 2051));
     test_cases.emplace_back(new test_qsa_mask_fa(32768, 1,  1, 2051));
