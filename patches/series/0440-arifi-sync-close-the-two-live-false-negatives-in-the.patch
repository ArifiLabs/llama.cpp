+                "commit": self.win_sha, "protected_paths": ["ggml/kernel.c"],
+                "anchors": ["ARIFI_FAST_PATH"], "evidence": ["commit:" + self.win_sha],
+                "quality_gate": "byte-identical output", "workload": "the seat serve line",
