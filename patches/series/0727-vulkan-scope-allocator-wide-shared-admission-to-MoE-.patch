             throw vk::OutOfDeviceMemoryError("NVME_LOCAL_PLACEMENT_REQUIRED");
         }
         if (mem_props.memoryTypes[planned->type].propertyFlags & vk::MemoryPropertyFlagBits::eHostVisible) {
