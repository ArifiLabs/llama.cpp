+    (TURBO,   "CENTROIDS_4BIT",  "flash_attn_dequant.glsl", "c#2"),
     (WEIGHTS, "TQ3_0_CENTROIDS", "mul_mat_vec_tq3_1s.comp", "TQ3_CENTROIDS"),
