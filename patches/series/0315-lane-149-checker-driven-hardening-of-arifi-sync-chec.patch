+    ("mul_mat_vec_q6_k.comp", "sum"):
+        "local accumulator zero-init (FLOAT_TYPE sum[4] = {0,0,0,0}), not a mirror",
     ("types.glsl", "iq2s_grid_const"):
         "upstream iq2s grid, same uvec2 packing as iq2xs_grid_const",
