From eeb2f8aeab829743360a01d205186e1e8a6e36af Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Mon, 17 Aug 2026 23:52:50 -0400
Subject: [PATCH] lane-149 checker-driven hardening of arifi-sync-check:
 FA_TYPE/QUANT_K literal spellings, ordinal (not line) pins, per-definition
 completeness, any array type, recursive shader walk, scalar-mirror class,
 expected-count assertions

---
 ggml/src/ggml-vulkan/arifi_sync_check.py | 143 +++++++++++++++++------
 1 file changed, 109 insertions(+), 34 deletions(-)

diff --git a/ggml/src/ggml-vulkan/arifi_sync_check.py b/ggml/src/ggml-vulkan/arifi_sync_check.py
index 9da2e41ca..3f38d791c 100644
--- a/ggml/src/ggml-vulkan/arifi_sync_check.py
+++ b/ggml/src/ggml-vulkan/arifi_sync_check.py
@@ -80,7 +80,9 @@ def initialiser(text, idx):
                 return text[start + 1:i]
     return ""
 
-GLSL_ARRAY = re.compile(r"(?:const\s+)?(?:float|uint|int|uint32_t|int8_t|uint8_t|uvec2|vec4)\s+"
+# ANY type, not a fixed list: the first version enumerated (float|uint|...) and a LUT declared
+# `float16_t` or `f16vec2` walked straight past completeness (lane-149 checker, finding 6).
+GLSL_ARRAY = re.compile(r"(?:const\s+)?(?:[A-Za-z_]\w*)\s+"
                         r"(?P<name>[A-Za-z_]\w*)\s*\[\s*(?P<n>[0-9]+)\s*\]\s*=")
 C_ARRAY = re.compile(r"(?:static\s+)?(?:__constant__\s+|constexpr\s+)?(?:const\s+)?"
                      r"(?:float|double|int8_t|uint8_t|int|uint32_t)\s+"
@@ -139,11 +141,11 @@ PAIRS = [
