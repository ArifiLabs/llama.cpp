+                const block_tq3_1s_shift * w = (const block_tq3_1s_shift *) vx + blk;
+                const float d0 = GGML_CPU_FP16_TO_FP32(w->d0);
+                const float d1 = GGML_CPU_FP16_TO_FP32(w->d1);
+                const float m  = GGML_CPU_FP16_TO_FP32(w->m);
