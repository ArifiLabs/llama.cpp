+            idx[2] = ((q[0] >> 6) | (q[1] << 2)) & 7;
+            idx[3] = (q[1] >> 1) & 7;
+            idx[4] = (q[1] >> 4) & 7;
+            idx[5] = ((q[1] >> 7) | (q[2] << 1)) & 7;
+            idx[6] = (q[2] >> 2) & 7;
+            idx[7] = (q[2] >> 5) & 7;
