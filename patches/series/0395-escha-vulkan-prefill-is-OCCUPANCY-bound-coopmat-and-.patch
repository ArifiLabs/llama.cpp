From 58f96ce780e6e7f04a1421a6a5607818247b1096 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Fri, 21 Aug 2026 13:15:20 -0400
Subject: [PATCH] escha vulkan: prefill is OCCUPANCY-bound - coopmat and wider
 rungs both refuted, and the profile that said otherwise was lying

PREFILL HAD NEVER BEEN PROFILED. The decode profile existed and was used all day as if it described
both. Profiling prefill directly showed ESCHA_MM ABSENT from the capture entirely - the chunked
escha dispatch calls buf.dispatch directly and the perf logger never sees it. The captured ops summed
to 1.77 s against the logger's own 28.8 s total, so the visible ranking described 6% of the time.
Any conclusion drawn from that ranking would have been drawn from noise; the escha matmul is ~94% of
prefill, as it is of decode.

COOPERATIVE MATRIX: built, correct, ACTIVE, and worth nothing.
    scalar    pp512 16.92 / 16.66
    coopmat   pp512 16.78 / 16.60
Two things had to be fixed before that number meant anything. The build had never defined
GGML_VULKAN_COOPMAT_GLSLC_SUPPORT, so the arm was compiled out and the first A/B compared scalar to
scalar; a reconfigure enabled it. Then a stale GGML_VK_ESCHA_NO_COOPMAT left in a shell session made
the second A/B do the same. Both were caught only by an engagement probe that prints whether the arm
actually engaged - without it this would have shipped as "matrix cores give nothing", closing a lever
that had never once run. The probe stays.
It gives nothing because it accelerates the ACCUMULATE, and the cost here is the per-weight decode.

WIDER RUNGS: built, correct, and much worse.
    cap 16   pp512 17.08 / 16.89
    cap 32   pp512 15.51 / 15.23
    cap 64   pp512  6.82 /  6.63
Sharing one decode across more columns is real work saved, and it is swamped by what pays for it:
staging costs C*128*4 bytes of shared memory, so C=64 takes the whole 32 KiB the 780M reports and
exactly one workgroup fits per compute unit. Prefill at these sizes is OCCUPANCY-bound, not
decode-count-bound. That is the first time today this kernel's actual limiter has been named with a
measurement rather than inferred.

Leaving the wide rungs selectable by default was a live 60% prefill regression I introduced and then
measured; the top rung is now pinned to 16 and the wide ones are opt-in through
GGML_VK_ESCHA_MAX_COLS, which flips on a device with more shared memory.

The finding names the next lever precisely: cut shared memory PER WORKGROUP rather than widen the
block. Staging activations as f16 halves it.

Correctness: test-backend-ops -o ESCHA_MM, 30 cases, 0 FAIL, now including C=32 and C=64 full and
ragged plus model depth - the previous corpus topped out at 17 columns and never entered the rungs
it was being used to clear.

Origin: ArifiLabs (native)
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp          |  87 ++++++++++-
 .../ggml-vulkan/vulkan-shaders/escha_mm.comp  | 139 ++++++++++++++++++
 .../vulkan-shaders/vulkan-shaders-gen.cpp     |  16 ++
 tests/test-backend-ops.cpp                    |  10 ++
 4 files changed, 249 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 60b7d3379..3a8cc760f 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -1075,7 +1075,9 @@ struct vk_device_struct {
     vk_pipeline pipeline_escha_mm[2];    // [0]=ESCHA2 (K=2), [1]=ESCHA3 (K=3) — lane-164
     vk_pipeline pipeline_escha_mm_mc[2]; // same, multi-column (ESCHA_MM_COLS per workgroup)
     // Column ladder (seat-40), indexed [rung][K]. Rung r serves ESCHA_COL_RUNGS[r] columns.
-    vk_pipeline pipeline_escha_mm_col[4][2];
+    vk_pipeline pipeline_escha_mm_col[6][2];
+    // KHR cooperative-matrix C=16 arm, f16 operands with an f32 accumulator.
+    vk_pipeline pipeline_escha_mm_cm[2];
     vk_pipeline pipeline_escha_mm_lut[2];   // table-generator arm (seat-40)
     vk_buffer   escha_lut;                  // 65,536 f16 generator values, 128 KiB
     vk_pipeline pipeline_escha_mm_b2[2]; // same, 256 threads over two output blocks (seat-40)
@@ -6074,6 +6076,20 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
     ggml_vk_create_pipeline(device, device->pipeline_escha_mm_col[2][1], "escha_mm_k3_c8_f32", escha_mm_k3_c8_f32_len, escha_mm_k3_c8_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
     ggml_vk_create_pipeline(device, device->pipeline_escha_mm_col[3][0], "escha_mm_k2_c16_f32", escha_mm_k2_c16_f32_len, escha_mm_k2_c16_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
     ggml_vk_create_pipeline(device, device->pipeline_escha_mm_col[3][1], "escha_mm_k3_c16_f32", escha_mm_k3_c16_f32_len, escha_mm_k3_c16_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
+    ggml_vk_create_pipeline(device, device->pipeline_escha_mm_col[4][0], "escha_mm_k2_c32_f32", escha_mm_k2_c32_f32_len, escha_mm_k2_c32_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
+    ggml_vk_create_pipeline(device, device->pipeline_escha_mm_col[4][1], "escha_mm_k3_c32_f32", escha_mm_k3_c32_f32_len, escha_mm_k3_c32_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
+    ggml_vk_create_pipeline(device, device->pipeline_escha_mm_col[5][0], "escha_mm_k2_c64_f32", escha_mm_k2_c64_f32_len, escha_mm_k2_c64_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
+    ggml_vk_create_pipeline(device, device->pipeline_escha_mm_col[5][1], "escha_mm_k3_c64_f32", escha_mm_k3_c64_f32_len, escha_mm_k3_c64_f32_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
+#if defined(VK_KHR_cooperative_matrix) && defined(GGML_VULKAN_COOPMAT_GLSLC_SUPPORT)
+    // Escha's cooperative arm maps one 128-output workgroup to eight 16x16x16
+    // subgroup tiles.  It has an explicit 32/64-lane layout, so require the
+    // driver to honour the selected subgroup size rather than assuming it.
+    if (device->coopmat_support && device->coopmat_support_16x16x16_f32acc &&
+        device->subgroup_size_control && (device->subgroup_size == 32 || device->subgroup_size == 64)) {
+        ggml_vk_create_pipeline(device, device->pipeline_escha_mm_cm[0], "escha_mm_k2_c16_f32_cm1", escha_mm_k2_c16_f32_cm1_len, escha_mm_k2_c16_f32_cm1_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1, false, true, device->subgroup_size);
+        ggml_vk_create_pipeline(device, device->pipeline_escha_mm_cm[1], "escha_mm_k3_c16_f32_cm1", escha_mm_k3_c16_f32_cm1_len, escha_mm_k3_c16_f32_cm1_data, "main", 4, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1, false, true, device->subgroup_size);
+    }
+#endif
     ggml_vk_create_pipeline(device, device->pipeline_escha_mm_lut[0], "escha_mm_k2_lut_f32", escha_mm_k2_lut_f32_len, escha_mm_k2_lut_f32_data, "main", 5, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
     ggml_vk_create_pipeline(device, device->pipeline_escha_mm_lut[1], "escha_mm_k3_lut_f32", escha_mm_k3_lut_f32_len, escha_mm_k3_lut_f32_data, "main", 5, sizeof(vk_op_escha_mm_push_constants), {1, 1, 1}, {}, 1);
 
@@ -10533,7 +10549,10 @@ static void ggml_vk_escha_mm(ggml_backend_vk_context * ctx, vk_context& subctx,
     //
     // Pick the SMALLEST rung that covers ncols, and the largest rung once ncols exceeds it: below
     // the top rung a bigger C only adds idle lanes, above it a bigger C removes whole decode passes.
-    static const uint32_t ESCHA_COL_RUNGS[4] = { 2, 4, 8, 16 };
+    // kidx selects the K=2 or K=3 pipeline family; the rung skip below needs it, so it is
+    // declared before rung selection rather than after.
+    const int kidx = src0->type == GGML_TYPE_ESCHA3 ? 1 : 0;
+    static const uint32_t ESCHA_COL_RUNGS[6] = { 2, 4, 8, 16, 32, 64 };
     // Cap the ladder for A/B work: GGML_VK_ESCHA_MAX_COLS=8 makes a 10-column batch take C8 twice
     // instead of C16 once, which is the comparison that decides whether the widest rung earns its
     // register pressure. Unset means no cap.
@@ -10541,7 +10560,28 @@ static void ggml_vk_escha_mm(ggml_backend_vk_context * ctx, vk_context& subctx,
     static const uint32_t max_cols = max_cols_env ? (uint32_t) atoi(max_cols_env) : 0u;
     int rung = -1;
     if (!no_multicol && ncols >= 2) {
+        // TOP RUNG IS 16 BY MEASUREMENT, not by what exists. C=32 and C=64 are built and correct,
+        // and both are SLOWER, because this kernel is occupancy-bound at prefill sizes rather than
+        // decode-count-bound. Staging costs C*128*4 bytes of shared memory, so C=64 takes the whole
+        // 32 KiB the 780M reports and only ONE workgroup fits per compute unit:
+        //     cap 16   pp512 17.08 / 16.89
+        //     cap 32   pp512 15.51 / 15.23
+        //     cap 64   pp512  6.82 /  6.63
+        // Sharing one decode across more columns is real work saved and it is swamped by the loss
+        // of parallelism that pays for it. The wide rungs stay reachable through
+        // GGML_VK_ESCHA_MAX_COLS because the trade flips on a device with more shared memory.
+        //
+        // This also names the NEXT prefill lever properly: reduce shared memory PER WORKGROUP
+        // rather than widen the block - staging activations as f16 would halve it.
         int top = 3;
+        while (top > 0 && ctx->device->pipeline_escha_mm_col[top][kidx] == nullptr) { --top; }
+        if (max_cols > ESCHA_COL_RUNGS[top]) {
+            // an explicit cap ABOVE the measured default opts back into the wide rungs
+            int want = 5;
+            while (want > top && (ctx->device->pipeline_escha_mm_col[want][kidx] == nullptr ||
+                                  ESCHA_COL_RUNGS[want] > max_cols)) { --want; }
+            top = want;
+        }
         while (top > 0 && max_cols && ESCHA_COL_RUNGS[top] > max_cols) { --top; }
         rung = top;                                 // widest rung allowed
         for (int r = 0; r <= top; ++r) {
@@ -10572,11 +10612,52 @@ static void ggml_vk_escha_mm(ggml_backend_vk_context * ctx, vk_context& subctx,
     static const bool want_lut = getenv("GGML_VK_ESCHA_LUT") != nullptr;
     const bool use_lut = want_lut && !use_mc && !use_b2;
 
-    const int kidx = src0->type == GGML_TYPE_ESCHA3 ? 1 : 0;
+
+    // Matrix-core prefill arm.  A KHR cooperative matrix has a fixed N=16 tile,
+    // so C=16 is the only ladder rung that maps without throwing away columns.
+    // It is default-on only for a device that *reported* the exact f16xf16->f32
+    // 16x16x16 shape, supports forcing its 32/64-lane subgroup, and actually
+    // created the pipeline. GGML_VK_ESCHA_NO_COOPMAT is the A/B escape hatch.
+    //
+    // Measurement: unmeasured at authoring time by instruction; run the command
+    // in lane-164 evidence before changing this default or claiming a speedup.
+#if defined(VK_KHR_cooperative_matrix) && defined(GGML_VULKAN_COOPMAT_GLSLC_SUPPORT)
+    static const bool no_coopmat = getenv("GGML_VK_ESCHA_NO_COOPMAT") != nullptr;
+    const bool use_cm = use_mc && rung == 3 && !no_coopmat &&
+                        ctx->device->coopmat_support_16x16x16_f32acc &&
+                        ctx->device->subgroup_size_control &&
+                        (ctx->device->subgroup_size == 32 || ctx->device->subgroup_size == 64) &&
+                        ctx->device->pipeline_escha_mm_cm[kidx] != nullptr;
+#endif
+
     vk_pipeline pipeline = use_mc  ? ctx->device->pipeline_escha_mm_col[rung][kidx]
                          : use_b2  ? ctx->device->pipeline_escha_mm_b2[kidx]
                          : use_lut ? ctx->device->pipeline_escha_mm_lut[kidx]
                                    : ctx->device->pipeline_escha_mm[kidx];
+#if defined(VK_KHR_cooperative_matrix) && defined(GGML_VULKAN_COOPMAT_GLSLC_SUPPORT)
+    if (use_cm) {
+        pipeline = ctx->device->pipeline_escha_mm_cm[kidx];
+    }
+    // PROVE IT ENGAGES. A silent fallback here would make the coopmat arm identical to the scalar
+    // one, and an A/B of two identical binaries reads as "no gain" rather than "never ran" - the
+    // exact shape of F-112, where a bucket printed OK while executing nothing. One line, once.
+    {
+        // Announce on the first WIDE-RUNG dispatch, not the first dispatch of any kind. The first
+        // call in a run is single-column decode, where the coopmat arm is correctly inactive, and
+        // announcing there reports "inactive" for a run that goes on to use it heavily.
+        static bool announced = false;
+        if (!announced && rung == 3) {
+            announced = true;
+            GGML_LOG_INFO("escha_mm: coopmat arm %s (mc=%d rung=%d shape16=%d sgctl=%d sg=%u pipe=%d)\n",
+                use_cm ? "ACTIVE" : "inactive", (int) use_mc, rung,
+                (int) ctx->device->coopmat_support_16x16x16_f32acc,
+                (int) ctx->device->subgroup_size_control,
+                ctx->device->subgroup_size,
+                (int) (ctx->device->pipeline_escha_mm_cm[kidx] != nullptr),
+                (int) no_coopmat, (int) use_cm);
+        }
+    }
+#endif
     const uint32_t cols_per_wg = use_mc ? ESCHA_COL_RUNGS[rung] : 1;
     const uint32_t out_per_wg  = use_b2 ? 256u : 128u;
     GGML_ASSERT(pipeline != nullptr);
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
index 5afce0c71..60389ad37 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
@@ -1,9 +1,17 @@
 #version 450
 
+#ifndef ESCHA_COOPMAT
+#define ESCHA_COOPMAT 0
+#endif
+
 #extension GL_EXT_control_flow_attributes : require
 #extension GL_KHR_shader_subgroup_basic : require
 #extension GL_KHR_shader_subgroup_shuffle : require
 #extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#if ESCHA_COOPMAT
+#extension GL_KHR_cooperative_matrix : require
+#extension GL_KHR_memory_scope_semantics : require
+#endif
 
 // ArifiLabs Escha-W2 fused linear mat-vec (lane-164).
 //
@@ -102,6 +110,16 @@ layout (binding = 4) readonly buffer L { uint data_l[]; };   // 32768 uints = 65
 
 shared float sh[NB][NC][128];
 
+// The cooperative-matrix arm is deliberately C=16 only: the KHR shape selected
+// by the host is 16x16x16, so a smaller ladder rung would merely burn inactive
+// matrix lanes.  Per workgroup this is 8 KiB sh + 4 KiB weights + 512 B inputs
+// + 8 KiB result = 20,992 B, safely below the 32 KiB reported by the 780M.
+#if ESCHA_COOPMAT
+shared float16_t cm_weight[128 * 16]; // [output lane][16 input lanes], row-major
+shared float16_t cm_input [16 * 16];  // [input lane][activation column], row-major
+shared float     cm_output[128 * 16]; // [activation column][output lane], column-major
+#endif
+
 const float INV_SQRT128 = 0.08838834764831845;
 
 #if ESCHA_K == 2
@@ -342,6 +360,126 @@ void hadamard128(uint hb, uint tid) {
 #endif
 }
 
+#if ESCHA_COOPMAT
+// Matrix-core multi-column path.  Each subgroup owns gl_SubgroupSize/16 of the
+// eight 16-output tiles.  The pipeline forces either a 32- or 64-lane subgroup,
+// so the four-element accumulator array covers both supported layouts.
+//
+// `sums` is f32 even though the operands are f16.  The host only selects this
+// shader after confirming the device's 16x16x16 f16xf16->f32 KHR property.
+void main() {
+    const uint tid  = gl_LocalInvocationID.x;
+    const uint ob   = gl_WorkGroupID.x;
+    const uint col0 = p.col_offset + gl_WorkGroupID.y * 16u;
+
+    const uint tiles_per_subgroup = gl_SubgroupSize / 16u;
+    const uint subgroup_tile_base = gl_SubgroupID * tiles_per_subgroup;
+
+    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> mat_a;
+    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mat_b;
+    coopmat<float,     gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> sums[4];
+    [[unroll]] for (uint ct = 0u; ct < 4u; ++ct) {
+        sums[ct] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
+    }
+
+    const uint n_ib = p.n_in / 128u;
+    for (uint ib = 0u; ib < n_ib; ++ib) {
+        const uint  gi  = ib * 128u + tid;
+        const float rin = data_c[gi];
+        [[unroll]] for (uint cj = 0u; cj < 16u; ++cj) {
+            const uint cc = min(col0 + cj, p.ncols - 1u);
+            sh[0][cj][tid] = data_b[cc * p.n_in + gi] * rin;
+        }
+        barrier();
+        hadamard128(0u, tid);
+
+        // One 16-wide K slab at a time.  Every thread decodes the 16 weights for
+        // its output lane once, then all 16 columns consume that shared f16 slab.
+        for (uint t = 0u; t < 8u; ++t) {
+            const uint ot   = ob * 8u + (tid >> 4u);
+            const uint tcol = tid & 15u;
+            const uint colbase = tcol & 7u;
+            const uint lhi     = ((colbase >> 1u) << 3u) | ((colbase & 1u) << 2u);
+            const uint c0      = (tcol >= 8u) ? 0u : 4u;
+            const uint it      = ib * 8u + t;
+            const uint base    = (it * p.Tout + ot) * TILE_U32S;
+
+            [[unroll]] for (uint b = 0u; b < 4u; ++b) {
+                const uint lane = lhi + b;
+#if ESCHA_K == 2
+                const uint pw   = (lane >> 1u) & 15u;
+                const uint qw   = (pw + 15u) & 15u;
+                const uint word = shr64_32(data_a[base + pw], data_a[base + qw], ((lane & 1u) == 0u) ? 16u : 0u);
+                [[unroll]] for (uint k = 0u; k < 4u; ++k) {
+                    const uint c   = c0 + k;
+                    const uint row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
+                    cm_weight[tid * 16u + row] = float16_t(escha_F((word >> (2u*c)) & 0xFFFFu));
+                }
+#else
+                const uint tt   = 24u * lane;
+                const uint aa   = tt + 755u;
+                const uint bb   = tt + 791u;
+                const uint sh0  = ((bb & 2016u) - tt) - 760u;
+                const uint hw   = (lane == 0u) ? 23u : ((aa >> 5u) - 24u);
+                const uint lw   = (((bb >> 3u) & 252u) - 96u) >> 2u;
+                const uint zlo  = data_a[base + lw];
+                const uint zhi  = data_a[base + hw];
+                const uint pp   = shr64_32(zlo, zhi, sh0);
+                const uint rr   = shr64_32(zlo, zhi, sh0 + 12u);
+                [[unroll]] for (uint k = 0u; k < 4u; ++k) {
+                    const uint c   = c0 + k;
+                    const uint row = 2u*b + (1u - (c & 1u)) + 8u*(1u - ((c >> 1u) & 1u));
+                    const uint win = (c < 4u) ? (pp >> (3u*c)) : (rr >> (3u*(c - 4u)));
+                    cm_weight[tid * 16u + row] = float16_t(escha_F(win & 0xFFFFu));
+                }
+#endif
+            }
+
+            // Pack the f32 Hadamard output to the f16 operand required by KHR
+            // coopmat.  Ragged C=16 blocks duplicate their last valid column,
+            // exactly like the scalar ladder, and the final store remains guarded.
+            [[unroll]] for (uint i = tid; i < 256u; i += 128u) {
+                const uint row = i >> 4u;
+                const uint cj  = i & 15u;
+                cm_input[i] = float16_t(sh[0][cj][t * 16u + row]);
+            }
+            barrier();
+
+            [[unroll]] for (uint ct = 0u; ct < 4u; ++ct) {
+                if (ct < tiles_per_subgroup) {
+                    coopMatLoad(mat_a, cm_weight, (subgroup_tile_base + ct) * 16u * 16u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+                    coopMatLoad(mat_b, cm_input, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+                    sums[ct] = coopMatMulAdd(mat_a, mat_b, sums[ct]);
+                }
+            }
+            barrier(); // both subgroups finished reading the staged K slab
+        }
+    }
+
+    [[unroll]] for (uint ct = 0u; ct < 4u; ++ct) {
+        if (ct < tiles_per_subgroup) {
+            coopMatStore(sums[ct], cm_output, (subgroup_tile_base + ct) * 16u, 128u, gl_CooperativeMatrixLayoutColumnMajor);
+        }
+    }
+    barrier();
+
+    [[unroll]] for (uint cj = 0u; cj < 16u; ++cj) {
+        sh[0][cj][tid] = cm_output[cj * 128u + tid];
+    }
+    barrier();
+    hadamard128(0u, tid);
+
+    const uint  oc   = ob * 128u + tid;
+    const float rout = data_c[p.n_in + oc];
+    const float bias = data_c[p.n_in + p.n_out + oc];
+    [[unroll]] for (uint cj = 0u; cj < 16u; ++cj) {
+        const uint cc = col0 + cj;
+        if (cc < p.ncols) {
+            data_d[cc * p.n_out + oc] = sh[0][cj][tid] * (INV_SQRT128 * INV_SQRT128) * rout + bias;
+        }
+    }
+}
+#else
 void main() {
     const uint hb   = gl_LocalInvocationID.x >> 7u;          // which output block within the group
     const uint tid  = gl_LocalInvocationID.x & 127u;         // thread within that block
@@ -451,3 +589,4 @@ void main() {
         }
     }
 }
+#endif // ESCHA_COOPMAT
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
index bc185e3d9..6e2fbacbb 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
@@ -1229,6 +1229,22 @@ void process_shaders() {
     string_to_spv("escha_mm_k3_c8_f32", "escha_mm.comp", {{"ESCHA_K", "3"}, {"ESCHA_COLS", "8"}});
     string_to_spv("escha_mm_k2_c16_f32", "escha_mm.comp", {{"ESCHA_K", "2"}, {"ESCHA_COLS", "16"}});
