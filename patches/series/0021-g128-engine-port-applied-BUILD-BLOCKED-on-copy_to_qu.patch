+void quantize_row_q2_0_g128_ref(const float * GGML_RESTRICT x, block_q2_0_g128 * GGML_RESTRICT y, int64_t k) {
+    static const int qk = QK2_0_G128;
+
+    assert(k % qk == 0);
+
+    const int nb = k / qk;
+
+    for (int i = 0; i < nb; ++i) {
+        float amax = 0.0f;
+        for (int j = 0; j < qk; ++j) {
+            const float a = fabsf(x[i*qk + j]);
+            if (a > amax) {
+                amax = a;
+            }
+        }
+
+        const float d  = amax;
+        const float id = d > 0.0f ? 1.0f / d : 0.0f;
+
+        y[i].d = GGML_FP32_TO_FP16(d);
+
+        for (int j = 0; j < qk / 4; ++j) {
+            y[i].qs[j] = 0;
+        }
+
+        // Encode {-1, 0, +1, +2} as {0, 1, 2, 3}, four values per byte.
+        for (int j = 0; j < qk; ++j) {
+            int q = (int) roundf(x[i*qk + j] * id) + 1;
+            q = MAX(0, MIN(3, q));
+
+            y[i].qs[j / 4] |= (uint8_t) q << (2 * (j % 4));
+        }
+    }
+}
