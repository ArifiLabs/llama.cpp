+    // releases it from ~vk_buffer_struct; releasing it here as well would underflow the ledger.
+    for (auto & e : plan->entries) {
+        if (!e.consumed) {
+            plan->device->heap_ledger.release(e.heap, e.bytes);
+            e.consumed = true;
+        }
+    }
+    delete plan;
+}
