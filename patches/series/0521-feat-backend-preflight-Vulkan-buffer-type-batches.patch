+static void ggml_backend_vk_buffer_type_plan_free(ggml_backend_buffer_type_t buft, ggml_backend_buffer_type_plan_t plan_handle) {
+    UNUSED(buft);
+    vk_buffer_plan * plan = reinterpret_cast<vk_buffer_plan *>(plan_handle);
