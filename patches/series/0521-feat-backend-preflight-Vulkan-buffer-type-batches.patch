+    for (size_t i = 0; i < n; ++i) {
+        const vk_plan_candidate & c = cands[i][choice[i]];
+        plan->entries[i].type  = c.type;
+        plan->entries[i].heap  = c.heap;
+        plan->entries[i].bytes = c.bytes;
+        plan->entries[i].flags = type_flags[c.type];
+    }
