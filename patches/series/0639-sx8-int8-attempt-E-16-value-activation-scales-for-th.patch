diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1.comp
index 64f860a7f0..4f30216a2b 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1.comp
@@ -109,6 +109,10 @@ shared float buf_b_d[BN * BK_STEP];
 #if defined(DATA_A_SX8)
 // S-X8: exact integer activation sums, one partial per 16-value half block (loadr_b 0/1), not the fp16 ds.y.
 shared float buf_b_s[BN * BK_STEP * 2];
+#if defined(SX8_H16)
+// attempt E: one activation scale per 16-value half block (quantize_q8_1 HALF=1).
+shared float buf_b_dh[BN * BK_STEP * 2];
+#endif
 #elif defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1) || defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
 shared float buf_b_s[BN * BK_STEP];
 #endif
@@ -362,6 +366,62 @@ void main() {
                     }
                 }
             }
+#elif defined(SX8_H16)
+            // attempt E: S-X8 with one B scale per 16-value half. TK == 16 (RDNA3/4 int8 WMMA), so K_SUB == 2 and MMA h
+            // covers exactly half h; each half gets its own int32 accumulator and its own d_b. The min term uses the
+            // exact half sums: m_a * (d0 * s0 + d1 * s1).
+            coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cache_a[cms_per_row * K_SUB];
+            coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> cache_b[cms_per_col * K_SUB];
+
+            [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
+                [[unroll]] for (uint h = 0; h < K_SUB; h++) {
+                    coopMatLoad(cache_a[r * K_SUB + h], buf_a_qs, (a_row0 + r * TM) * QPITCH + ks * (BK / 4) + h * (TK / 4), QPITCH, gl_CooperativeMatrixLayoutRowMajor);
+                }
+            }
+            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
+                [[unroll]] for (uint h = 0; h < K_SUB; h++) {
+                    coopMatLoad(cache_b[c * K_SUB + h], buf_b_qs, (b_col0 + c * TN) * QPITCH + ks * (BK / 4) + h * (TK / 4), QPITCH, gl_CooperativeMatrixLayoutColumnMajor);
+                }
+            }
+
+            float scale_bh[cms_per_col * K_SUB];
+            float bs[cms_per_col];
+            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
+                const uint bsi = (ks * BN + b_col0 + c * TN + elem_col0) * 2;
+                [[unroll]] for (uint h = 0; h < K_SUB; h++) {
+                    scale_bh[c * K_SUB + h] = buf_b_dh[bsi + h];
+                }
+                bs[c] = buf_b_dh[bsi] * buf_b_s[bsi] + buf_b_dh[bsi + 1] * buf_b_s[bsi + 1];
+            }
+
+            [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
+                float scale_a[CM_ELEMS];
+                float nbias_a[CM_ELEMS];
+                float ma[CM_ELEMS];
+                [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
+                    vec2 dm = buf_a_dm[ks * BM + a_row0 + r * TM + cm_elem_row(e)];
+                    scale_a[e] = dm.x;
+                    if (USE_MAGIC_BIAS) {
+                        nbias_a[e] = -ACC_BIAS_F * scale_a[e];
+                    }
+                    ma[e] = dm.y;
+                }
+
+                [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
+                    const uint tile_idx = r * cms_per_col + c;
+                    [[unroll]] for (uint h = 0; h < K_SUB; h++) {
+                        coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc =
+                            coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(
+                                USE_MAGIC_BIAS ? ACC_BIAS_BITS : 0);
+                        acc = coopMatMulAdd(cache_a[r * K_SUB + h], cache_b[c * K_SUB + h], acc);
+                        [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
+                            sums[tile_idx * CM_ELEMS + e] = cm1_accumulate(
+                                sums[tile_idx * CM_ELEMS + e], int(acc[e]),
+                                scale_a[e], nbias_a[e], scale_bh[c * K_SUB + h], h == 0 ? ma[e] * bs[c] : 0.0);
+                        }
+                    }
+                }
+            }
 #elif defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1) || defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K) || defined(DATA_A_SX8)
             // Preload all A/B fragments up front (ILP).
             coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cache_a[cms_per_row * K_SUB];
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1_funcs.glsl
index e705ed821e..cf1e336efa 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mmq_cm1_funcs.glsl
@@ -561,7 +561,12 @@ struct block_b_prefetch {
 block_b_prefetch block_b_load(uint ib_outer, uint ib_inner, uint loadr) {
     block_b_prefetch blk;
     blk.qs = data_b[ib_outer].qs[ib_inner * 2 + loadr];
+#if defined(SX8_H16)
+    // attempt E: ds = (d0, d1), one scale per 16-value half; loadr 0/1 is exactly that half.
+    blk.d = loadr == 0 ? data_b[ib_outer].ds[ib_inner].x : data_b[ib_outer].ds[ib_inner].y;
+#else
     blk.d = data_b[ib_outer].ds[ib_inner].x;
+#endif
 #if defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1) || defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
     blk.s = data_b[ib_outer].ds[ib_inner].y;
 #endif
@@ -589,6 +594,9 @@ void block_b_to_shmem(block_b_prefetch blk, uint buf_ib, uint ks, uint loadr, bo
         ps += int(q.x) + int(q.y) + int(q.z) + int(q.w);
     }
     buf_b_s[(ks * BN + buf_ib) * 2 + loadr] = float(ps);
+#if defined(SX8_H16)
+    buf_b_dh[(ks * BN + buf_ib) * 2 + loadr] = in_bounds ? float(blk.d) : 0.0f;
+#endif
 #endif
 }
 
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp b/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp
index 40c1f55e0a..3f87a0c3c3 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp
@@ -27,6 +27,9 @@ layout(constant_id = 1) const uint SCALE_F16 = 0;
 layout(constant_id = 2) const uint RESIDUAL = 0;
 // arifi lane-296 R4: residual prescale 2^RES_SHIFT (keeps the second digit's f16 scale out of the subnormal range).
 layout(constant_id = 3) const uint RES_SHIFT = 0;
+// lane sx8-int8 attempt E: 1 = one scale per 16-value half block, ds = (d0, d1). Only the S-X8 H16 cm1 kernel reads it
+// (it sums the int8 activations exactly, so the block sum ds.y is not needed). Not combined with RESIDUAL.
+layout(constant_id = 4) const uint HALF = 0;
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
 layout (binding = 0) readonly buffer A {vec4 data_a[];};
@@ -71,21 +74,34 @@ void quantize(const uint wgid) {
 #ifndef USE_SUBGROUPS
     shmem[tid] = thread_max;
     barrier();
-    [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
-        if (iqs < s) {
+    [[unroll]] for (uint s = HALF != 0 ? 2 : 4; s > 0; s >>= 1) {
+        if ((HALF != 0 ? (iqs & 3) : iqs) < s) {
             shmem[tid] = max(shmem[tid], shmem[tid + s]);
         }
         barrier();
     }
 
-    const float amax = shmem[block_in_wg * 8];
+    const float amax0 = shmem[block_in_wg * 8];
+    const float amax1 = shmem[block_in_wg * 8 + 4];
+    const float amax = HALF != 0 ? ((iqs & 4) != 0 ? amax1 : amax0) : amax0;
 #else
-    const float amax = subgroupClusteredMax(thread_max, 8);
+    float amax;
+    float amax0 = 0.0;
