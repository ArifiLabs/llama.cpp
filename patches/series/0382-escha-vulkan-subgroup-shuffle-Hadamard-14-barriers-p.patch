From db5f61b865266674cfe3f2bf7e88a1575e04ff7f Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Fri, 21 Aug 2026 02:54:23 -0400
Subject: [PATCH] escha vulkan: subgroup-shuffle Hadamard - 14 barriers per
 input block become 3

The butterfly ran 2 barriers per step x 7 steps for every 128-input block. At
n_in=17408 that is ~1900 workgroup barriers per column block, and each one stalls
all 128 threads on the slowest.

A partner at distance `step` is in the same subgroup whenever step < subgroup
size, so those steps need neither shared memory nor a barrier: read own slot,
subgroupShuffleXor the partner, write own slot. Only crossing steps still use
shared memory. On this device (warp 64, measured by lane-165) that is 6 of 7
steps shuffled -> 3 barriers; at subgroup 32 it is 5 shuffled -> 5 barriers.

tid = subgroupId*gl_SubgroupSize + gl_SubgroupInvocationID is what makes the
shuffle land on tid^step. That is a DEVICE FACT for a 1-D 128-thread workgroup,
the same one lane-163/165 shipped and validated here - not a spec guarantee.
ESCHA_SG_HADAMARD=0 restores the all-shared butterfly.

UNMEASURED at commit: owed with the same gate as 1ee8e9ad7 - test-backend-ops
ESCHA_MM 10/10, probe_sweep worst >= +0.9358, then a before/after on the shipped
build. Two unmeasured kernel changes are now stacked; measure them SEPARATELY
(ESCHA_HW_RTE and ESCHA_SG_HADAMARD toggle independently) so neither hides the
other's regression.

Origin: ArifiLabs (native)
Measured-effect: UNMEASURED at commit time - barrier count per 128-input block drops 14 to 3 at subgroup 64 by inspection; correctness gate and speed delta owed
---
 .../ggml-vulkan/vulkan-shaders/escha_mm.comp  | 38 ++++++++++++++++++-
 1 file changed, 37 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
index d357e307a..7202908f3 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/escha_mm.comp
@@ -1,6 +1,8 @@
 #version 450
 
 #extension GL_EXT_control_flow_attributes : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
 
 // ArifiLabs Escha-W2 fused linear mat-vec (lane-164).
 //
@@ -122,9 +124,40 @@ uint shr64_32(uint lo, uint hi, uint s) {
     return hi >> (s - 32u);
 }
 
-// one butterfly over all NC staged columns; 2 barriers per step regardless of NC
+// One butterfly over all NC staged columns.
+//
+// PERF (HQ seat-38, 2026-08-21): the all-shared version below cost 2 barriers per step x 7 steps
+// = 14 barriers per 128-input block. At n_in=17408 that is 136 blocks x 14 = ~1900 workgroup
+// barriers per column block, and a barrier stalls all 128 threads on the slowest one.
+//
+// A butterfly partner at distance `step` lives in the SAME subgroup whenever step < subgroup size,
+// so those steps need no shared memory and no barrier at all: each thread reads its own slot,
+// shuffles the partner's value across the subgroup, and writes only its own slot back. Only the
+// steps that cross a subgroup boundary still go through shared memory. On this device (warp 64,
+// measured by lane-165) that is 6 of 7 steps shuffled and one crossing step, so 14 barriers
+// become 3. At subgroup 32 it is 5 shuffled and two crossing, so 5.
+//
+// The mapping tid = subgroupId*gl_SubgroupSize + gl_SubgroupInvocationID is what makes
+// subgroupShuffleXor(a, step) the partner at tid^step. That is a DEVICE FACT for a 1-D 128-thread
+// workgroup, not a spec guarantee -- the same assumption lane-163/165 shipped and validated here.
+// ESCHA_SG_HADAMARD=0 restores the all-shared butterfly if a device ever disagrees.
+#ifndef ESCHA_SG_HADAMARD
+#define ESCHA_SG_HADAMARD 1
+#endif
+
 void hadamard128(uint tid) {
     [[unroll]] for (uint step = 1u; step < 128u; step <<= 1u) {
+#if ESCHA_SG_HADAMARD
+        if (step < gl_SubgroupSize) {          // uniform branch: partner is in my subgroup
+            [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
+                const float a = sh[cj][tid];
+                const float o = subgroupShuffleXor(a, step);
+                sh[cj][tid] = ((tid & step) == 0u) ? (a + o) : (o - a);
+            }
+            continue;                          // no barrier: each thread touched only its own slot
+        }
+        barrier();                             // publish the shuffle phase before a crossing step
+#endif
         float a[NC], o[NC];
         [[unroll]] for (uint cj = 0u; cj < NC; ++cj) {
             a[cj] = sh[cj][tid];
@@ -136,6 +169,9 @@ void hadamard128(uint tid) {
         }
         barrier();
     }
+#if ESCHA_SG_HADAMARD
+    barrier();                                 // the tile loop reads every lane's slot
+#endif
 }
 
 void main() {
