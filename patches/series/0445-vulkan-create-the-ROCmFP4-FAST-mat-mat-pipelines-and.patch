From 46fab4859bec2bd1f4145c45bda3ab98a012b568 Mon Sep 17 00:00:00 2001
From: Angelo Arifi <arifilabs@users.noreply.github.com>
Date: Wed, 2 Sep 2026 19:37:51 -0400
Subject: [PATCH] vulkan: create the ROCmFP4-FAST mat-mat pipelines and
 dequantize once per row in the generic mat-vec

The shaders matmul_rocmfp4_fast_* were generated and ggml_vk_get_mul_mat_mat_pipeline listed the type, but no CREATE_MM line ever created the pipelines, so every n>1 MUL_MAT on the type fell to whole-tensor dequant-to-f16 staging (prefill 3x slower than q4_K on the 780M; a 2.4 GB staging buffer on the 248320x5120 head). The mat-mat A loader in mul_mm_funcs.glsl also had no DATA_A_ROCMFP4_FAST case (test-backend-ops ERR 1.0 at n>8 on the first build); ported from rocmfpx/main mul_mm_funcs.glsl:602-607 onto the store_a() API. mul_mat_vec.comp iter() nested the column loop outside the row loop with dequantize4() inside, so each A block was decoded NUM_COLS times; the dequant is hoisted out of the column loop, arithmetic per (j,n) unchanged. Measured on gfx1103 (perf logger): FP4 prefill graph 16112 -> 4683 ms (q4_K parity at 5183 GFLOPS), FP4 width-3 verify 338 -> 271 ms, seat (Huihui UD-Q4_K_XL) verify 268 -> 259 ms (iq4_xs rows). test-backend-ops MUL_MAT 0 FAIL; F-141 0/8 x3; A/B: FP4 prefill +16-20% vs the seat, CI excludes zero. Report board/programs/local-inference/lanes/2026-09-02-lane-204-kernel-gap-census-REPORT.md

Lane: lane-204
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp          |  4 +
 .../vulkan-shaders/mul_mat_vec.comp           | 79 ++++++++++++-------
 .../vulkan-shaders/mul_mm_funcs.glsl          | 15 ++++
 3 files changed, 68 insertions(+), 30 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 121f18593..a4f2d92fb 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -4860,6 +4860,7 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         CREATE_MM2(pipeline_dequant_mul_mat_mat_f16[GGML_TYPE_IQ3_S],   matmul_iq3_s_f16,   mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3)
         CREATE_MM2(pipeline_dequant_mul_mat_mat_f16[GGML_TYPE_IQ4_XS],  matmul_iq4_xs_f16,  mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3)
         CREATE_MM2(pipeline_dequant_mul_mat_mat_f16[GGML_TYPE_IQ4_NL],  matmul_iq4_nl_f16,  mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3)
+        CREATE_MM2(pipeline_dequant_mul_mat_mat_f16[GGML_TYPE_Q4_0_ROCMFP4_FAST], matmul_rocmfp4_fast_f16, mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3)  // arifi lane-204: ROCmFP4-FAST mat-mat (shaders generated, pipelines never created)
 #if defined(GGML_VULKAN_FLOAT_E2M1_GLSLC_SUPPORT) && defined(GGML_VULKAN_FLOAT_E4M3_GLSLC_SUPPORT)
         if (device->ocp_fp4) {
             CREATE_MM2(pipeline_dequant_mul_mat_mat_f16[GGML_TYPE_MXFP4],   matmul_mxfp4_f16_ocp,   mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3)
@@ -4976,6 +4977,7 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         CREATE_MM2(GGML_TYPE_IQ3_S,   pipeline_dequant_mul_mat_mat[GGML_TYPE_IQ3_S],   matmul_iq3_s_f32,   mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
         CREATE_MM2(GGML_TYPE_IQ4_XS,  pipeline_dequant_mul_mat_mat[GGML_TYPE_IQ4_XS],  matmul_iq4_xs_f32,  mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
         CREATE_MM2(GGML_TYPE_IQ4_NL,  pipeline_dequant_mul_mat_mat[GGML_TYPE_IQ4_NL],  matmul_iq4_nl_f32,  mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
+        CREATE_MM2(GGML_TYPE_Q4_0_ROCMFP4_FAST, pipeline_dequant_mul_mat_mat[GGML_TYPE_Q4_0_ROCMFP4_FAST], matmul_rocmfp4_fast_f32, mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );  // arifi lane-204: rocmfpx/main :4280 equivalent (coopmat1 = the live block on the 780M)
 
 #if defined(GGML_VULKAN_FLOAT_E2M1_GLSLC_SUPPORT) && defined(GGML_VULKAN_FLOAT_E4M3_GLSLC_SUPPORT)
         if (device->ocp_fp4) {
@@ -5121,6 +5123,7 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         CREATE_MM2(GGML_TYPE_IQ4_NL,  pipeline_dequant_mul_mat_mat[GGML_TYPE_IQ4_NL],  matmul_iq4_nl_f32,  mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, , 0);
         CREATE_MM2(GGML_TYPE_MXFP4,   pipeline_dequant_mul_mat_mat[GGML_TYPE_MXFP4],   matmul_mxfp4_f32,   mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, , 0);
         CREATE_MM2(GGML_TYPE_NVFP4,   pipeline_dequant_mul_mat_mat[GGML_TYPE_NVFP4],   matmul_nvfp4_f32,   mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, , 0);
+        CREATE_MM2(GGML_TYPE_Q4_0_ROCMFP4_FAST, pipeline_dequant_mul_mat_mat[GGML_TYPE_Q4_0_ROCMFP4_FAST], matmul_rocmfp4_fast_f32, mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, , 0);  // arifi lane-204: rocmfpx/main :4438 equivalent
 
 #if defined(GGML_VULKAN_INTEGER_DOT_GLSLC_SUPPORT)
         if (device->integer_dot_product) {
@@ -5314,6 +5317,7 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         CREATE_MM(GGML_TYPE_IQ4_NL,  pipeline_dequant_mul_mat_mat[GGML_TYPE_IQ4_NL].f32acc,  matmul_iq4_nl_f32,  , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, , 0);
         CREATE_MM(GGML_TYPE_MXFP4,   pipeline_dequant_mul_mat_mat[GGML_TYPE_MXFP4].f32acc,   matmul_mxfp4_f32,   , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, , 0);
         CREATE_MM(GGML_TYPE_NVFP4,   pipeline_dequant_mul_mat_mat[GGML_TYPE_NVFP4].f32acc,   matmul_nvfp4_f32,   , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, , 0);
+        CREATE_MM(GGML_TYPE_Q4_0_ROCMFP4_FAST, pipeline_dequant_mul_mat_mat[GGML_TYPE_Q4_0_ROCMFP4_FAST].f32acc, matmul_rocmfp4_fast_f32, , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, , 0);  // arifi lane-204: rocmfpx/main :4630 equivalent
 
 #if defined(GGML_VULKAN_INTEGER_DOT_GLSLC_SUPPORT)
         if (device->integer_dot_product) {
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp
index 5a9d0e778..25c1713ff 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp
@@ -44,54 +44,73 @@ vec4 load_b(const uint j, const uint iybs, const uint iqs, const bool lastiter,
 
 void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i, bool lastiter)
 {
-    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
-        const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
-        const uint iqs = (col%QUANT_K)/QUANT_R; // quant index
-        const uint iybs = col - col%QUANT_K; // y block start index
-
 #if K_PER_ITER == 8
+    // arifi lane-204: dequantize each A block ONCE per row and reuse it across the NUM_COLS
+    // columns. The stock loop nested j (column) outside n (row) with dequantize4() inside, so at
+    // NUM_COLS=3 every weight block was decoded three times (rocmfp4_fast 17408x5120 on the 780M:
+    // 612 us at n=1 -> 1017 us at n=3, 77 -> 47 GB/s). B is the activation (L2-resident); A is the
+    // DRAM stream. Arithmetic per (j, n) is unchanged, so results are bit-identical.
+    const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
+    const uint iqs = (col%QUANT_K)/QUANT_R; // quant index
+    const uint iybs = col - col%QUANT_K; // y block start index
+
+    vec4 bv0[NUM_COLS];
+    vec4 bv1[NUM_COLS];
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
 #if QUANT_R == 2
         // Note that we end up fetching bogus elements here, but its fine as they'll be
         // within an accessible block.
         const vec4 bv02 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
         const vec4 bv13 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs + y_offset) / 4]);
-        const vec4 bv0 = vec4(bv02.x, bv13.x, bv02.y, bv13.y);
-        const vec4 bv1 = vec4(bv02.z, bv13.z, bv02.w, bv13.w);
+        bv0[j] = vec4(bv02.x, bv13.x, bv02.y, bv13.y);
+        bv1[j] = vec4(bv02.z, bv13.z, bv02.w, bv13.w);
 #else
-        const vec4 bv0 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
-        const vec4 bv1 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4 + 1]);
+        bv0[j] = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
+        bv1[j] = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4 + 1]);
 #endif
-#else
-        bool OOB_y;
-        bool OOB_z;
-        bool OOB_w;
+    }
 
-        const vec4 b = load_b(j, iybs, iqs, lastiter, OOB_y, OOB_z, OOB_w);
-#endif
-        uint ibi = first_row*p.ncols;
-        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
-            const uint ib = (ibi + col)/QUANT_K; // block index
-            ibi += p.ncols;
+    uint ibi = first_row*p.ncols;
+    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
+        const uint ib = (ibi + col)/QUANT_K; // block index
+        ibi += p.ncols;
 
-#if K_PER_ITER == 8
-            vec4 v = dequantize4(ib, iqs, a_offset);
-            vec4 v2 = dequantize4(ib, iqs+(4/QUANT_R), a_offset);
+        vec4 v = dequantize4(ib, iqs, a_offset);
+        vec4 v2 = dequantize4(ib, iqs+(4/QUANT_R), a_offset);
 
-            const vec2 dm = get_dm(ib, a_offset);
-            if (dm.y != 0) { // quant has min component
-                v = v * dm.x + dm.y;
-                v2 = v2 * dm.x + dm.y;
-            }
+        const vec2 dm = get_dm(ib, a_offset);
+        if (dm.y != 0) { // quant has min component
+            v = v * dm.x + dm.y;
+            v2 = v2 * dm.x + dm.y;
+        }
 
+        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
             // matrix multiplication
-            FLOAT_TYPE rowtmp = dot(bv0, v);
-            rowtmp += dot(bv1, v2);
+            FLOAT_TYPE rowtmp = dot(bv0[j], v);
+            rowtmp += dot(bv1[j], v2);
 
             if (dm.y == 0)
                 rowtmp *= dm.x;
 
             temp[j][n] += rowtmp;
+        }
+    }
 #else
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
+        const uint iqs = (col%QUANT_K)/QUANT_R; // quant index
+        const uint iybs = col - col%QUANT_K; // y block start index
+
+        bool OOB_y;
+        bool OOB_z;
+        bool OOB_w;
+
+        const vec4 b = load_b(j, iybs, iqs, lastiter, OOB_y, OOB_z, OOB_w);
+        uint ibi = first_row*p.ncols;
+        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
+            const uint ib = (ibi + col)/QUANT_K; // block index
+            ibi += p.ncols;
+
             if (!OOB_w) {
                 const vec4 v = dequantize4(ib, iqs, a_offset);
                 temp[j][n] += dot(v, b);
@@ -109,9 +128,9 @@ void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const
                 const FLOAT_TYPE v = dequantize1(ib, iqs, a_offset);
                 temp[j][n] = fma(v, b.x, temp[j][n]);
             }
-#endif
         }
     }
+#endif
 }
 
 #if defined(DATA_A_F32) || defined(DATA_A_F16) || defined(DATA_A_BF16)
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mm_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mm_funcs.glsl
index a48ee0f58..771e23f75 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mm_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mm_funcs.glsl
@@ -573,6 +573,21 @@ void load_a_to_shmem(const uint pos_a, const uint row, const uint col, const uin
             store_a(col, row + 8, FLOAT_TYPEV2(kvalues_mxfp4[vui  >>  4] * d,
                                               kvalues_mxfp4[vui2 >>  4] * d));
 #endif
+#elif defined(DATA_A_ROCMFP4_FAST)
+            // arifi lane-204: ROCmFP4-FAST mat-mat A loader (rocmfpx/main mul_mm_funcs.glsl:602-607 on the store_a() API;
+            // block = qs[16] + one ue4m3 scale, same 8-position layout as mxfp4 above)
+            const uint idx = pos_a + col * p.stride_a / LOAD_VEC_A + row;
+
+            const uint ib = idx / 8;
+            const uint iqs = (idx & 0x07) * 2;
+
+            const uint vui = uint(data_a[ib].qs[iqs]);
+            const uint vui2 = uint(data_a[ib].qs[iqs+1]);
+            const float d = ue4m3_to_fp32(data_a[ib].e);
+            store_a(col, row,     FLOAT_TYPEV2(float(kvalues_rocmfp4[vui  & 0xF]) * d,
+                                              float(kvalues_rocmfp4[vui2 & 0xF]) * d));
+            store_a(col, row + 8, FLOAT_TYPEV2(float(kvalues_rocmfp4[vui  >>  4]) * d,
+                                              float(kvalues_rocmfp4[vui2 >>  4]) * d));
 #elif defined(DATA_A_NVFP4)
             const uint idx = pos_a + col * p.stride_a / LOAD_VEC_A + row;
             const uint ib = idx / 16u;
